<tr><td>AI-04</td><td>Document hors tender ou autre tenant.</td><td>Refus strict.</td><td>P0</td></tr>
<tr><td>AI-05</td><td>Date IA invalide.</td><td>Erreur schema contrôlée, job en échec lisible.</td><td>P1</td></tr>
<tr><td>AI-06</td><td>Afficher clauses paginées.</td><td>Pagination stable, version d'analyse cohérente.</td><td>P1</td></tr>
<tr><td>AI-07</td><td>Fallback provider.</td><td>Fallback selon politique ou erreur contrôlée.</td><td>P1</td></tr>
</table>

