/// Sprint 8C Phase 2 — mission §12 : PLUSIEURS déclarations de sous-traitance (DC4) possibles par
/// Tender — jamais une seule.
model SubcontractorDeclaration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
