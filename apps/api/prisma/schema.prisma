  percentageOfTotal Float?  @map("percentage_of_total")

  /// V2 Sprint 11 — rubrique G du DC4 réel : taux de TVA distinct du montant (le formulaire
  /// affiche montant HT, taux, ET montant TTC séparément) — jamais dérivé/deviné, `null` tant que
  /// non renseigné.
  vatRate Float? @map("vat_rate")

  paymentTerms             String?  @map("payment_terms")
  directPaymentApplicable  Boolean? @map("direct_payment_applicable")
  /// V2 Sprint 11 — rubrique H du DC4 réel : "le sous-traitant demande-t-il une avance ?".
  advanceRequested         Boolean? @map("advance_requested")
  /// V2 Sprint 11 — rubrique I du DC4 réel : durée du contrat de sous-traitance en nombre de mois.
  durationMonths           Int?     @map("duration_months")
  requiredDocuments        Json     @default("[]") @map("required_documents")
  administrativeDocumentId String?  @map("administrative_document_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("administrative_subcontractor_declarations")
}

