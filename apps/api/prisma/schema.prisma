// ============================================================================
// Sprint 9 — Dépôt manuel assisté et suivi de soumission.
//
// TenderSubmission référence un SubmissionPackage EXACT (packageId + packageVersion + packageHash
// dénormalisés, jamais recalculés) — mission §18 "jamais une référence implicite à latestPackage".
// L'index unique partiel "une soumission en vol par Tender" (mission §31/§32) est hand-appended
// dans la migration, jamais déclaré ici (même motif que official_administrative_templates_*_key,
// Sprint 8C.1 — Prisma ne modélise pas nativement les index partiels dans le schéma déclaratif).
// ============================================================================

/// Mission §6 — un dépôt manuel d'un Tender sur une plateforme acheteur, prouvable (qui/quoi/où/
/// quand/quelle version/quelle preuve). Immuable dans sa référence de package une fois créée ; seuls
/// le statut et les métadonnées de suivi évoluent via des transitions contrôlées (mission §7).
model TenderSubmission {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Dénormalisés en LECTURE SEULE depuis `submission-package` (module distinct) — jamais de FK
  /// stricte inter-module, jamais recalculés après coup (mission §18).
  packageId      String  @map("package_id") @db.Uuid
  packageVersion Int     @map("package_version")
  packageHash    String  @map("package_hash") @db.VarChar(64)
  manifestHash   String? @map("manifest_hash") @db.VarChar(64)

  /// SUBMISSION_IN_PROGRESS | SUBMITTED | RECEIPT_CONFIRMED | SUBMISSION_REJECTED | WITHDRAWN |
  /// REPLACED | CANCELLED — CHECK (migration). NOT_SUBMITTED/READY_FOR_SUBMISSION ne sont jamais
  /// persistés (calculés avant qu'aucune ligne n'existe, mission §7).
  status String @db.VarChar(24)

  submittedByUserId String?   @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime? @map("submitted_at")

  /// PLACE | AWS_ACHAT | MARCHES_SECURISES | MAXIMILIEN | ACHATPUBLIC | MEGALIS |
  /// E_MARCHES_PUBLICS | PLATEFORME_ACHETEUR | OTHER — CHECK (migration).
  platform           String  @db.VarChar(30)
  customPlatformName String? @map("custom_platform_name") @db.VarChar(200)

  platformReference String? @map("platform_reference") @db.VarChar(300)
  receiptReference  String? @map("receipt_reference") @db.VarChar(300)
  notes             String?

  /// Chaîne de remplacement — dénormalisée, pas de relation Prisma (auto-référence optionnelle
  /// double sens, résolue côté application via le repository, même motif que les autres références
  /// dénormalisées de ce fichier).
  supersedesSubmissionId String? @map("supersedes_submission_id") @db.Uuid
  replacedBySubmissionId String? @map("replaced_by_submission_id") @db.Uuid

  withdrawnAt       DateTime? @map("withdrawn_at")
  withdrawnByUserId String?   @map("withdrawn_by_user_id") @db.Uuid
  withdrawalReason  String?   @map("withdrawal_reason")

  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id") @db.Uuid
  cancellationReason String?   @map("cancellation_reason")

  /// FILE_REJECTED | SIZE_EXCEEDED | INVALID_FORMAT | ANTIVIRUS | SIGNATURE_REJECTED |
  /// SESSION_EXPIRED | OTHER — CHECK (migration).
  rejectionCategory    String? @map("rejection_category") @db.VarChar(30)
  rejectionDescription String? @map("rejection_description")

  receiptConfirmedAt       DateTime? @map("receipt_confirmed_at")
  receiptConfirmedByUserId String?   @map("receipt_confirmed_by_user_id") @db.Uuid

  externalSubmissionUrl String? @map("external_submission_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proofs SubmissionProof[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@index([organizationId, status])
  @@index([submittedAt])
  @@index([packageId])
  @@index([supersedesSubmissionId])
  @@index([replacedBySubmissionId])
  @@map("tender_submissions")
}

/// Mission §12 — une preuve de dépôt (reçu/accusé/capture...), liée à un `Document` déjà vérifié.
/// Plusieurs preuves possibles par soumission — jamais une preuve remplacée en place.
model SubmissionProof {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  submissionId String           @map("submission_id") @db.Uuid
  submission   TenderSubmission @relation(fields: [submissionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Dénormalisés en LECTURE SEULE vers un Document déjà vérifié — jamais de FK stricte inter-module.
  documentId        String @map("document_id") @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid

  /// RECEIPT | ACKNOWLEDGEMENT | SCREENSHOT | PLATFORM_CONFIRMATION | OTHER — CHECK (migration).
  proofType String @map("proof_type") @db.VarChar(30)
  hash      String @db.VarChar(64)

  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@unique([id, organizationId])
  @@index([organizationId, submissionId])
  @@map("submission_proofs")
}

// V2 Sprint 1 — Socle métier et fondations transverses (skills/platform-foundation/DATABASE_PATTERNS.md
// §36-41 Outbox, §66 données IA ; TenderOS-V2.0-Blueprint-Technique-Final.md §1/§4). Table append-only :
// seules status/attemptCount/availableAt/publishedAt/lastError sont mutables après insertion — jamais le
// contenu métier (payload/eventType/aggregateType/aggregateId).
model OutboxEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  eventType    String @map("event_type") @db.VarChar(100)
  eventVersion Int    @default(1) @map("event_version")

  aggregateType String @map("aggregate_type") @db.VarChar(60)
  aggregateId   String @map("aggregate_id") @db.Uuid

  payload Json

  occurredAt    DateTime @map("occurred_at")
  correlationId String?  @map("correlation_id") @db.VarChar(100)

  /// PENDING | PROCESSING | PUBLISHED | FAILED | DEAD_LETTER — CHECK (migration).
  status       String    @default("PENDING") @db.VarChar(16)
  attemptCount Int       @default(0) @map("attempt_count")
  availableAt  DateTime  @default(now()) @map("available_at")
  publishedAt  DateTime? @map("published_at")
  lastError    String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")

  processedEvents ProcessedEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, status, availableAt])
  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Ledger d'idempotence de CONSOMMATION (distinct de tout mécanisme d'idempotence API-level) : un couple
/// (outboxEventId, consumerName) ne peut être traité qu'une seule fois, même si plusieurs workers/consumers
/// futurs lisent le même événement — garantit "aucun double traitement produisant un effet métier dupliqué".
model ProcessedEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  outboxEventId String      @map("outbox_event_id") @db.Uuid
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  consumerName String  @map("consumer_name") @db.VarChar(100)
  result       String? @db.VarChar(20)

  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([outboxEventId, consumerName])
  @@unique([id, organizationId])
  @@index([organizationId, consumerName])
  @@map("processed_events")
}

/// Copie dédiée d'un OutboxEvent ayant épuisé ses tentatives — surface de requête/alerte opérationnelle
/// séparée, sans avoir à scanner outbox_events entier. La ligne OutboxEvent d'origine reste inchangée
/// (append-only), seul son status bascule à DEAD_LETTER en parallèle de cette insertion.
model DeadLetterEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  outboxEventId String @map("outbox_event_id") @db.Uuid

  eventType     String @map("event_type") @db.VarChar(100)
  aggregateType String @map("aggregate_type") @db.VarChar(60)
  aggregateId   String @map("aggregate_id") @db.Uuid
  payload       Json

  failureReason String @map("failure_reason")
  attemptCount  Int    @map("attempt_count")

  movedAt DateTime @default(now()) @map("moved_at")

  @@unique([id, organizationId])
  @@unique([outboxEventId])
  @@index([organizationId, movedAt])
  @@map("dead_letter_events")
}

/// V2 Sprint 1 — socle générique de suggestion IA (skills/platform-foundation/AI_PATTERNS.md §18-19/§27/§37 ;
/// mission Sprint 1 §3). Zone tampon uniquement : aucun module aval ne doit lire cette table comme source de
/// vérité — seule l'entité métier cible, une fois la suggestion validée, fait foi. `entityType` est un
/// catalogue fermé (CHECK, migration), étendu explicitement sprint par sprint (jamais de texte libre).
model AiSuggestion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// TENDER_LOT | CHECKLIST_ITEM | SUBCONTRACTOR_PROFILE | DC1 | DC2 | DC4 | ATTRI1 |
  /// TECHNICAL_MEMO_SECTION | PRICING_LINE | COMPANY_LEGAL_IDENTITY | TENDER_FIELD |
  /// TENDER_LOT_FIELD | TENDER_AWARD_CRITERION | TENDER_REQUESTED_DOCUMENT | TENDER_MILESTONE |
  /// TENDER_RISK | BUYER_FIELD — CHECK (migration), catalogue étendu V2 Sprint 4.
  entityType String  @map("entity_type") @db.VarChar(40)
  /// V2 Sprint 4 — nullable : une suggestion de CREATION (ex. proposer un nouveau lot) n'a pas
  /// encore de cible existante au moment de sa création.
  entityId   String? @map("entity_id") @db.Uuid
  fieldName  String  @map("field_name") @db.VarChar(100)

  /// V2 Sprint 4 (audit Codex) — contexte de cible explicite, jamais encodé uniquement dans
  /// proposedValue : racine Tender toujours connue et vérifiée, lot cible optionnel. Distinct
  /// de entityId/entityType (qui restent la cible EFFECTIVE, potentiellement absente si création).
  parentTenderId String     @map("parent_tender_id") @db.Uuid
  parentTender   Tender     @relation(fields: [parentTenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  /// Absent = suggestion au niveau Tender global ; renseigné = suggestion spécifique à ce lot.
  /// Correctif audit Codex P1-003 — FK à 3 colonnes (jamais seulement organizationId) : garantit
  /// structurellement que ce lot appartient bien à parentTenderId, jamais à un autre Tender du
  /// même tenant (voir TenderLot.@@unique([id, organizationId, tenderId])).
  parentLotId    String?    @map("parent_lot_id") @db.Uuid
  parentLot      TenderLot? @relation(fields: [parentLotId, organizationId, parentTenderId], references: [id, organizationId, tenderId], onDelete: Cascade, map: "ai_suggestions_parent_lot_id_org_tender_fkey")

  /// Validé par un schéma Zod spécifique à (entityType, fieldName) avant toute persistance — jamais un
  /// JSON libre non validé (mission Sprint 1 §3, AI_PATTERNS.md §41 "Sortie IA non validée par schéma...").
  proposedValue Json  @map("proposed_value")
  /// Score continu 0..1, cohérent avec le ProvenanceSchema déjà en production (module analysis) — jamais
  /// un enum LOW/MEDIUM/HIGH, pour éviter un second système de représentation de la confiance IA.
  confidence    Float

  /// Provenance — références dénormalisées en LECTURE SEULE, jamais de FK stricte inter-module.
  sourceDocumentId        String? @map("source_document_id") @db.Uuid
  sourceDocumentVersionId String? @map("source_document_version_id") @db.Uuid
  sourcePage              Int?    @map("source_page")
  sourceChunkReference    String? @map("source_chunk_reference") @db.VarChar(200)
  sourceAnalysisAttemptId String? @map("source_analysis_attempt_id") @db.Uuid

  /// Modèle/tentative d'analyse IA à l'origine — colonnes plates, même précédent que AnalysisJob.provider/model.
  aiProvider String? @map("ai_provider") @db.VarChar(30)
  aiModel    String? @map("ai_model") @db.VarChar(60)

  /// PENDING | APPLYING | ACCEPTED | MODIFIED | REJECTED — CHECK (migration). APPLYING (V2 Sprint 4,
  /// audit Codex P1-001) réserve la suggestion pendant l'écriture métier par le bridge, jamais un
  /// statut terminal : redevient PENDING si l'écriture échoue, sinon transite vers ACCEPTED/MODIFIED.
  /// Mutation interdite une fois hors PENDING/APPLYING (mission Sprint 1 §3 "empêcher toute
  /// modification silencieuse d'une suggestion déjà traitée").
  status String @default("PENDING") @db.VarChar(16)

  /// Processus/use-case créateur (ex. "analysis.suggest-checklist") — jamais un humain, une AiSuggestion
  /// est par construction d'origine IA.
  createdByProcess String @map("created_by_process") @db.VarChar(100)

  validatedByUserId String?   @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime? @map("validated_at")
  rejectedAt        DateTime? @map("rejected_at")
  decisionReason    String?   @map("decision_reason")

  /// V2 Sprint 4 — décision explicite lorsque la cible portait déjà une valeur au moment de
  /// l'application (KEEP_CURRENT | REPLACE | MERGE | REJECT — CHECK, migration). NULL tant
  /// qu'aucun conflit n'a été détecté (cible vide au moment de l'application).
  conflictResolution String? @map("conflict_resolution") @db.VarChar(20)

  /// Valeur réellement retenue (== proposedValue si ACCEPTED, différente si MODIFIED, absente si REJECTED).
  appliedValue Json? @map("applied_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status])
  @@index([organizationId, parentTenderId])
  @@map("ai_suggestions")
}

/// V2 Sprint 4 (audit Codex P1-002, round 3) — destination d'archivage automatique, appliquée par
/// la migration elle-même, de toute ligne `ai_suggestions` préexistante sans `parent_tender_id`
/// résolvable (aucun backfill déterministe possible). Jamais un modèle applicatif actif : aucun
/// repository/use case de ce dépôt n'y écrit ni n'y lit — une trace d'audit pure, volontairement
/// hors du cycle de vie AiSuggestion normal, pour que la migration reste TOUJOURS déployable sans
/// jamais supprimer silencieusement une donnée.
model AiSuggestionOrphanedArchive {
  id          String   @id @db.Uuid
  archivedAt  DateTime @default(now()) @map("archived_at")
  reason      String
  rowSnapshot Json     @map("row_snapshot")

  @@map("ai_suggestions_orphaned_archive")
}

// ============================================================================
// V2 Sprint 5 — GO/NO-GO IA : préqualification d'Opportunity (Niveau 1), rapport
// GO/NO-GO complet post-analyse DCE (Niveau 2), décision humaine partagée entre
// les deux niveaux, promotion Opportunity -> Tender. Score calculé, recommandation
// IA et décision humaine restent trois notions strictement séparées — jamais
// fusionnées, jamais l'une n'écrase l'autre (principe directeur de la mission).
// ============================================================================

/// Opportunité détectée AVANT la création d'un Tender (mission §4) — racine tenantée du Niveau 1.
/// `clientAccountId`/`buyerId` nullables : une Opportunity peut exister sans candidat ni acheteur
/// structuré résolus (§23 "permettre quand même une décision humaine" malgré des données
/// manquantes) ; le Quick Score dégrade alors sa confiance plutôt que d'inventer une donnée.
model Opportunity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  buyerId String? @map("buyer_id") @db.Uuid
  buyer   Buyer?  @relation(fields: [buyerId, organizationId], references: [id, organizationId])

  title       String  @db.VarChar(500)
  description String?

  /// MANUAL | BOAMP | TED | PRIVATE — catalogue préparé pour de futurs connecteurs (mission §4),
  /// seul MANUAL est produit ce sprint (aucun connecteur réel).
  source            String  @default("MANUAL") @map("source") @db.VarChar(20)
  externalReference String? @map("external_reference") @db.VarChar(255)
  buyerName         String? @map("buyer_name") @db.VarChar(300)

  /// Texte libre — aucun rapprochement CPV structuré possible ce sprint (même limitation que
  /// `CompanyReference.sector`, mission §5 confirmée non implémentée).
  sector         String? @db.VarChar(120)
  cpvCode        String? @map("cpv_code") @db.VarChar(20)
  location       String? @db.VarChar(300)
  geographicZone String? @map("geographic_zone") @db.VarChar(300)

  publicationDate    DateTime? @map("publication_date")
  submissionDeadline DateTime? @map("submission_deadline")

  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @default("EUR") @db.Char(3)

  procedureType String? @map("procedure_type") @db.VarChar(80)

  /// DRAFT | TO_QUALIFY | QUALIFIED | GO | GO_CONDITIONAL | NO_GO | PROMOTED | DISMISSED | ARCHIVED
  /// — protégée par une contrainte CHECK (migration), transitions contrôlées côté domaine
  /// (`ALLOWED_OPPORTUNITY_TRANSITIONS`).
  status String @db.VarChar(20)

  /// Renseigné uniquement après une promotion réussie (`PromoteOpportunityToTenderUseCase`) —
  /// jamais l'inverse : un Tender créé manuellement n'a jamais besoin d'Opportunity.
  tenderId String? @map("tender_id") @db.Uuid
  tender   Tender? @relation(fields: [tenderId, organizationId], references: [id, organizationId])

  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  /// Concurrence optimiste (même motif que `Tender.version`).
  version Int @default(1)

  quickScores OpportunityQuickScore[]
  decisions   GoNoGoDecision[]

  @@unique([id, organizationId])
  /// Une Opportunity au plus par Tender (Postgres traite plusieurs NULL comme non-conflictuels —
  /// "unique une fois renseigné" sans index partiel).
  @@unique([tenderId, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, clientAccountId])
  @@index([organizationId, submissionDeadline])
  @@index([organizationId, createdAt])
  @@map("opportunities")
}

/// Score rapide de préqualification (Niveau 1, mission §6-9) — jamais écrasé : une nouvelle version
/// à chaque recalcul (même motif que `TenderAnalysisSummary`/`GoNoGoReport`). Déterministe et
/// explicable : `categoryScores` porte poids ET justification par catégorie, jamais une moyenne
/// opaque.
model OpportunityQuickScore {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  opportunityId String      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Séquentiel par Opportunity (mission §21 "conserver les anciens Quick Scores").
  scoreVersion Int @map("score_version")

  globalScore Float @map("global_score")
  /// 0..1 continu (même convention que `AiSuggestion.confidence`) — jamais un enum, réduit
  /// explicitement quand des données sont manquantes (mission §23).
  confidence  Float

  /// 1 (très faible) à 5 (très élevée) — protégée par une contrainte CHECK (migration).
  complexity Int

  /// Une entrée par catégorie (administratif/technique/financier/planning/ressources/références/
  /// certifications/conformité générale) : `{ score, weight, justification }`. Poids nommés et
  /// documentés dans `domain/scoring/category-weights.ts`, jamais un nombre codé en dur ici.
  categoryScores Json @map("category_scores")

  strengths   Json @default("[]")
  weaknesses  Json @default("[]")
  blockers    Json @default("[]")
  missingData Json @default("[]") @map("missing_data")

  /// Version de l'algorithme de calcul (distincte de `scoreVersion`, qui compte les recalculs).
  calculationVersion String @map("calculation_version") @db.VarChar(20)
  /// Instantané des données effectivement utilisées — jamais recalculé rétroactivement si le
  /// profil entreprise change ensuite (mission §21).
  dataSnapshot       Json   @map("data_snapshot")

  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  decisions GoNoGoDecision[]

  @@unique([id, organizationId])
  @@unique([organizationId, opportunityId, scoreVersion])
  @@index([organizationId, opportunityId, createdAt])
  @@map("opportunity_quick_scores")
}

/// Rapport GO/NO-GO complet (Niveau 2, mission §12-16) — exige une analyse DCE déjà terminée
/// (`analysisVersion` figé au moment du calcul, jamais re-résolu). Append-only : une nouvelle
/// version à chaque régénération (même motif que `TenderAnalysisSummary`).
model GoNoGoReport {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Séquentiel par Tender.
  reportVersion   Int @map("report_version")
  /// `TenderAnalysisSummary.analysisVersion` utilisée pour ce calcul — instantané, jamais
  /// re-résolue même si une nouvelle analyse DCE survient ensuite.
  analysisVersion Int @map("analysis_version")

  globalScore Float @map("global_score")
  confidence  Float
  /// 1..5 — CHECK (migration).
  complexity  Int

  /// LOW | MEDIUM | HIGH | VERY_HIGH — CHECK (migration). Libellés FR portés uniquement par le
  /// frontend (même convention que `AiSuggestionEntityType`).
  documentaryLoad String @map("documentary_load") @db.VarChar(20)

  /// `{ admin, technicalMemo, pricing, documents, validation }`, chacun `{ low, medium, high }` —
  /// jamais présenté comme une garantie (mission §10).
  estimatedPrepTime Json @map("estimated_prep_time")

  /// 7 catégories (administratif/technique/financier/planning/ressources/références/
  /// certifications — pas de "conformité générale" distincte à ce niveau, remplacée par les
  /// exigences réelles issues des Findings DCE). `{ score, weight, justification }` par catégorie,
  /// poids documentés dans `domain/scoring/category-weights.ts`.
  categoryScores Json @map("category_scores")

  /// Chaque entrée : `{ category, description, weight, source, justification }`.
  positiveCauses      Json @default("[]") @map("positive_causes")
  negativeCauses      Json @default("[]") @map("negative_causes")
  risks               Json @default("[]")
  /// Distinct des faiblesses (`negativeCauses`) — jamais un blocage automatique de la décision
  /// humaine (mission §16 "ne jamais bloquer automatiquement la décision humaine").
  blockers            Json @default("[]")
  missingInfo         Json @default("[]") @map("missing_info")
  /// Signal factuel uniquement (ex. clause SUBCONTRACTING/CONSORTIUM détectée) — jamais un
  /// rattachement automatique de sous-traitant (mission §24).
  subcontractingFlags Json @default("[]") @map("subcontracting_flags")

  /// GO | GO_CONDITIONAL | NO_GO — CHECK (migration). Recommandation IA, TOUJOURS distincte de
  /// `GoNoGoDecision.decision` (mission §17 "cette valeur reste une recommandation").
  recommendation          String @db.VarChar(20)
  recommendationRationale String @map("recommendation_rationale")

  calculationVersion String   @map("calculation_version") @db.VarChar(20)
  requestedByUserId  String?  @map("requested_by_user_id") @db.Uuid
  generatedAt        DateTime @default(now()) @map("generated_at")

  decisions GoNoGoDecision[]

  @@unique([id, organizationId])
  @@unique([organizationId, tenderId, reportVersion])
  @@index([organizationId, tenderId, generatedAt])
  @@map("go_no_go_reports")
}

/// Décision humaine (mission §18) — partagée entre les deux niveaux via `level`. Append-only :
/// jamais écrasée, une nouvelle décision est toujours une nouvelle ligne (`insertSeq` départage
/// un ordre non ambigu même en cas de collision d'horloge sur `decidedAt`).
model GoNoGoDecision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// OPPORTUNITY | TENDER — CHECK (migration), cohérent avec l'exclusivité opportunityId/tenderId
  /// ci-dessous (CHECK composite, migration).
  level String @db.VarChar(20)

  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId, organizationId], references: [id, organizationId], onDelete: Cascade)

  tenderId String? @map("tender_id") @db.Uuid
  tender   Tender? @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  linkedQuickScoreId String?                @map("linked_quick_score_id") @db.Uuid
  linkedQuickScore   OpportunityQuickScore? @relation(fields: [linkedQuickScoreId, organizationId], references: [id, organizationId])

  linkedReportId String?       @map("linked_report_id") @db.Uuid
  linkedReport   GoNoGoReport? @relation(fields: [linkedReportId, organizationId], references: [id, organizationId])

  /// GO | GO_CONDITIONAL | NO_GO — CHECK (migration).
  decision      String  @db.VarChar(20)
  /// Obligatoire si NO_GO — CHECK (migration).
  justification String?
  /// Obligatoire si GO_CONDITIONAL — CHECK (migration).
  conditions    String?
  comment       String?

  actorId   String   @map("actor_id") @db.Uuid
  decidedAt DateTime @default(now()) @map("decided_at")

  /// Pur départage d'ordre interne — jamais exposé à l'API/au domaine, garantit une lecture
  /// "dernière décision" non ambiguë (utilisé par `PromoteOpportunityToTenderUseCase`).
  insertSeq BigInt @default(autoincrement()) @map("insert_seq")

  @@index([organizationId, level, opportunityId, insertSeq])
  @@index([organizationId, level, tenderId, insertSeq])
  @@map("go_no_go_decisions")
}

// ============================================================================
// V2 Sprint 2 — Entreprise candidate (satellites additifs de ClientAccount) et
// répertoire organisationnel de sous-traitants. ClientAccount reste la racine
// technique inchangée ; "Entreprise candidate" est un vocabulaire fonctionnel/UI.
// ============================================================================

/// Identité légale — one-to-one avec ClientAccount. Aucune valeur inventée : tous les champs sont
/// nullables (mission §4.1 "autoriser les champs partiellement renseignés"), la complétude est
/// signalée par `GetCompanyProfileUseCase`, jamais bloquée à la création.
model CompanyLegalIdentity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  legalName            String?   @map("legal_name") @db.VarChar(240)
  tradeName            String?   @map("trade_name") @db.VarChar(240)
  siren                String?   @db.VarChar(9)
  siretPrincipal       String?   @map("siret_principal") @db.VarChar(14)
  vatNumber            String?   @map("vat_number") @db.VarChar(20)
  legalForm            String?   @map("legal_form") @db.VarChar(120)
  shareCapitalAmount   Decimal?  @map("share_capital_amount") @db.Decimal(14, 2)
  shareCapitalCurrency String?   @map("share_capital_currency") @db.VarChar(3)
  apeCode              String?   @map("ape_code") @db.VarChar(10)
  incorporatedAt       DateTime? @map("incorporated_at")
  rcsNumber            String?   @map("rcs_number") @db.VarChar(40)
  rcsCity              String?   @map("rcs_city") @db.VarChar(120)
  registrationCountry  String?   @map("registration_country") @db.VarChar(10)

  /// Coordonnées (mission §4.2) — aucun modèle Address/Contact générique réutilisable trouvé dans
  /// le code existant (audit préalable), regroupées ici plutôt que de créer un second système.
  addressLine       String? @map("address_line") @db.VarChar(300)
  addressComplement String? @map("address_complement") @db.VarChar(300)
  postalCode        String? @map("postal_code") @db.VarChar(20)
  city              String? @db.VarChar(120)
  region            String? @db.VarChar(120)
  country           String? @db.VarChar(10)
  phone             String? @db.VarChar(40)
  generalEmail      String? @map("general_email") @db.VarChar(320)
  website           String? @db.VarChar(2048)

  /// ACTIVE | ARCHIVED — CHECK (migration).
  status String @default("ACTIVE") @db.VarChar(20)

  lastValidatedAt       DateTime? @map("last_validated_at")
  lastValidatedByUserId String?   @map("last_validated_by_user_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@unique([clientAccountId, organizationId])
  @@index([organizationId, siretPrincipal])
  @@map("company_legal_identities")
}

/// Représentant/signataire/contact d'une entreprise candidate. Le pouvoir de signature réel et
/// opposable reste porté par `SigningPower` (module administrative-dossier, scopé Tender) — ce
/// modèle ne recrée jamais un second système de pouvoirs (mission §4.3), il décrit seulement le
/// périmètre général déclaré au niveau entreprise via `signatureScope`/`signatureLimitations`.
model CompanyRepresentative {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  firstName String @map("first_name") @db.VarChar(120)
  lastName  String @map("last_name") @db.VarChar(120)

  /// LEGAL_REPRESENTATIVE | SIGNATORY | ADMINISTRATIVE_CONTACT | COMMERCIAL_CONTACT |
  /// TECHNICAL_CONTACT — CHECK (migration).
  type     String  @db.VarChar(30)
  jobTitle String? @map("job_title") @db.VarChar(200)
  email    String? @db.VarChar(320)
  phone    String? @db.VarChar(40)

  /// Description libre du périmètre déclaré (type = SIGNATORY uniquement) — jamais un pouvoir
  /// juridique opposable, voir note ci-dessus.
  signatureScope       String? @map("signature_scope")
  signatureLimitations String? @map("signature_limitations")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  /// ACTIVE | ARCHIVED — CHECK (migration). Mission §4.3 : "aucun signataire ne doit être
  /// sélectionné automatiquement comme signataire final d'un Tender" — ce statut ne pilote donc
  /// aucune sélection automatique, purement informatif au niveau du profil.
  status String @default("ACTIVE") @db.VarChar(20)

  createdBy String   @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, clientAccountId])
  @@map("company_representatives")
}

/// Compte bancaire — jamais de suppression physique si utilisé dans un document/package existant
/// (mission §4.4) : uniquement `status = ARCHIVED`. IBAN/BIC jamais journalisés en clair, masqués
/// en liste par le présentateur (interfaces/http), accès protégé par une permission dédiée
/// (`ClientPermission.ReadCompanyBanking`/`ManageCompanyBanking`, distincte du profil général).
model CompanyBankAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  accountHolder String  @map("account_holder") @db.VarChar(240)
  bankName      String? @map("bank_name") @db.VarChar(200)
  iban          String  @db.VarChar(34)
  bic           String? @db.VarChar(11)
  country       String? @db.VarChar(10)
  currency      String? @db.VarChar(3)

  /// Référence dénormalisée en LECTURE SEULE vers un Document (RIB/justificatif) — jamais de FK
  /// stricte inter-module (même motif que SubmissionProof.documentId).
  documentId String? @map("document_id") @db.Uuid

  isPrimary Boolean @default(false) @map("is_primary")

  validatedAt       DateTime? @map("validated_at")
  validatedByUserId String?   @map("validated_by_user_id") @db.Uuid

  /// ACTIVE | ARCHIVED — CHECK (migration).
  status String @default("ACTIVE") @db.VarChar(20)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, clientAccountId])
  @@map("company_bank_accounts")
}

/// Assurance. `status` en base ne porte QUE ce que l'utilisateur décide (ACTIVE|ARCHIVED) — les
/// états dépendants du temps (valide/bientôt expirée/expirée, mission §4.5) sont calculés à la
/// lecture depuis `expiresAt` par `GetCompanyProfileUseCase`, jamais persistés : un champ calculable
/// stocké deviendrait faux dès le lendemain sans job de rafraîchissement (même discipline que le
/// score de complétude, volontairement déterministe et non stocké).
model CompanyInsurance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// PROFESSIONAL_LIABILITY | DECENNIAL | OPERATING_LIABILITY | SECTOR_SPECIFIC | OTHER — CHECK
  /// (migration). Catalogue volontairement large avec échappatoire OTHER + libellé libre (mission
  /// §4.5 "ne pas figer un catalogue trop restrictif").
  type           String  @db.VarChar(40)
  otherTypeLabel String? @map("other_type_label") @db.VarChar(200)

  insurer          String?   @db.VarChar(200)
  policyNumber     String?   @map("policy_number") @db.VarChar(100)
  startDate        DateTime? @map("start_date")
  expiresAt        DateTime? @map("expires_at")
  coverageScope    String?   @map("coverage_scope")
  coverageAmount   Decimal?  @map("coverage_amount") @db.Decimal(14, 2)
  coverageCurrency String?   @map("coverage_currency") @db.VarChar(3)

  documentId     String?   @map("document_id") @db.Uuid
  lastVerifiedAt DateTime? @map("last_verified_at")

