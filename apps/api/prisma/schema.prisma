/// V2 Sprint 9 (Chat IA conversationnel métier) — une conversation appartient TOUJOURS à
/// EXACTEMENT UN Tender, jamais réaffectable (mission §5 "ne jamais permettre de changer
/// silencieusement de Tender"). `clientAccountId` est dénormalisé depuis `Tender.clientAccountId`
/// AU MOMENT de la création (même motif d'immutabilité que `KnowledgeEntry.clientAccountId`,
/// Sprint 8) — jamais modifié ensuite, y compris si le Tender change de candidat. `lotId` reste un
/// simple filtre optionnel (scalaire, jamais une relation Prisma stricte — même motif que les
/// champs de provenance des Finding, `TenderRequirementFinding.documentId` etc.) : revérifié
/// applicativement (appartenance au même Tender) à chaque usage, jamais fait confiance en base.
model Conversation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// NULL uniquement si le Tender lui-même n'a pas encore de client (cas théorique — `Tender.clientAccountId`
  /// est obligatoire en pratique) ; jamais réaffecté après création (mission §9 "immuable").
  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  /// Filtre optionnel "Lot X" (mission §6) — scalaire, jamais une FK stricte : un Lot supprimé ne
  /// doit jamais faire échouer la suppression ou la lecture d'une conversation existante.
  lotId String? @map("lot_id") @db.Uuid

  createdByUserId String  @map("created_by_user_id") @db.Uuid
  title           String? @db.VarChar(300)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  messages Message[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId, archivedAt])
  @@index([organizationId, clientAccountId])
  @@map("conversations")
}

/// V2 Sprint 9 — un message USER ou ASSISTANT (jamais SYSTEM en persistance côté utilisateur, voir
/// `chat/domain/message-role.ts`) ; `status` gouverne le cycle de vie d'UNE génération assistant
/// (PENDING tant que l'appel IA est en cours, COMPLETED/FAILED à l'issue — mission §9). Le token
/// usage est tracé (mêmes champs qu'`AnalysisJob`), jamais appliqué comme quota bloquant (aucune
/// infrastructure de quota existante dans le repo, Sprint 9 §51/§52).
model Message {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// USER | ASSISTANT — protégée par une contrainte CHECK (migration).
  role String @db.VarChar(20)

  content String

  /// PENDING | COMPLETED | FAILED — protégée par une contrainte CHECK (migration). Un message USER
  /// est toujours créé COMPLETED (aucune génération ne lui est propre) ; seul un message ASSISTANT
  /// démarre PENDING.
  status String @default("COMPLETED") @db.VarChar(20)

  /// NULL pour un message ASSISTANT (mission §8 "jamais permettre au frontend de créer
  /// arbitrairement un message SYSTEM" — l'acteur d'un message ASSISTANT est toujours le système).
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  model         String? @db.VarChar(100)
  /// Version du prompt système RÉELLEMENT utilisée pour produire ce message (mission §35), jamais
  /// modifiable après coup — voir `chat/infrastructure/chat-system-prompt.ts`.
  promptVersion Int?    @map("prompt_version")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")

  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  citations MessageCitation[]

  @@unique([id, organizationId])
  @@index([organizationId, conversationId, createdAt])
  /// Garde anti-abus (mission §4/§57) — au plus UN message ASSISTANT PENDING par conversation à la
  /// fois. Vérifiée applicativement AVANT écriture (voir `SendMessageUseCase`, plus rapide, meilleur
  /// message d'erreur) ET protégée par un index unique PARTIEL en base (correctif audit Codex P2 —
  /// `WHERE status = 'PENDING' AND role = 'ASSISTANT'`, non exprimable dans le DSL Prisma, ajouté à
  /// la main dans la migration `..._chat_pending_guard`, même motif que
  /// `tender_participants_active_unique`, Sprint 7) : la vérification applicative seule laissait
  /// passer une course sous PostgreSQL READ COMMITTED entre deux transactions concurrentes.
  @@index([organizationId, conversationId, status])
  @@map("messages")
}

/// V2 Sprint 9 — provenance d'UN message assistant (mission §20 "citation ≠ texte libre") :
/// colonnes concrètes typées nullables, JAMAIS un blob JSON (même motif que les Finding, ex.
/// `TenderRequirementFinding.documentId`/`chunkSequence`/`pageStart`...). Les colonnes de RÉFÉRENCE
/// (documentId, knowledgeEntryId, checklistItemId, findingId...) restent volontairement des
/// scalaires SANS relation Prisma stricte, même motif que les Finding : une citation traverse des
/// modules qui ne se connaissent pas entre eux (Documents, Knowledge Base, Checklist, Analysis),
/// jamais un couplage de schéma cross-module. Seule `messageId` est une relation réelle (le message
/// est le seul propriétaire véritable d'une citation).
model MessageCitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  messageId String  @map("message_id") @db.Uuid
  message   Message @relation(fields: [messageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// DOCUMENT | KNOWLEDGE_ENTRY | CHECKLIST_ITEM | FINDING | TENDER_FIELD — protégée par une
  /// contrainte CHECK (migration).
  sourceType String @map("source_type") @db.VarChar(20)

  documentId        String? @map("document_id") @db.Uuid
  documentVersionId String? @map("document_version_id") @db.Uuid
  chunkSequence     Int?    @map("chunk_sequence")
  pageStart         Int?    @map("page_start")
  pageEnd           Int?    @map("page_end")
  sheetName         String? @map("sheet_name") @db.VarChar(120)
  sectionTitle      String? @map("section_title") @db.VarChar(300)

  knowledgeEntryId        String? @map("knowledge_entry_id") @db.Uuid
  knowledgeEntryVersionId String? @map("knowledge_entry_version_id") @db.Uuid

  checklistItemId String? @map("checklist_item_id") @db.Uuid

  /// Type du Finding cité (ex. "REQUIREMENT", "RISK", "DEADLINE"...) — jamais une FK stricte, même
  /// motif que le reste de ce modèle.
  findingType String? @map("finding_type") @db.VarChar(30)
  findingId   String? @map("finding_id") @db.Uuid

  /// Toujours rempli, affichable tel quel côté frontend (mission §22 "Sources (3)" — jamais une
  /// citation sans libellé lisible, même quand `excerpt` est absent).
  label   String  @db.VarChar(300)
  excerpt String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@index([organizationId, messageId])
  @@map("message_citations")
}

/// V2 Sprint 10 (Moteur documentaire — Templates DOCX) — un template EST le fichier .docx source
/// uploadé, jamais recomposé depuis une IR (motif volontairement DIFFÉRENT d'`ExportTemplate`, qui
/// compose un document depuis une structure contrôlée par notre code : ici le document réel d'un
/// tiers — DC1/DC2/DC4/ATTRI1 en Sprint 11 — doit rester visuellement identique, ses placeholders
/// remplis en place). `DocumentTemplate` est l'identité stable, `DocumentTemplateVersion` porte le
/// fichier et la configuration réels.
model DocumentTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// SYSTEM | ORGANIZATION — CHECK (migration). Mission §"Scope Template limité à SYSTEM/
  /// ORGANIZATION" — jamais Candidate/Client ce sprint.
  scope String @db.VarChar(12)

  name        String  @db.VarChar(200)
  description String?

  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  archivedAt DateTime? @map("archived_at")

  versions DocumentTemplateVersion[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("document_templates")
}

/// Mission §"une seule version ACTIVE par template" — même motif que
/// `export_template_versions_org_template_active_key` (index partiel ajouté à la main, voir
/// migration). Une version ACTIVE est immuable : `sourceDocumentVersionId`/`sourceChecksum`/
/// `discoveredPlaceholders` ne changent JAMAIS après activation (mission "ne jamais modifier
/// template.docx en place" — toute évolution crée une NOUVELLE version).
model DocumentTemplateVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  documentTemplateId String           @map("document_template_id") @db.Uuid
  documentTemplate   DocumentTemplate @relation(fields: [documentTemplateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int

  /// DRAFT | ACTIVE | ARCHIVED — CHECK (migration).
  status String @db.VarChar(10)

  /// Le fichier .docx source, réutilise le module Documents existant tel quel (aucun second
  /// stockage) — jamais réécrit après upload, une régénération de template = nouvelle version.
  sourceDocumentId        String @map("source_document_id") @db.Uuid
  sourceDocumentVersionId String @map("source_document_version_id") @db.Uuid

  /// SHA-256 du fichier source au moment de l'upload — preuve d'immuabilité (mission "empreinte
  /// avant/après génération"), jamais recalculée après création.
  sourceChecksum String @map("source_checksum") @db.VarChar(64)

  /// Placeholders réellement détectés dans le document par le parseur OOXML à l'upload —
  /// `Array<{ fieldKey: string; occurrences: number }>`. Base de la Field Mapping et de la
  /// détection de champs orphelins (mission "ne jamais inventer une valeur manquante").
  discoveredPlaceholders Json @map("discovered_placeholders")

  /// false (défaut) = un champ requis manquant bloque toute génération ; true = la génération
  /// peut aboutir avec des champs manquants listés (mission "génération partielle selon la règle
  /// du template").
  allowPartialGeneration Boolean @default(false) @map("allow_partial_generation")

  /// V2 Sprint 11 — traçabilité GÉNÉRIQUE (jamais de logique métier DC1/DC2/DC4 ici) vers le
  /// fichier OFFICIEL D'ORIGINE, strictement inchangé, lorsque `sourceDocument` est une copie
  /// dérivée technique (placeholders insérés) préparée à partir d'un modèle tiers fourni (mission
  /// "OfficialSourceDocument -> DerivedTenderOSTemplate -> DocumentTemplateVersion"). Dénormalisé
  /// en LECTURE SEULE vers Documents (même motif que `sourceDocumentId`) — absent quand le
  /// template n'a pas de source officielle externe (template composé directement dans TenderOS).
  officialSourceDocumentId        String? @map("official_source_document_id") @db.Uuid
  officialSourceDocumentVersionId String? @map("official_source_document_version_id") @db.Uuid
  /// SHA-256 du fichier officiel d'origine (jamais celui de la copie dérivée) — preuve que le
  /// fichier officiel réellement utilisé comme référence n'a pas changé depuis la préparation.
  officialSourceChecksum          String? @map("official_source_checksum") @db.VarChar(64)

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  activatedAt DateTime? @map("activated_at")
  archivedAt  DateTime? @map("archived_at")

  fieldMappings              DocumentTemplateFieldMapping[]
  generatedDocumentRevisions GeneratedDocumentRevision[]

  @@unique([id, organizationId])
  @@unique([organizationId, documentTemplateId, version])
  @@map("document_template_versions")
}

/// Abstraction GÉNÉRIQUE (mission "ne doit explicitement PAS contenir de logique métier DC1/DC2/
/// DC4/ATTRI1") — décrit uniquement la TRANSFORMATION d'affichage d'un placeholder détecté, jamais
/// sa provenance métier (résolue par l'appelant, hors de ce module, via le `dataSnapshot` fourni à
/// la génération). Aucune colonne `defaultValue` : une valeur absente reste absente, jamais
/// inventée (mission §"jamais un random SIRET/montant/signataire").
model DocumentTemplateFieldMapping {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  documentTemplateVersionId String                  @map("document_template_version_id") @db.Uuid
  documentTemplateVersion   DocumentTemplateVersion @relation(fields: [documentTemplateVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Nom exact du placeholder tel qu'il apparaît dans le document (ex. "tender.reference").
  fieldKey String @map("field_key") @db.VarChar(150)
  label    String @db.VarChar(200)

  /// STRING | DATE | CURRENCY | PERCENTAGE | BOOLEAN | CHECKBOX | MULTILINE | LIST | TABLE — CHECK
  /// (migration).
  fieldType String @map("field_type") @db.VarChar(12)

  required Boolean @default(false)

  /// Options de formatage déclaratif (ex. devise, format de date) — jamais une valeur, seulement
  /// la manière de la présenter.
  formatOptions Json? @map("format_options")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentTemplateVersionId, fieldKey])
  @@map("document_template_field_mappings")
}

/// Racine d'agrégat — une lignée de générations pour un même (Tender, Template) : les révisions
/// successives (régénérations) s'accumulent DESSOUS, jamais en écrasant (mission "GeneratedDocument/
/// Deliverable avec historique de Révisions en append-only, jamais écraser R2 en générant R3").
model GeneratedDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Dénormalisé en LECTURE SEULE — jamais de FK stricte vers `DocumentTemplate` (même motif que
  /// `PrismaGenerationCostReader`, Sprint 7) : la validité réelle passe par le use case public de
  /// ce module, jamais par la DB.
  documentTemplateId String @map("document_template_id") @db.Uuid

  /// Titre dénormalisé depuis le nom du template au moment de la création — jamais recalculé si
  /// le template est renommé ensuite (même motif que `ExportJob.documentType`).
  title String @db.VarChar(200)

  /// V2 Sprint 11B — clé de portée GÉNÉRIQUE (jamais de logique métier DC1/DC2/DC4 ici) distinguant
  /// plusieurs lignées indépendantes pour un même (tenderId, documentTemplateId) — ex. un DC2 par
  /// membre de groupement, un DC4 par déclaration de sous-traitance. `null` = une seule lignée
  /// possible pour ce (tenderId, documentTemplateId) (mission "jamais deux implémentations
  /// divergentes de la découverte de lignée" — administrative-dossier choisit la clé, ce module ne
  /// fait qu'indexer dessus pour retrouver-ou-créer la bonne lignée avant chaque génération).
  subjectId String? @map("subject_id") @db.VarChar(200)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  revisions GeneratedDocumentRevision[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@index([organizationId, tenderId, documentTemplateId, subjectId])
  /// Correctif audit Codex P2 (Sprint 11B) — au plus une lignée par (organizationId, tenderId,
  /// documentTemplateId, subjectId) : filet de sécurité de dernier recours contre le
  /// `pg_advisory_xact_lock` de portée (`lockGenerationScope`), même motif que
  /// `document_template_versions_org_template_active_key`. Deux index partiels ajoutés à la main
  /// en fin de migration (Prisma ne modélise pas nativement `WHERE` dans le DSL) — un pour
  /// `subject_id IS NOT NULL` (DC2/DC4), un pour `subject_id IS NULL` (DC1, Postgres traite
  /// normalement chaque NULL comme distinct dans un index unique classique).
  @@map("generated_documents")
}

/// Une ligne par tentative de génération, JAMAIS mutée après COMPLETED/FAILED (même motif
/// qu'`ExportJob`/`DeliverableRevision`). `documentTemplateVersionId` et `dataSnapshot` sont
/// EXPLICITEMENT figés à cette ligne au lancement — jamais résolus implicitement plus tard (mission
/// §concurrence "templateVersionId et snapshot fixés au lancement, jamais via template.currentVersion").
model GeneratedDocumentRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  generatedDocumentId String            @map("generated_document_id") @db.Uuid
  generatedDocument   GeneratedDocument @relation(fields: [generatedDocumentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revisionNumber     Int     @map("revision_number")
  previousRevisionId String? @map("previous_revision_id") @db.Uuid

  documentTemplateVersionId String                  @map("document_template_version_id") @db.Uuid
  documentTemplateVersion   DocumentTemplateVersion @relation(fields: [documentTemplateVersionId, organizationId], references: [id, organizationId])

  /// PENDING | GENERATING | COMPLETED | FAILED — CHECK (migration).
  status String @db.VarChar(10)

  /// Cliché figé des valeurs de champs fournies par l'appelant au lancement (fieldKey -> valeur) —
  /// jamais relu plus tard depuis les entités source (mission "un futur edit de ClientAccount ne
  /// doit jamais altérer un document déjà généré").
  dataSnapshot Json @map("data_snapshot")

  /// Provenance champ par champ — `Array<{ fieldKey, sourceEntityType?, sourceEntityId?,
  /// sourceEntityVersion?, valuePath?, provided: boolean }>` (mission "traçabilité au niveau du
  /// champ", groundwork Sprint 11).
  provenance Json

  /// Champs requis absents du `dataSnapshot` au lancement — jamais une valeur inventée à la place
  /// (mission "produire une liste missingFields, jamais un random SIRET/montant/signataire").
  missingFields Json @map("missing_fields")

  /// GENERATED | REVIEWED | VALIDATED — CHECK (migration). Distinct de `status` (technique) :
  /// la génération réussie n'est pas une validation métier (mission "generation != business
  /// validation").
  reviewStatus String @default("GENERATED") @map("review_status") @db.VarChar(10)

  /// Artefact final, dénormalisé en LECTURE SEULE vers Documents (même motif que
  /// `AdministrativeDocumentRevision.documentId`) — jamais un second stockage, jamais une URL
  /// publique permanente (téléchargement toujours vérifié par permission, voir
  /// `DownloadGeneratedDocumentRevisionUseCase`).
  artifactDocumentId        String? @map("artifact_document_id") @db.Uuid
  artifactDocumentVersionId String? @map("artifact_document_version_id") @db.Uuid

  errorCode    String? @map("error_code") @db.VarChar(60)
  errorMessage String? @map("error_message")

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@unique([id, organizationId])
  @@unique([generatedDocumentId, revisionNumber])
  @@index([organizationId, generatedDocumentId])
  @@map("generated_document_revisions")
}

// ============================================================================
// V2 Sprint 12 — Mémoire technique IA (module `technical-memo`, distinct de
// `Deliverable.type = TECHNICAL_MEMO` qui compose depuis une IR via le thème
// TenderOS générique et ne préserve jamais un DOCX réel uploadé — décision
// validée : nouveau module séparé, réutilise `document-generation` (Sprint 10)
// pour le remplissage DOCX réel, jamais un second moteur OOXML).
// ============================================================================

/// Racine d'agrégat — un mémoire par (Tender, lot optionnel). `lotId` null = mémoire global au
/// Tender. Réutilise `document-generation` pour le rendu final : `documentTemplateId` référence un
/// `DocumentTemplate` préparé (gabarit dérivé, placeholders insérés par section), jamais un second
/// mécanisme de stockage/version.
model TechnicalMemo {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Dénormalisé depuis `Tender.clientAccountId` au moment de la création, immuable (même motif
  /// que `Conversation.clientAccountId`, Sprint 9) — jamais réévalué implicitement si le candidat
  /// change ensuite (mission "jamais mélanger silencieusement Candidate A et B").
  clientAccountId String  @map("client_account_id") @db.Uuid
  lotId           String? @map("lot_id") @db.Uuid

  /// COMPANY_TEMPLATE | DCE_REQUIRED_TEMPLATE | TENDEROS_SYSTEM — CHECK (migration).
  templateOrigin String @map("template_origin") @db.VarChar(30)

  /// Original uploadé par l'utilisateur (COMPANY_TEMPLATE/DCE_REQUIRED_TEMPLATE) — JAMAIS modifié
  /// (mission §7, même motif que `DocumentTemplateVersion.officialSourceDocumentId`, Sprint 11).
  /// `null` pour TENDEROS_SYSTEM (pas d'upload, gabarit système déjà préparé).
  originalDocumentId        String? @map("original_document_id") @db.Uuid
  originalDocumentVersionId String? @map("original_document_version_id") @db.Uuid

  /// Renseigné une fois l'analyse structurelle terminée et le gabarit dérivé préparé — nullable
  /// tant que le mémoire est encore en cours d'analyse/mapping (mission §9 "analyse ≠
  /// modification", aucun gabarit exploitable tant que l'utilisateur n'a pas confirmé la
  /// structure).
  documentTemplateId String? @map("document_template_id") @db.Uuid

  /// DRAFT (structure importée, mapping en cours) | READY (sections prêtes, génération possible) |
  /// EXPORTED (au moins un DOCX final généré) — CHECK (migration). Jamais confondu avec le statut
  /// de VALIDATION (porté par chaque section, mission §38 "génération ≠ validation").
  status String @default("DRAFT") @db.VarChar(20)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections TechnicalMemoSection[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  /// Au plus un TechnicalMemo par (tenderId, lotId) — deux index partiels (même motif que
  /// `generated_documents_org_tender_template_subject_key`, Sprint 11B) : Postgres traite chaque
  /// `lotId` NULL comme distinct dans un index unique classique.
  @@map("technical_memos")
}

/// Une section de l'outline détecté (ou du template système) — `sectionKey` stable dérivé à
/// l'analyse, jamais recalculé après coup pour ne pas casser les liens de mapping/citations déjà
/// posés. `content` reflète TOUJOURS le contenu de la DERNIÈRE `TechnicalMemoSectionRevision` (mis
/// à jour dans la même transaction — jamais désynchronisé).
model TechnicalMemoSection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  technicalMemoId String        @map("technical_memo_id") @db.Uuid
  technicalMemo   TechnicalMemo @relation(fields: [technicalMemoId, organizationId], references: [id, organizationId], onDelete: Cascade)

  parentSectionId String? @map("parent_section_id") @db.Uuid

  sectionKey String @map("section_key") @db.VarChar(80)
  title      String @db.VarChar(300)
  order      Int
  level      Int

  /// Catalogue fermé (mission §16) + NEEDS_MAPPING (mission §14 "ne pas ignorer une section non
  /// comprise") — CHECK (migration). Suggestion IA possible (mission §15) mais jamais appliquée
  /// sans confirmation pour les cas ambigus.
  category                String  @default("NEEDS_MAPPING") @map("category") @db.VarChar(30)
  categoryConfirmedByUser Boolean @default(false) @map("category_confirmed_by_user")

  /// Texte/consigne source extrait du modèle (ex. "Décrivez votre méthodologie en 2 pages max.") —
  /// jamais réécrit par l'IA, seulement lu pour construire le contexte de génération.
  instructionText String? @map("instruction_text")
  isTable         Boolean @default(false) @map("is_table")

  wordLimit Int? @map("word_limit")
  pageLimit Int? @map("page_limit")

  /// EMPTY | READY_TO_GENERATE | GENERATING | DRAFT | NEEDS_REVIEW | VALIDATED | FAILED — CHECK.
  status String @default("EMPTY") @db.VarChar(20)

  content String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions        TechnicalMemoSectionRevision[]
  requirementLinks TechnicalMemoSectionRequirement[]

  @@unique([id, organizationId])
  @@unique([technicalMemoId, sectionKey])
  @@index([organizationId, technicalMemoId, order])
  @@map("technical_memo_sections")
}

/// Historique APPEND-ONLY d'une section — chaque génération IA, régénération IA, ou édition
/// manuelle crée une nouvelle ligne, jamais un écrasement (mission §39/§42). Les sources
/// (`TechnicalMemoSectionCitation`) sont figées PAR révision (mission §85 "fixer les versions des
/// sources au lancement").
model TechnicalMemoSectionRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  technicalMemoSectionId String               @map("technical_memo_section_id") @db.Uuid
  section                TechnicalMemoSection @relation(fields: [technicalMemoSectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revisionNumber Int @map("revision_number")

  /// AI_GENERATED | MANUAL | AI_REGENERATED — CHECK.
  source String @db.VarChar(20)

  content String

  /// Instruction utilisateur pour une régénération guidée (mission §41, ex. "insister davantage
  /// sur la cybersécurité") — conservée pour l'audit, jamais appliquée à une révision différente.
  userInstruction String? @map("user_instruction")

  aiModel          String? @map("ai_model") @db.VarChar(100)
  promptVersion    Int?    @map("prompt_version")
  inputTokenCount  Int?    @map("input_token_count")
  outputTokenCount Int?    @map("output_token_count")
  totalTokenCount  Int?    @map("total_token_count")

  /// Libellés métier des données manquantes détectées par le modèle (mission §36, ex. "Nombre
  /// d'ingénieurs mobilisés") — jamais une balise textuelle imposée dans le contenu lui-même sans
  /// validation utilisateur.
  missingDataNotes Json @default("[]") @map("missing_data_notes")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  citations TechnicalMemoSectionCitation[]

  @@unique([id, organizationId])
  @@unique([technicalMemoSectionId, revisionNumber])
  @@index([organizationId, technicalMemoSectionId])
  @@map("technical_memo_section_revisions")
}

/// Provenance d'UNE révision de section — même discipline que `MessageCitation` (Sprint 9) :
/// colonnes concrètes typées nullables, JAMAIS un blob JSON, JAMAIS de FK stricte cross-module
/// (une citation traverse Analysis/Knowledge Base/company-profile, qui ne se connaissent pas entre
/// eux). Motif COPIÉ, jamais une table partagée entre modules.
model TechnicalMemoSectionCitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  technicalMemoSectionRevisionId String                       @map("technical_memo_section_revision_id") @db.Uuid
  revision                       TechnicalMemoSectionRevision @relation(fields: [technicalMemoSectionRevisionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// FINDING | KNOWLEDGE_ENTRY | CANDIDATE_FIELD | REFERENCE | DCE_CHUNK — CHECK.
  sourceType String @map("source_type") @db.VarChar(20)

  findingType String? @map("finding_type") @db.VarChar(30)
  findingId   String? @map("finding_id") @db.Uuid

  knowledgeEntryId        String? @map("knowledge_entry_id") @db.Uuid
  knowledgeEntryVersionId String? @map("knowledge_entry_version_id") @db.Uuid

  companyReferenceId String? @map("company_reference_id") @db.Uuid

  candidateFieldPath String? @map("candidate_field_path") @db.VarChar(120)

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")

  label   String  @db.VarChar(300)
  excerpt String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@index([organizationId, technicalMemoSectionRevisionId])
  @@map("technical_memo_section_citations")
}

/// Lien Section ↔ exigence DCE (mission §45 "Requirement ↔ Section"), calculé par une règle
/// déterministe auditable (catégorie + mots-clés — mission §47/§96 "pas besoin d'un algorithme
/// parfait mais une logique auditable"), corrigible par l'utilisateur. Alimente le calcul de
/// couverture (mission §43-46).
model TechnicalMemoSectionRequirement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  technicalMemoSectionId String               @map("technical_memo_section_id") @db.Uuid
  section                TechnicalMemoSection @relation(fields: [technicalMemoSectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// REQUIREMENT | CRITERION | CLAUSE — CHECK (sous-ensemble des 6 types Finding, ceux pertinents
  /// pour une couverture de mémoire — RISK/DEADLINE/QUESTION ne sont jamais "couverts" par une
  /// section rédactionnelle).
  findingType String @map("finding_type") @db.VarChar(30)
  findingId   String @map("finding_id") @db.Uuid

  /// COVERED | PARTIALLY_COVERED | NOT_COVERED | NOT_APPLICABLE | NEEDS_REVIEW — CHECK.
  coverageStatus String  @default("NEEDS_REVIEW") @map("coverage_status") @db.VarChar(20)
  coverageReason String? @map("coverage_reason")

  confirmedByUser Boolean @default(false) @map("confirmed_by_user")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@unique([technicalMemoSectionId, findingType, findingId])
  @@index([organizationId, findingType, findingId])
  @@map("technical_memo_section_requirements")
}

/// V2 Sprint 13 (Chiffrage BPU/DPGF/DQE) — un chiffrage par (Tender, lot optionnel, candidate,
/// fichier source financier du DCE) : un lot peut porter PLUSIEURS chiffrages simultanés (BPU +
/// DQE + DPGF, mission §20), jamais un seul agrégat fourre-tout. `sourceDocumentId` pointe
/// TOUJOURS vers un `Document`/`DocumentVersion` déjà présent dans le DCE (mission §7 "pas de
/// réimport obligatoire") — jamais un second stockage parallèle du même fichier acheteur.
model PricingSchedule {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  lotId String? @map("lot_id") @db.Uuid

  /// Mission §69 — jamais réutilisé aveuglément entre deux candidates du même Tender.
  clientAccountId String @map("client_account_id") @db.Uuid

  /// BPU | DPGF | DQE | OTHER_FINANCIAL_SCHEDULE — CHECK (migration).
  financialDocumentType String @map("financial_document_type") @db.VarChar(30)

  /// Fichier acheteur ORIGINAL (mission §9 "immuable") — jamais modifié, jamais réimporté si déjà
  /// présent dans le DCE.
  sourceDocumentId        String @map("source_document_id") @db.Uuid
  sourceDocumentVersionId String @map("source_document_version_id") @db.Uuid

  /// DRAFT | READY | VALIDATED | EXPORTED — dénormalisé depuis la version courante (mission §43),
  /// jamais la seule source de vérité (voir `PricingScheduleVersion.status`).
  status String @default("DRAFT") @db.VarChar(20)

  currentVersionId     String? @map("current_version_id") @db.Uuid
  currentVersionNumber Int     @default(0) @map("current_version_number")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions PricingScheduleVersion[]

  @@unique([id, organizationId])
  /// Un seul chiffrage par (Tender, lot, candidate, fichier source) — appliqué via DEUX index
  /// partiels écrits à la main dans la migration (le DSL Prisma ne peut pas exprimer `WHERE`),
  /// même motif que `TechnicalMemo` (Sprint 12) : Postgres traite chaque `lotId` NULL comme
  /// distinct dans un index unique classique.
  @@index([organizationId, tenderId])
  @@index([organizationId, clientAccountId])
  @@map("pricing_schedules")
}

/// Historique APPEND-ONLY d'un chiffrage (mission §22 "V1, V2, V3-VALIDATED... jamais écraser une
/// version validée") — chaque version fige sa PROPRE `sourceDocumentVersionId` (mission §8/§23,
/// jamais `document.currentVersion` implicite) et porte SES PROPRES lignes
/// (`PricingScheduleLine.pricingScheduleVersionId`) : créer V2 ne mute jamais les lignes de V1.
model PricingScheduleVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  pricingScheduleId String          @map("pricing_schedule_id") @db.Uuid
  pricingSchedule   PricingSchedule @relation(fields: [pricingScheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  versionNumber Int @map("version_number")

  /// DRAFT | IN_REVIEW | VALIDATED — CHECK. Une version VALIDATED est immuable (mission §45).
  status String @default("DRAFT") @db.VarChar(20)

  /// Figée à la création de CETTE version (mission §8) — jamais recalculée si le Document source
  /// change ensuite (une nouvelle version de chiffrage devrait alors être créée explicitement).
  sourceDocumentVersionId String @map("source_document_version_id") @db.Uuid

  /// Incrémentée uniquement si l'utilisateur corrige le mapping colonnes/feuille (mission §14) —
  /// jamais recalculée en silence pour une version déjà créée.
  mappingVersion Int @default(1) @map("mapping_version")

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  validatedBy String?   @map("validated_by") @db.Uuid
  validatedAt DateTime? @map("validated_at")

  lines      PricingScheduleLine[]
  finalFiles PricingScheduleFinalFile[]

  @@unique([id, organizationId])
  @@unique([pricingScheduleId, versionNumber])
  @@index([organizationId, pricingScheduleId])
  @@map("pricing_schedule_versions")
}

/// Une ligne extraite du classeur acheteur (mission §15) — appartient à UNE VERSION précise
/// (jamais mutable après la validation de cette version, mission §45 "create new version"). Les
/// champs acheteur (désignation/unité/quantité/référence cellule) sont VERROUILLÉS côté domaine
/// (mission §29/§30) ; seul `proposedUnitPrice`/`proposedTotal` (et le detail `costBreakdown`
/// optionnel) sont modifiables par l'entreprise avant validation.
model PricingScheduleLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  pricingScheduleVersionId String                 @map("pricing_schedule_version_id") @db.Uuid
  pricingScheduleVersion   PricingScheduleVersion @relation(fields: [pricingScheduleVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sheetName String @map("sheet_name") @db.VarChar(200)
  rowNumber Int    @map("row_number")

  /// PRICE_ITEM | SECTION_HEADER | SUBTOTAL | NOTE — CHECK (mission §18 "ne pas traiter toutes les
  /// lignes comme PricingLine tarifaire"). Seul PRICE_ITEM porte un prix.
  kind String @default("PRICE_ITEM") @db.VarChar(20)

  /// Hiérarchie DPGF (mission §39 "chapitre → sous-chapitre → poste") — profondeur 0 = racine,
  /// jamais recalculée après extraction.
  hierarchyLevel Int     @default(0) @map("hierarchy_level")
  parentLineId   String? @map("parent_line_id") @db.Uuid

  /// Données ACHETEUR verrouillées — jamais modifiables via l'API (mission §29/§30).
  designation String   @db.VarChar(1000)
  unit        String?  @db.VarChar(60)
  quantity    Decimal? @db.Decimal(18, 6)

  /// Provenance cellule ACHETEUR (mission §16/§17) — jamais perdue, toujours la source de vérité
  /// pour une future réinjection.
  designationCellRef    String? @map("designation_cell_ref") @db.VarChar(20)
  quantityCellRef       String? @map("quantity_cell_ref") @db.VarChar(20)
  buyerUnitPriceCellRef String? @map("buyer_unit_price_cell_ref") @db.VarChar(20)
  buyerTotalCellRef     String? @map("buyer_total_cell_ref") @db.VarChar(20)

  /// Champs ENTREPRISE modifiables — jamais renseignés à l'extraction, jamais suggérés
  /// automatiquement par une IA comme valeur finale (mission §27/§28).
  proposedUnitPrice Decimal? @map("proposed_unit_price") @db.Decimal(18, 6)
  proposedTotal     Decimal? @map("proposed_total") @db.Decimal(18, 6)
  currencyCode      String   @default("EUR") @map("currency_code") @db.VarChar(3)

  /// Mode avancé optionnel (mission §26) — jamais obligatoire, jamais un ERP comptable.
  costBreakdown Json? @map("cost_breakdown")

  candidateComment String? @map("candidate_comment")

  /// EMPTY | PRICED | NEEDS_REVIEW — CHECK.
  status String @default("EMPTY") @db.VarChar(20)

  /// Clé de rapprochement BPU↔DQE normalisée (mission §38) — jamais une fusion automatique sur
  /// simple similarité texte, seulement un signal proposé.
  matchingKey String? @map("matching_key") @db.VarChar(300)

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@unique([pricingScheduleVersionId, sheetName, rowNumber])
  @@index([organizationId, pricingScheduleVersionId])
  @@index([organizationId, matchingKey])
  @@map("pricing_schedule_lines")
}

/// Artefact APPEND-ONLY (mission "snapshot au moment de la génération... historique complet") —
/// un simple pointeur de provenance vers le fichier financier final RÉEL, dont les octets vivent
/// dans Document/DocumentVersion (mission "réutiliser Document/DocumentVersion... jamais un système
/// de stockage parallèle") : cette table ne stocke JAMAIS elle-même un fichier, uniquement l'ID de
/// la `PricingScheduleVersion` VALIDATED source et l'ID du Document/DocumentVersion produit. Une
/// même version VALIDATED peut produire plusieurs lignes ici (nouvelle tentative après échec de
/// stockage, ou régénération explicite) — jamais mise à jour en place, toujours une nouvelle ligne.
model PricingScheduleFinalFile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  pricingScheduleVersionId String                 @map("pricing_schedule_version_id") @db.Uuid
  pricingScheduleVersion   PricingScheduleVersion @relation(fields: [pricingScheduleVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Fichier RÉEL produit (copie chirurgicale du classeur source, mission §9 "jamais modifier
  /// l'original") — stocké via le module Documents, jamais une seconde infrastructure de fichier.
  documentId        String @map("document_id") @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid

  injectedCellCount Int @map("injected_cell_count")

  generatedBy String   @map("generated_by") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([id, organizationId])
  @@index([organizationId, pricingScheduleVersionId])
  @@map("pricing_schedule_final_files")
}

// ============================================================================
// V2 Sprint 14 — Finalisation du dossier de réponse / Package final (module `response-package`).
// Décision architecturale validée (AskUserQuestion) : un module NOUVEAU et ÉTROIT, scopé
// Tender+Lot+Candidate, plutôt qu'un rétrofit de `submission-package`/`export`/`validation`/
// `deliverables`/`signature` (6 modules déjà livrés, strictement Tender-only, jamais lotId — audit
// confirmé par recherche exhaustive). Ce module ne recrée AUCUN moteur : il assemble des
// `DocumentVersion` déjà produites par DCE/Documents/dossier administratif/mémoire technique/
// chiffrage, réutilise la technique ZIP+manifest+checksum+anti-zip-slip déjà éprouvée par
// `submission-package` (copiée, jamais importée à travers la frontière du module — même motif que
// `AtomicTransactionRunner`/`AuditLogWriter` dupliqués volontairement partout dans ce dépôt).
// ============================================================================

/// Racine d'agrégat — un dossier de réponse par (Tender, lot optionnel, candidate). `lotId` null =
/// package "global" (mission §9 — pièces communes à plusieurs lots, jamais dupliquées
/// physiquement : le PackageItem référence la même DocumentVersion, seul le snapshot par version
/// diffère). `clientAccountId` dénormalisé depuis `Tender.clientAccountId` (mission §10 — pas de
/// `CandidateCompany` dédié dans ce dépôt, confirmé par audit : le candidat EST le ClientAccount du
/// Tender), immuable après création.
model ResponsePackage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  lotId String? @map("lot_id") @db.Uuid

  clientAccountId String @map("client_account_id") @db.Uuid

  /// DRAFT | IN_REVIEW | READY | VALIDATED | EXPORTED | INVALIDATED — dénormalisé depuis la
  /// version courante (mission §41), jamais la seule source de vérité (voir
  /// `ResponsePackageVersion.status`).
  status String @default("DRAFT") @db.VarChar(20)

  currentVersionId     String? @map("current_version_id") @db.Uuid
  currentVersionNumber Int     @default(0) @map("current_version_number")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions ResponsePackageVersion[]

  @@unique([id, organizationId])
  /// Un seul dossier de réponse par (Tender, lot, candidate) — deux index partiels écrits à la
  /// main dans la migration (même motif que `PricingSchedule`/`TechnicalMemo`, Postgres traite
  /// chaque `lotId` NULL comme distinct dans un index unique classique).
  @@index([organizationId, tenderId])
  @@index([organizationId, clientAccountId])
  @@map("response_packages")
}

/// Historique APPEND-ONLY (mission §11 "une version validée ne doit jamais être écrasée
/// silencieusement") — chaque version porte SES PROPRES `PackageItem` (mission §50 "après
/// validation : PackageVersion immuable, toute modification : nouvelle version"), jamais une
/// mutation des items d'une version antérieure.
model ResponsePackageVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  responsePackageId String          @map("response_package_id") @db.Uuid
  responsePackage   ResponsePackage @relation(fields: [responsePackageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  versionNumber Int @map("version_number")

  /// DRAFT | IN_REVIEW | VALIDATED — CHECK. VALIDATED est un état terminal et immuable (mission
  /// §50) pour cette version précise.
  status String @default("DRAFT") @db.VarChar(20)

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  validatedBy String?   @map("validated_by") @db.Uuid
  validatedAt DateTime? @map("validated_at")

  items     PackageItem[]
  artifacts PackageArtifact[]

  @@unique([id, organizationId])
  @@unique([responsePackageId, versionNumber])
  @@index([organizationId, responsePackageId])
  @@map("response_package_versions")
}

/// Une pièce attendue explicitement représentée (mission §12) — jamais un simple booléen
/// `required` (mission §13 "empêcherait de représenter correctement les documents
/// conditionnels") : `requirementType` (REQUIRED/OPTIONAL/CONDITIONAL) et `applicabilityStatus`
/// (APPLICABLE/NOT_APPLICABLE/NEEDS_REVIEW) sont deux axes SÉPARÉS, corrigibles indépendamment par
/// un utilisateur autorisé (mission §21/§72) sans jamais modifier silencieusement la Checklist
/// source (mission §32 "Checklist ≠ Package"). `documentVersionId` est TOUJOURS figé au moment de
/// l'ajout/du snapshot (mission §16 POINT CRITIQUE) — jamais recalculé implicitement depuis
/// `document.currentVersion`.
model PackageItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  responsePackageVersionId String                 @map("response_package_version_id") @db.Uuid
  responsePackageVersion   ResponsePackageVersion @relation(fields: [responsePackageVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// ADMINISTRATIVE | TECHNICAL | FINANCIAL | LEGAL | CERTIFICATE | ANNEX | OTHER — CHECK
  /// (mission §14 "ne pas utiliser uniquement le nom du fichier pour comprendre le dossier").
  category String @db.VarChar(20)

  /// Nom de la pièce ATTENDUE (ex. "Attestation fiscale") — jamais dérivé uniquement du nom de
  /// fichier du document éventuellement rattaché.
  label String @db.VarChar(300)

  /// Étiquette libre du type de document (ex. "DC1", "BPU_FINAL") — jamais un catalogue fermé
  /// supplémentaire redondant avec `category`.
  documentType String? @map("document_type") @db.VarChar(60)

  /// CHECKLIST_ITEM | ADMINISTRATIVE_DOCUMENT | TECHNICAL_MEMO | PRICING_SCHEDULE_FINAL_FILE |
  /// UPLOADED_DOCUMENT | MANUAL — CHECK (mission §15 "sources des livrables").
  sourceType String  @map("source_type") @db.VarChar(30)
  sourceId   String? @map("source_id") @db.Uuid

  /// Mission §16 POINT CRITIQUE — jamais seulement `documentId`, toujours la version FIGÉE.
  documentId        String? @map("document_id") @db.Uuid
  documentVersionId String? @map("document_version_id") @db.Uuid

  /// REQUIRED | OPTIONAL | CONDITIONAL — CHECK (mission §13/§20).
  requirementType String @map("requirement_type") @db.VarChar(20)

  /// APPLICABLE | NOT_APPLICABLE | NEEDS_REVIEW — CHECK (mission §3/§28 "condition inconnue →
  /// NEEDS_REVIEW, jamais un blocage automatique sur une déduction incertaine").
  applicabilityStatus String  @map("applicability_status") @db.VarChar(20)
  conditionText       String? @map("condition_text")

  /// READY | MISSING_BLOCKING | MISSING_NON_BLOCKING | NOT_APPLICABLE | NEEDS_REVIEW — dérivé
  /// (mission §26/§27), jamais la seule source de vérité pour le calcul de complétude (recalculé
  /// à la lecture, même motif que les contrôles Sprint 13).
  status String @db.VarChar(30)

  /// Dénormalisé depuis le `ResponsePackage` parent — jamais mélangé silencieusement entre lots
  /// (mission §8).
  lotId String? @map("lot_id") @db.Uuid

  /// Mission §30 — contrôle de validité si une date d'expiration est connue.
  expiresAt DateTime? @map("expires_at")

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, responsePackageVersionId])
  @@map("package_items")
}

/// Artefact ZIP APPEND-ONLY (mission §63 "PackageArtifact") — même motif que
/// `PricingScheduleFinalFile` (Sprint 13) : un pointeur de provenance, les octets réels vivent dans
/// le stockage via `StorageProvider` (module Documents), jamais un second système de fichiers.
/// `manifest` fige la liste des pièces incluses au moment de la génération (mission §61), jamais
/// recalculé après coup.
model PackageArtifact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  responsePackageVersionId String                 @map("response_package_version_id") @db.Uuid
  responsePackageVersion   ResponsePackageVersion @relation(fields: [responsePackageVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  storageKey String @map("storage_key") @db.VarChar(500)
  fileName   String @map("file_name") @db.VarChar(300)
  mimeType   String @map("mime_type") @db.VarChar(120)
  sizeBytes  Int    @map("size_bytes")

  /// SHA-256 hexadécimal (mission §62), calculé sur l'archive ZIP finale elle-même.
  checksum String @db.VarChar(64)

  manifest Json

  generatedBy String   @map("generated_by") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([id, organizationId])
  @@index([organizationId, responsePackageVersionId])
  @@map("package_artifacts")
}

/// V2 Sprint 16 (Integration Hub) — clé API d'organisation (mission §10). La clé brute n'est
/// JAMAIS stockée (mission §10/§97) : seul `keyHash` (SHA-256 hex) permet la vérification,
/// `keyPrefix` (unique, retrouvable en clair) sert de lookup O(1) sans exposer le secret. Une
/// clé porte ses propres `scopes` (mission §14, jamais omnipotente par défaut) et une restriction
/// client OPTIONNELLE (`allowedClientAccountIds`, décision validée) : liste vide = aucune
/// restriction supplémentaire (le principal technique voit tout ce que ses scopes autorisent),
/// liste renseignée = narrowing STRICT, jamais un élargissement (mission §18/§100).
model ApiKey {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name      String @db.VarChar(160)
  keyPrefix String @unique @map("key_prefix") @db.VarChar(24)
  keyHash   String @map("key_hash") @db.VarChar(128)

  /// Catalogue gouverné (mission §14/§21) — CHECK laissé libre ici (array), validé en
  /// application contre `API_KEY_SCOPES` (jamais un scope arbitraire accepté à la création).
  scopes String[] @default([])

  /// Vide = pas de restriction client additionnelle. Non-vide = narrowing strict (mission §18).
  allowedClientAccountIds String[] @default([]) @map("allowed_client_account_ids")

  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by") @db.Uuid

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("api_keys")
}

/// V2 Sprint 16 — abonnement webhook d'organisation (mission §20). `secret` est stocké en clair
/// (VOLONTAIRE, documenté) : contrairement à une ApiKey, TenderOS doit pouvoir le relire pour
/// calculer la signature HMAC de CHAQUE livraison sortante — un hash unidirectionnel serait
/// inutilisable ici (même compromis qu'un webhook secret Stripe/GitHub). Jamais exposé après la
/// création dans une réponse API, jamais journalisé (mission §30/§34).
model WebhookSubscription {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  endpointUrl String  @map("endpoint_url") @db.VarChar(2048)
  description String? @db.VarChar(300)

  /// Catalogue gouverné (mission §21/§22), validé en application contre `INTEGRATION_EVENT_CATALOG`.
  events String[] @default([])

  secret String @db.VarChar(128)

  /// ACTIVE | DISABLED (mission §57) — DISABLED : aucune nouvelle delivery.
  status String @default("ACTIVE") @db.VarChar(20)

  /// Même motif que `ApiKey.allowedClientAccountIds` (mission §79 "Webhook Filter Client").
  allowedClientAccountIds String[] @default([]) @map("allowed_client_account_ids")

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  deliveries WebhookDelivery[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("webhook_subscriptions")
}

/// V2 Sprint 16 — trace de livraison (mission §33). `eventId` = `OutboxEvent.id` (mission §25,
/// réutilisé tel quel, jamais un second identifiant d'événement parallèle) ; l'unicité
/// `(subscriptionId, eventId)` rend la création par le handler Outbox idempotente (mission §44/§90
/// — un même événement métier ne doit jamais produire deux deliveries pour le même abonnement,
/// même si l'événement Outbox est re-traité après un échec partiel).
model WebhookDelivery {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  subscriptionId String              @map("subscription_id") @db.Uuid
  subscription   WebhookSubscription @relation(fields: [subscriptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  eventId   String @map("event_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(80)
  payload   Json

  /// PENDING | DELIVERING | SUCCEEDED | RETRYING | DEAD (mission §35, "ou équivalent" — FAILED
  /// fusionné dans RETRYING/DEAD, jamais un état de repos distinct, voir rapport Sprint 16).
  status       String    @default("PENDING") @db.VarChar(20)
  attemptCount Int       @default(0) @map("attempt_count")
  httpStatus   Int?      @map("http_status")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")

  /// Prochain moment éligible à une reprise (mission §40 backoff) — sert aussi de fenêtre de
  /// "claim" (WHERE status IN (...) AND nextAvailableAt <= now), même motif que
  /// `outbox_events.available_at`.
  nextAvailableAt DateTime @default(now()) @map("next_available_at")
  errorSummary    String?  @map("error_summary") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@unique([subscriptionId, eventId])
  @@index([organizationId, subscriptionId, createdAt])
  @@index([status, nextAvailableAt])
  @@map("webhook_deliveries")
}

/// V2 Sprint 17 (Veille & détection des marchés) — marché externe collecté et normalisé
/// (mission §8). Scope organisationnel (comme tout le reste du schéma, mission §73) : décision
/// délibérée de simplification — un marché public (BOAMP/TED) collecté pour deux organisations
/// distinctes est stocké deux fois plutôt que partagé globalement, ce qui évite d'introduire le
/// premier modèle "non tenant-scopé" de tout le schéma (150+ modèles, tous organizationId-first).
/// Voir rapport Sprint 17 §"risques résiduels" pour la piste d'optimisation différée (cache
/// global + projection par organisation). `source`/`marketType` réutilisent tels quels
/// `TenderSource`/`MarketType` (tenders/domain) — jamais un second catalogue parallèle.
model ExternalTender {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// MANUAL | BOAMP | TED | PRIVATE | OTHER (`TenderSource`, réutilisé tel quel).
  source     String @db.VarChar(20)
  /// PUBLIC | PRIVATE (`MarketType`, réutilisé tel quel — mission §6/§7).
  marketType String @map("market_type") @db.VarChar(10)
  /// Identifiant stable côté source (ex. `idweb` BOAMP) — clé de déduplication avec `source`
  /// (mission §11 "priorité source + externalId").
  externalId String @map("external_id") @db.VarChar(255)

  title       String  @db.VarChar(500)
  description String?

  buyerName String? @map("buyer_name") @db.VarChar(300)
  buyerType String? @map("buyer_type") @db.VarChar(80)

  /// Géographie STRUCTURÉE (décision Sprint 17, validée) — délibérément distincte du texte libre
  /// `Tender.executionLocation`/`geographicZone` : nécessaire pour un filtre HARD fiable
  /// (mission §22, test bloquant §122 — un pays ne peut être exclu de façon fiable qu'avec un
  /// champ structuré, jamais un substring sur texte libre).
  country    String? @db.VarChar(10)
  region     String? @db.VarChar(120)
  department String? @db.VarChar(10)
  city       String? @db.VarChar(160)

  /// Codes CPV bruts (ex. "34300000") — matching par préfixe hiérarchique (décision Sprint 17),
  /// aucun référentiel de libellés importé ce sprint (mission §21, "ne pas faire uniquement du
  /// substring" satisfait par la comparaison de préfixe, pas par un lookup de labels).
  cpvCodes String[] @default([]) @map("cpv_codes")

  /// NULL = montant inconnu à la source (mission §23 — fréquent en pratique, ex. BOAMP ne
  /// structure quasi jamais le montant en JSON) : ne doit jamais exclure arbitrairement un
  /// marché, voir `SavedSearch.includeUnknownAmount`.
  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @db.Char(3)

  procedureType String? @map("procedure_type") @db.VarChar(120)

  publicationDate    DateTime? @map("publication_date")
  submissionDeadline DateTime? @map("submission_deadline")

  sourceUrl String? @map("source_url") @db.VarChar(2048)

  /// Lots minimaux (mission §25) — jamais le detail complet du DCE, juste de quoi afficher/matcher
  /// "Lot 3 pertinent" : `[{ number, description, cpvCode? }]`.
  lots Json?

  /// Mission §9 — jamais le payload source complet : uniquement les champs bruts utiles au
  /// debug/reprocessing/provenance (jamais un blob de plusieurs Ko par marché).
  rawMetadata Json? @map("raw_metadata")

  /// Détecte une mise à jour significative côté source (mission §12) — hash des champs normalisés
  /// ci-dessus (jamais `rawMetadata`, trop volatile/bruyant pour un hash stable).
  checksum String? @db.VarChar(64)

  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastFetchedAt DateTime @default(now()) @map("last_fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  matches SavedSearchMatch[]

  @@unique([id, organizationId])
  /// Déduplication (mission §11) — priorité absolue source+externalId, jamais une fusion agressive
  /// sur d'autres signaux (buyer/titre/deadline, mission §11 "ne pas fusionner agressivement").
  @@unique([organizationId, source, externalId])
  @@index([organizationId, publicationDate])
  @@index([organizationId, submissionDeadline])
  @@index([organizationId, country])
  @@index([organizationId, source])
  @@map("external_tenders")
}

/// V2 Sprint 17 — profil de veille personnel (mission §15, "SavedTenderSearch"/"TenderWatchProfile"
/// équivalent). Scope PERSONAL uniquement ce sprint (mission §16 "au minimum PERSONAL") —
/// `ownerUserId` obligatoire, jamais de partage organisation cette tranche.
model SavedSearch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  ownerUserId    String @map("owner_user_id") @db.Uuid

  /// Contexte client optionnel (mission §18) — si renseigné, ClientAccess gouverne
  /// visibilité/édition/notifications (mission §19/§71), jamais un élargissement de ClientAccess
  /// (mission §18 "ne jamais élargir").
  clientAccountId String? @map("client_account_id") @db.Uuid

  name String @db.VarChar(160)

  /// Mission §20 — normalisation case-insensitive appliquée en application, jamais ici.
  includeKeywords String[] @default([]) @map("include_keywords")
  excludeKeywords String[] @default([]) @map("exclude_keywords")

  /// Préfixes CPV (mission §21) — HARD filter si non vide.
  cpvCodes String[] @default([]) @map("cpv_codes")

  /// Géographie HARD (mission §22/§122) — listes vides = pas de restriction sur cette dimension.
  countries   String[] @default([])
  regions     String[] @default([])
  departments String[] @default([])
  cities      String[] @default([])

  marketTypes String[] @default([]) @map("market_types")
  sources     String[] @default([])

  minAmount            Decimal? @map("min_amount") @db.Decimal(19, 4)
  maxAmount            Decimal? @map("max_amount") @db.Decimal(19, 4)
  /// Mission §23 — comportement explicite plutôt qu'une exclusion arbitraire par défaut.
  includeUnknownAmount Boolean  @default(true) @map("include_unknown_amount")

  publishedAfter     DateTime? @map("published_after")
  /// "Deadline dans plus de X jours" (mission §24) — évalué au moment du matching, jamais figé.
  deadlineAfterDays  Int?      @map("deadline_after_days")
  deadlineBeforeDate DateTime? @map("deadline_before_date")

  procedureTypes String[] @default([]) @map("procedure_types")

  alertInApp     Boolean @default(true) @map("alert_in_app")
  alertEmail     Boolean @default(false) @map("alert_email")
  /// IMMEDIATE | DAILY_DIGEST (mission §43, recommandation retenue).
  emailFrequency String  @default("DAILY_DIGEST") @map("email_frequency") @db.VarChar(20)

  /// Mission §115 — désactivation : plus de nouveaux matches/alertes, jamais de suppression des
  /// ExternalTenders déjà collectés.
  isActive Boolean @default(true) @map("is_active")

  /// Dernier digest quotidien envoyé (mission §111 idempotence) — un match déjà inclus dans un
  /// digest précédent n'est jamais renvoyé.
  lastDigestSentAt DateTime? @map("last_digest_sent_at")

  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  matches SavedSearchMatch[]

  @@unique([id, organizationId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, isActive])
  @@map("saved_searches")
}

/// V2 Sprint 17 — occurrence de correspondance entre un `SavedSearch` et un `ExternalTender`
/// (mission §49, "TenderAlertMatch"/"SavedSearchMatch" équivalent). Idempotent par construction
/// (`@@unique([savedSearchId, externalTenderId])`, mission §48 "le même marché ne doit pas
/// produire plusieurs alertes pour le même profil s'il n'a pas changé").
model SavedSearchMatch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  savedSearchId String      @map("saved_search_id") @db.Uuid
  savedSearch   SavedSearch @relation(fields: [savedSearchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  externalTenderId String         @map("external_tender_id") @db.Uuid
  externalTender   ExternalTender @relation(fields: [externalTenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// 0-100, uniquement dérivé des critères SOFT (mission §29 "explicable" — jamais un nombre
  /// arbitraire ; les critères HARD ne contribuent jamais au score, ils éliminent en amont,
  /// mission §28).
  score        Int  @default(0)
  /// `[{ criterion, label, matched }]` (mission §30 whyMatched) — jamais un texte libre.
  matchReasons Json @map("match_reasons")

  /// NEW | INTERESTED | IGNORED (mission §51/§52).
  status String @default("NEW") @db.VarChar(20)

  firstMatchedAt DateTime @default(now()) @map("first_matched_at")
  lastMatchedAt  DateTime @default(now()) @map("last_matched_at")

  notifiedInAppAt DateTime? @map("notified_in_app_at")

  /// Mission §66/§67 — jamais envoyé dans la transaction de matching : un worker séparé CLAIME
  /// atomiquement (`UPDATE ... FOR UPDATE SKIP LOCKED`, correctif audit P1-001) les matches
  /// `PENDING`, tente l'envoi, et met à jour ces trois champs. PENDING | SENDING (transitoire, posé
  /// par le claim) | SENT | FAILED (FAILED = abandon après `EMAIL_ALERT_MAX_ATTEMPTS`, jamais un
  /// retry indéfini).
  emailStatus       String    @default("PENDING") @map("email_status") @db.VarChar(20)
  emailAttemptCount Int       @default(0) @map("email_attempt_count")
  emailLastError    String?   @map("email_last_error") @db.VarChar(500)
  notifiedEmailAt   DateTime? @map("notified_email_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@unique([savedSearchId, externalTenderId])
  @@index([organizationId, savedSearchId, status])
  @@index([organizationId, externalTenderId])
  @@index([organizationId, emailStatus])
  @@map("saved_search_matches")
}

/// V2 Sprint 17 — trace de promotion ExternalTender -> Opportunity (mission §56 "prévenir
/// l'utilisateur, ne pas dupliquer silencieusement"). Délibérément découplé du module
/// `opportunity` (aucune colonne ajoutée à `Opportunity`, aucun couplage Prisma cross-module,
/// même motif que `WebhookDelivery.eventId` référence `OutboxEvent.id` par simple scalaire).
/// Correctif audit P1-002 — la vraie protection contre une double promotion concurrente est un
/// `pg_advisory_xact_lock` (voir `PrismaExternalTenderPromotionRepository.lockForPromotion`) acquis
/// avant la lecture de dédoublonnage, dans la même transaction que la création. En DEUXIÈME ligne
/// de défense, deux index uniques PARTIELS existent en base (non représentables via `@@unique` en
/// Prisma, posés à la main dans la migration `..._p1_fixes`) :
///   - (organizationId, externalTenderId, clientAccountId) WHERE clientAccountId IS NOT NULL
///   - (organizationId, externalTenderId) WHERE clientAccountId IS NULL
/// (deux index car Postgres ne déduplique jamais les NULL dans un index unique classique).
model ExternalTenderPromotion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  externalTenderId String  @map("external_tender_id") @db.Uuid
  clientAccountId  String? @map("client_account_id") @db.Uuid

  opportunityId String @map("opportunity_id") @db.Uuid

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@index([organizationId, externalTenderId])
  @@map("external_tender_promotions")
}

/// V2 Sprint 17 — socle minimal de notification in-app (mission §37 "ne pas reconstruire un énorme
/// système"). Générique (pas seulement Market Watch) via `type`, mais SEUL producteur ce sprint :
/// `SavedSearchMatch`.
model Notification {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  type      String  @db.VarChar(60)
  title     String  @db.VarChar(300)
  body      String?
  targetUrl String? @map("target_url") @db.VarChar(500)
  metadata  Json?

  /// NULL = non lue (mission §38).
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}
