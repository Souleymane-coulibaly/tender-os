  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  /// ADMINISTRATIVE | TECHNICAL_MEMO | REFERENCES | CV | CERTIFICATION | INSURANCE |
  /// FINANCIAL_CAPACITY | TECHNICAL_CAPACITY | HUMAN_RESOURCES | MATERIAL_RESOURCES | METHODOLOGY |
  /// PLANNING | SIGNATURE | OTHER — protégée par une contrainte CHECK (migration).
  category       String  @db.VarChar(30)
  label          String  @db.VarChar(300)
  expectedFormat String? @map("expected_format")
  isMandatory    Boolean @default(true) @map("is_mandatory")

  documentId        String? @map("document_id") @db.Uuid
  /// V2 Sprint 4 (audit Codex P1-004) — version EXACTE du document consolidé, capturée au moment
