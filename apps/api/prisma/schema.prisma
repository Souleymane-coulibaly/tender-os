// TenderOS — Prisma schema
//
// Modules implémentés : Identity, Authentication (bible/03-domain/domain-model.md,
// docs/04-architecture/DATABASE_DESIGN.md §5.1), Organizations (docs/04-architecture/DATABASE_DESIGN.md §5.2),
// Memberships (docs/04-architecture/DATABASE_DESIGN.md §5.3, §6, §21),
// Platform Administration (aucune documentation préexistante — table dédiée, distincte
// de Memberships, voir modules/platform-administration),
// Tenders (premier vertical slice "préparation de réponse" — statuts et périmètre propres
// à ce module, distincts du `tenders` de découverte documenté en §8.3 ; voir modules/tenders),
// Documents (gestion documentaire, versioning, associations Tender — voir modules/documents,
// docs/04-architecture/DOCUMENTS_MODULE.md ; fondation pour de futurs modules IA/Knowledge,
// aucune extraction/OCR/embedding implémentés ici).
// Aucun autre module métier (Invitations, IA, Billing, ...)
// n'est défini ici — voir skills/platform-foundation/DATABASE_PATTERNS.md avant d'en ajouter.
// Prisma reste confiné à la couche Infrastructure (skills/platform-foundation/ARCHITECTURE_RULES.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Identité humaine globale, indépendante de toute organisation
/// (docs/04-architecture/DATABASE_DESIGN.md §5.1 — "users").
/// L'appartenance à une organisation est gérée par le futur module Memberships.
model User {
  id    String @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par le Domain (value object EmailAddress) avant persistance —
  /// tient lieu d'unicité insensible à la casse sans dépendre de l'extension Postgres citext.
  email String @unique @db.VarChar(320)

  displayName String  @map("display_name") @db.VarChar(160)
  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)

  /// INVITED | ACTIVE | SUSPENDED | DEACTIVATED (docs/04-architecture/DATABASE_DESIGN.md §5.1)
  status String @db.VarChar(30)

  /// Authentification locale par mot de passe (hash scrypt, jamais le mot de passe en clair).
  /// La documentation autorise explicitement un fournisseur d'identité externe à la place —
  /// ce champ reste propre à ce mécanisme d'authentification, pas à l'identité elle-même.
  passwordHash String @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions              Session[]
  memberships           OrganizationMembership[]
  platformAdministrator PlatformAdministrator?
  clientAssignments     ClientAssignment[]
  /// V2 Sprint 7 — affectations à des Tenders en tant que participant du Workspace collaboratif.
  tenderParticipations  TenderParticipant[]

  @@map("users")
}

/// Session d'authentification server-side, référencée par le jeton d'accès émis
/// (bible/04-architecture/system-architecture.md §14 — IdentityProvider.revokeSession).
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Entreprise cliente de TenderOS, agrégat racine du tenant
/// (docs/04-architecture/DATABASE_DESIGN.md §5.2, bible/02-product/ubiquitous-language.md).
/// Ne porte pas de organizationId — c'est elle-même la frontière d'isolation multi-tenant.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(200)

  /// Unique — sert de clé métier lisible (URLs, sous-domaines).
  slug String @unique @db.VarChar(120)

  legalName          String? @map("legal_name") @db.VarChar(240)
  registrationNumber String? @map("registration_number") @db.VarChar(100)
  countryCode        String? @map("country_code") @db.Char(2)

  defaultCurrency String @default("EUR") @map("default_currency") @db.Char(3)
  defaultTimezone String @map("default_timezone") @db.VarChar(80)

  /// TRIAL | ACTIVE | SUSPENDED | CLOSED (docs/04-architecture/DATABASE_DESIGN.md §5.2)
  status String @db.VarChar(30)

  settings Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships          OrganizationMembership[]
  tenders              Tender[]
  documents            Document[]
  auditLogs            AuditLog[]
  knowledgeSpaces      KnowledgeSpace[]
  clientAccounts       ClientAccount[]
  benchmarkRuns        BenchmarkRun[]
  modelRecommendations ModelRecommendation[]
  routingPolicies      RoutingPolicy[]
  routingDecisions     RoutingDecision[]
  promptTemplates      PromptTemplate[]
  opportunities        Opportunity[]

  @@map("organizations")
}

/// Relie un utilisateur à une organisation (docs/04-architecture/DATABASE_DESIGN.md §5.3).
/// Pas de deletedAt : le retrait est une transition de statut vers REMOVED, pas un soft delete —
/// la contrainte UNIQUE(organizationId, userId) s'applique donc à toutes les lignes, y compris REMOVED
/// (empêche explicitement les doublons d'appartenance, y compris après un retrait).
model OrganizationMembership {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// INVITED | ACTIVE | SUSPENDED | EXPIRED | REMOVED (docs/04-architecture/DATABASE_DESIGN.md §5.3)
  status String @db.VarChar(30)

  joinedAt    DateTime? @map("joined_at")
  suspendedAt DateTime? @map("suspended_at")
  /// Accès limité dans le temps (bible/03-domain/permissions.md §22, External Consultant) —
  /// vérifié à la lecture, aucun job planifié ne fait transiter le statut vers EXPIRED dans cette tranche.
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_memberships")
}

/// Rôle attribuable à une Membership — uniquement des rôles système dans cette tranche
/// (organizationId toujours nul ; les rôles personnalisés par organisation ne sont pas implémentés).
model Role {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid
  code           String  @db.VarChar(100)
  name           String  @db.VarChar(160)

  /// ORGANIZATION | WORKSPACE (docs/04-architecture/DATABASE_DESIGN.md §6.1) — seul ORGANIZATION est utilisé ici.
  scope    String  @db.VarChar(30)
  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([code])
  @@map("roles")
}

/// Catalogue des permissions, notation `resource:action` (bible/03-domain/permissions.md §6).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(160)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Relie une Membership à un rôle d'organisation (docs/04-architecture/DATABASE_DESIGN.md §6.4).
/// Le Domain impose qu'une Membership n'ait jamais plus d'un rôle actif à la fois dans cette tranche
/// ("modifier LE rôle d'un membre") — la table reste générique pour rester compatible avec une évolution future.
model MembershipRole {
  membershipId String                 @map("membership_id") @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// Journal d'audit append-only (docs/04-architecture/DATABASE_DESIGN.md §21.1, BR-GEN-002).
/// Sous-ensemble des colonnes documentées : ipAddress/userAgent/traceId omis, aucune source fiable
/// n'étant disponible dans les use cases actuels sans étendre le contexte de requête (hors périmètre Memberships).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorType    String  @map("actor_type") @db.VarChar(30)
  actorId      String? @map("actor_id") @db.Uuid
  action       String  @db.VarChar(160)
  resourceType String  @map("resource_type") @db.VarChar(100)
  resourceId   String? @map("resource_id") @db.Uuid
  result       String  @db.VarChar(30)
  reasonCode   String? @map("reason_code") @db.VarChar(100)
  requestId    String? @map("request_id") @db.VarChar(120)
  metadata     Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// Identité d'administration plateforme — distincte de Memberships/roles d'organisation
/// (mission Platform Administration : "N'ajoute pas ces rôles dans Memberships"). Un OWNER
/// ou ADMIN d'une organisation cliente n'obtient jamais automatiquement d'accès ici : cette
/// table est la seule source d'autorisation pour le back-office plateforme.
model PlatformAdministrator {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// PLATFORM_OWNER | PLATFORM_ADMIN | PLATFORM_SUPPORT (aucun rôle plateforme documenté —
  /// ensemble minimal proposé et validé lors de cette mission).
  role String @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_administrators")
}

/// Appel d'offres — "premier vertical slice" de préparation de réponse (mission Tenders).
/// Statuts et champs distincts du `tenders` de découverte documenté en §8.3 (module Discovery/
/// Qualification non implémenté) — voir commentaire d'en-tête de ce fichier.
/// Toutes les références utilisateur (createdBy, internalOwnerId, ...) restent de simples uuid
/// sans relation Prisma vers User, à l'image de `AuditLog.actorId` déjà dans ce schéma.
model Tender {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// Client géré par l'organisation propriétaire de ce Tender (mission Sprint 5.1) — obligatoire
  /// depuis ce sprint ; les Tenders créés avant cette tranche ont été rattachés au client par
  /// défaut de leur organisation lors du backfill de migration (jamais modifié rétroactivement
  /// une fois la migration terminée). Jamais de cascade : un ClientAccount qui porte encore des
  /// Tenders ne peut pas être supprimé (voir DeleteClientAccountUseCase).
  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  title       String  @db.VarChar(500)
  reference   String? @db.VarChar(255)
  buyerName   String? @map("buyer_name") @db.VarChar(300)
  description String?

  publicationDate    DateTime? @map("publication_date")
  submissionDeadline DateTime? @map("submission_deadline")

  procedureType String? @map("procedure_type") @db.VarChar(80)

  /// PUBLIC | PRIVATE (domain/market-type.ts) — nature du marché, distincte de `source` ci-dessous.
  marketType String? @default("PUBLIC") @map("market_type") @db.VarChar(80)

  /// FR | BE | DE | ES | IT | LU | NL | EU | OTHER (domain/tender-country.ts) — préparation
  /// internationale (mission architecture §12), sans logique métier par pays branchée dessus.
  country String? @default("FR") @db.VarChar(10)

  /// fr | en | de | es | it | nl (domain/tender-language.ts).
  language String? @default("fr") @db.VarChar(10)

  /// MANUAL | BOAMP | TED | PRIVATE | OTHER (domain/tender-source.ts) — provenance du Tender ;
  /// aucun connecteur BOAMP/TED réel n'existe dans cette tranche (mission architecture §6).
  source String? @default("MANUAL") @db.VarChar(20)

  /// Identifiant du marché dans le système source (BOAMP/TED/plateforme privée) — jamais utilisé
  /// en clé de jointure applicative, purement informatif tant qu'aucun connecteur n'existe.
  externalReference String? @map("external_reference") @db.VarChar(255)
  sourceUrl         String? @map("source_url") @db.VarChar(2048)

  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @default("EUR") @db.Char(3)
  /// V2 Sprint 3 §6 — montant plancher/plafond quand le marché en prévoit (accord-cadre à bons de
  /// commande notamment), distincts de `estimatedAmount` (valeur ponctuelle unique).
  minimumAmount   Decimal? @map("minimum_amount") @db.Decimal(19, 4)
  maximumAmount   Decimal? @map("maximum_amount") @db.Decimal(19, 4)

  internalOwnerId String? @map("internal_owner_id") @db.Uuid

  /// DRAFT | IN_ANALYSIS | READY | IN_PREPARATION | READY_TO_SUBMIT | SUBMITTED | WON | LOST | ARCHIVED
  status String @db.VarChar(40)

  /// V2 Sprint 3 §5 — acheteur/donneur d'ordre structuré, distinct de l'entreprise candidate
  /// (`clientAccountId` ci-dessus) et de `buyerName` (conservé pour compatibilité V1 : simple
  /// libellé texte). `Buyer` n'existait pas avant ce sprint (audit préalable confirmé) — jamais
  /// un `ClientAccount`, jamais fusionné avec les données du candidat.
  buyerId String? @map("buyer_id") @db.Uuid
  buyer   Buyer?  @relation(fields: [buyerId, organizationId], references: [id, organizationId])

  /// V2 Sprint 3 §6 — dates/échéances au-delà de `submissionDeadline` (déjà existant). Le fuseau
  /// horaire s'applique à `submissionDeadline` (stocké en UTC) pour un affichage local correct ;
  /// la question et la visite restent également modélisables comme `TenderMilestone` typés
  /// (QUESTION_DEADLINE/MANDATORY_VISIT) pour l'historique/les jalons — ces deux colonnes servent
  /// uniquement à l'affichage rapide de la fiche sans devoir agréger les jalons.
  submissionDeadlineTimezone String?   @default("Europe/Paris") @map("submission_deadline_timezone") @db.VarChar(60)
  questionsDeadline          DateTime? @map("questions_deadline")
  visitDate                  DateTime? @map("visit_date")
  visitMandatory             Boolean?  @map("visit_mandatory")

  /// V2 Sprint 3 §6 — durée et démarrage.
  contractDurationMonths Int?      @map("contract_duration_months")
  renewalDurationMonths  Int?      @map("renewal_duration_months")
  renewalCount           Int?      @map("renewal_count")
  estimatedStartDate     DateTime? @map("estimated_start_date")

  /// V2 Sprint 3 §6 — lieu d'exécution.
  executionLocation String? @map("execution_location") @db.VarChar(300)
  geographicZone    String? @map("geographic_zone") @db.VarChar(300)

  /// V2 Sprint 3 §6 — caractéristiques de la procédure. `awardType` : MONO_AWARDEE | MULTI_AWARDEE
  /// (CHECK, migration) — nullable tant que l'information n'est pas connue.
  isFrameworkAgreement        Boolean? @map("is_framework_agreement")
  awardType                   String?  @map("award_type") @db.VarChar(20)
  variantsAllowed             Boolean? @map("variants_allowed")
  pseAllowed                  Boolean? @map("pse_allowed")
  electronicResponseMandatory Boolean? @map("electronic_response_mandatory")
  signatureRequired           Boolean? @map("signature_required")
  submissionPlatformUrl       String?  @map("submission_platform_url") @db.VarChar(2048)
  internalNotes               String?  @map("internal_notes")

  tags String[]

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  archivedAt DateTime? @map("archived_at")

  /// Concurrence optimiste (docs/04-architecture/DATABASE_DESIGN.md §23 — Tender y figure explicitement).
  version Int @default(1)

  lots                       TenderLot[]
  checklistItems             TenderChecklistItem[]
  awardCriteria              TenderAwardCriterion[]
  requestedDocuments         TenderRequestedDocument[]
  milestones                 TenderMilestone[]
  risks                      TenderRisk[]
  alerts                     TenderAlert[]
  participants               TenderParticipant[]
  tasks                      Task[]
  comments                   Comment[]
  approvalRequests           ApprovalRequest[]
  activities                 TenderActivity[]
  statusHistory              TenderStatusHistoryEntry[]
  documentAssociations       DocumentTenderAssociation[]
  dces                       Dce[]
  dceImportJobs              DceImportJob[]
  analysisJobs               AnalysisJob[]
  documentBusinessAnalyses   DocumentBusinessAnalysis[]
  deadlineFindings           TenderDeadlineFinding[]
  criterionFindings          TenderCriterionFinding[]
  requirementFindings        TenderRequirementFinding[]
  clauseFindings             TenderClauseFinding[]
  riskFindings               TenderRiskFinding[]
  questionFindings           TenderQuestionFinding[]
  analysisSummaries          TenderAnalysisSummary[]
  generations                Generation[]
  pricingEstimates           PricingEstimate[]
  exportJobs                 ExportJob[]
  validationRuns             ValidationRun[]
  finalApprovals             FinalApproval[]
  signatureRequirements      SignatureRequirement[]
  signatories                Signatory[]
  signatureTransactions      SignatureTransaction[]
  submissionPackages         SubmissionPackage[]
  deliverables               Deliverable[]
  deliverableTemplates       DeliverableTemplate[]
  documentThemes             DocumentTheme[]
  technicalMemos             TechnicalMemo[]
  pricingSchedules           PricingSchedule[]
  responsePackages           ResponsePackage[]
  generatedDocuments         GeneratedDocument[]
  administrativeDossiers     AdministrativeDossier[]
  administrativeRequirements AdministrativeRequirement[]
  administrativeDocuments    AdministrativeDocument[]
  consortiums                Consortium[]
  dc1Declarations            Dc1Declaration[]
  dc2Declarations            Dc2Declaration[]
  dumeDeclarations           DumeDeclaration[]
  subcontractorDeclarations  SubcontractorDeclaration[]
  engagementActs             EngagementAct[]
  signingPowers              SigningPower[]
  administrativeFormDrafts   AdministrativeFormDraft[]
  buyerProvidedFormTemplates BuyerProvidedFormTemplate[]
  tenderSubmissions          TenderSubmission[]
  /// V2 Sprint 4 — suggestions IA rattachées à ce Tender (racine tenantée, jamais l'entité cible
  /// polymorphe elle-même) et révisions utilisateur de sa synthèse IA.
  aiSuggestions              AiSuggestion[]
  analysisSummaryRevisions   TenderAnalysisSummaryRevision[]
  /// V2 Sprint 5 — au plus une Opportunity promue vers ce Tender (voir `Opportunity.tenderId`,
  /// `@@unique([tenderId, organizationId])` côté Opportunity).
  opportunity                Opportunity?
  goNoGoReports              GoNoGoReport[]
  goNoGoDecisions            GoNoGoDecision[]
  /// V2 Sprint 9 (Chat IA conversationnel) — une Conversation appartient toujours à EXACTEMENT UN
  /// Tender, jamais réaffectable (voir `Conversation.tenderId`, immuable après création).
  conversations              Conversation[]

  /// AUDIT-007 : contrainte composite support de la FK composée de TenderLot ci-dessous — garantit
  /// au niveau base de données qu'un TenderLot ne peut jamais référencer un couple
  /// (tenderId, organizationId) incohérent avec le Tender réel (organizationId dénormalisé).
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, submissionDeadline])
  @@index([organizationId, createdAt])
  /// Filtre "responsable" (mission Kanban & List Views §8) — déjà exposé par l'API sans
  /// index dédié jusqu'ici.
  @@index([organizationId, internalOwnerId])
  /// Tri "dernière modification" de la vue Liste (mission Kanban & List Views §5, §8).
  @@index([organizationId, updatedAt])
  /// Filtre "client" (mission Sprint 5.1 §"filtre client") — liste des Tenders d'un client donné.
  @@index([organizationId, clientAccountId])
  @@map("tenders")
}

/// V2 Sprint 3 §5 — acheteur/donneur d'ordre. Audit préalable confirmé : aucune entité Buyer
/// n'existait (seul `Tender.buyerName`, simple libellé texte, conservé pour compatibilité V1).
/// Jamais un `ClientAccount` : les données de l'acheteur ne portent aucune permission Client
/// Portfolio, aucune donnée légale/bancaire, jamais utilisées comme données du candidat (mission
/// §5 "ne jamais utiliser les données de l'acheteur comme données du candidat"). Réutilisable par
/// plusieurs Tenders de la même organisation (mission §5 "éviter la duplication si l'acheteur est
/// réutilisable") — jamais recréé automatiquement, jamais rempli depuis une extraction DCE ce
/// sprint.
model Buyer {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name       String  @db.VarChar(300)
  legalName  String? @map("legal_name") @db.VarChar(300)
  identifier String? @db.VarChar(100)
  /// SIRET si connu — jamais inventé (mission §5 "ne pas inventer de SIRET"), aucune validation
  /// de checksum imposée côté acheteur (contrairement à `company-profile`) : donnée déclarative
  /// tierce, potentiellement incomplète.
  siret      String? @db.VarChar(14)

  addressLine String? @map("address_line") @db.VarChar(300)
  postalCode  String? @map("postal_code") @db.VarChar(20)
  city        String? @db.VarChar(120)
  country     String? @db.VarChar(10)

  /// Libre (ex. "Collectivité territoriale", "État", "Établissement public") — aucun catalogue
  /// fermé documenté par la mission, mêmes précédents que `Tender.procedureType`.
  buyerType String? @map("buyer_type") @db.VarChar(120)

  contactName  String? @map("contact_name") @db.VarChar(200)
  contactEmail String? @map("contact_email") @db.VarChar(320)
  contactPhone String? @map("contact_phone") @db.VarChar(40)

  /// URL du profil acheteur générique (réutilisable), distincte de `Tender.sourceUrl`/
  /// `Tender.submissionPlatformUrl` qui restent spécifiques à CHAQUE consultation.
  profileUrl String? @map("profile_url") @db.VarChar(2048)

  notes String?

  createdBy  String    @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenders       Tender[]
  /// V2 Sprint 5 — Opportunities référençant cet acheteur avant même la création d'un Tender.
  opportunities Opportunity[]

  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@map("buyers")
}

model TenderLot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  /// AUDIT-007 : FK composée (tenderId, organizationId) → Tender(id, organizationId) plutôt
  /// qu'une simple FK sur tenderId — empêche à la racine (contrainte Postgres, jamais contournable
  /// par un bug applicatif ou un accès direct à la base) qu'un lot porte un organizationId
  /// différent de celui du Tender qu'il référence. Voir §K du rapport d'implémentation pour les
  /// alternatives écartées.
  tender         Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  lotNumber       String   @map("lot_number") @db.VarChar(80)
  title           String   @db.VarChar(500)
  description     String?
  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @db.Char(3)
  displayOrder    Int      @default(0) @map("display_order")

  /// V2 Sprint 3 §8 — enrichissement additif (audit préalable : aucun de ces champs n'existait).
  /// Pas de colonne `status` distincte : `deletedAt` porte déjà l'archivage/la restauration
  /// (mission "ne pas dupliquer"), `selectedForResponse` porte la seule décision métier
  /// actionnable manquante ("lot sélectionné ou non pour réponse").
  code                  String?   @db.VarChar(100)
  cpvMain               String?   @map("cpv_main") @db.VarChar(20)
  cpvSecondary          String[]  @map("cpv_secondary")
  executionLocation     String?   @map("execution_location") @db.VarChar(300)
  durationMonths        Int?      @map("duration_months")
  estimatedStartDate    DateTime? @map("estimated_start_date")
  minimumAmount         Decimal?  @map("minimum_amount") @db.Decimal(19, 4)
  maximumAmount         Decimal?  @map("maximum_amount") @db.Decimal(19, 4)
  selectedForResponse   Boolean   @default(true) @map("selected_for_response")
  /// Mission §13 : l'architecture ne doit pas empêcher les futurs besoins de groupement — ces deux
  /// indicateurs déclaratifs suffisent ce sprint, aucun Consortium/DC4 rattaché ici.
  soloAllowed           Boolean   @default(true) @map("solo_allowed")
  groupAllowed          Boolean   @default(true) @map("group_allowed")
  variantsAllowed       Boolean?  @map("variants_allowed")
  pseAllowed            Boolean?  @map("pse_allowed")
  specificVisitRequired Boolean?  @map("specific_visit_required")
  specificVisitDate     DateTime? @map("specific_visit_date")
  internalNotes         String?   @map("internal_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Suppression logique (conception Lots §D) — un lot supprimé reste soumis à la contrainte
  /// d'unicité ci-dessous : son numéro n'est jamais libéré, ce qui rend RestoreTenderLot
  /// toujours sûr (jamais de collision possible avec un lot créé entretemps).
  deletedAt DateTime? @map("deleted_at")

  awardCriteria      TenderAwardCriterion[]
  requestedDocuments TenderRequestedDocument[]
  milestones         TenderMilestone[]
  risks              TenderRisk[]
  /// V2 Sprint 4 — suggestions IA ciblant spécifiquement ce lot (ex. critère/pièce/jalon proposé
  /// pour ce lot précis), distinct des suggestions au niveau Tender global (parentLotId absent).
  aiSuggestions      AiSuggestion[]
  /// V2 Sprint 6 — items de checklist spécifiques à ce lot (lotId absent = exigence Tender globale).
  checklistItems     TenderChecklistItem[]
  /// V2 Sprint 7 — tâches spécifiques à ce lot (lotId absent = tâche Tender globale).
  tasks              Task[]

  /// V2 Sprint 3 (AUDIT-007, même motif que Tender/Document) — support des FK composées
  /// (lotId, organizationId) des satellites ci-dessous vers ce lot : empêche structurellement
  /// qu'un critère/document/jalon/risque d'une autre organisation référence ce lot.
  @@unique([id, organizationId])
  /// V2 Sprint 4 (audit Codex P1-003) — clé composite à 3 colonnes dédiée à AiSuggestion.parentLot :
  /// garantit qu'un lot cible appartient bien au Tender déclaré (parentTenderId), jamais seulement
  /// à la même organisation.
  @@unique([id, organizationId, tenderId])
  @@unique([tenderId, lotNumber])
  @@index([organizationId, tenderId])
  @@index([organizationId, tenderId, displayOrder])
  @@map("tender_lots")
}

model TenderChecklistItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(300)
  description String?
  required    Boolean @default(false)

  /// TODO | IN_PROGRESS | COMPLETED | NOT_APPLICABLE — statut historique (V1), consommé par
  /// `readiness-calculator.ts` (35% du score de readiness). V2 Sprint 6 : dérivé automatiquement
  /// de `complianceStatus` par le domaine (`deriveLegacyStatus`), jamais assigné directement par un
  /// appelant — voir le commentaire de `complianceStatus` ci-dessous.
  status String @db.VarChar(30)

  assignedTo String?   @map("assigned_to") @db.Uuid
  dueDate    DateTime? @map("due_date")
  comment    String?

  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") @db.Uuid

  displayOrder Int @default(0) @map("display_order")

  /// V2 Sprint 6 §5 — catalogue gouverné du type d'élément de checklist. ADMINISTRATIVE_DOCUMENT |
  /// TECHNICAL_DOCUMENT | FINANCIAL_DOCUMENT | CERTIFICATION | INSURANCE | DECLARATION | FORM |
  /// SIGNATURE | VISIT | REFERENCE | TECHNICAL_REQUIREMENT | FINANCIAL_REQUIREMENT | DEADLINE |
  /// DELIVERABLE | OTHER — CHECK (migration).
  type String @default("OTHER") @db.VarChar(30)

  /// V2 Sprint 6 §6 — MANDATORY | CONDITIONAL | INFORMATIONAL — CHECK (migration). `conditionText`
  /// n'a de sens que si CONDITIONAL ; jamais validé en base (règle métier, pas une contrainte SQL).
  requirementLevel String  @default("MANDATORY") @map("requirement_level") @db.VarChar(15)
  conditionText    String? @map("condition_text")

  /// V2 Sprint 6 §7 — BLOCKING | HIGH | MEDIUM | LOW — CHECK (migration). Toujours corrigible par
  /// l'utilisateur, même si proposée par l'IA (mission : jamais une invalidation juridique
  /// automatique).
  criticality String @default("MEDIUM") @db.VarChar(10)

  /// V2 Sprint 6 §8 — statut métier PRIMAIRE, distinct du statut documentaire ci-dessous (un
  /// document disponible n'est pas forcément conforme). TO_REVIEW | NON_COMPLIANT | READY |
  /// VALIDATED | NOT_APPLICABLE — CHECK (migration). Seul un passage explicite à VALIDATED ou
  /// NOT_APPLICABLE dérive `status = COMPLETED`/`NOT_APPLICABLE` pour le calcul de readiness —
  /// jamais un simple document rapproché (`READY`) non validé par un humain.
  complianceStatus String @default("TO_REVIEW") @map("compliance_status") @db.VarChar(15)

  /// V2 Sprint 6 §8/§18 — MISSING | AVAILABLE | EXPIRED — CHECK (migration). Ne reflète que la
  /// disponibilité/validité du document rapproché, jamais la conformité métier (`complianceStatus`
  /// ci-dessus). Une expiration inconnue reste `AVAILABLE`, jamais inventée en `EXPIRED`.
  documentStatus String @default("MISSING") @map("document_status") @db.VarChar(10)

  /// V2 Sprint 6 §21 — MANUAL | AI_SUGGESTION | SYSTEM — CHECK (migration). Distingue une création
  /// manuelle d'une création issue d'une AiSuggestion acceptée/modifiée.
  origin String @default("MANUAL") @db.VarChar(15)

  /// V2 Sprint 6 §13-15 — sujet concerné par l'exigence, jamais une entreprise inventée. CANDIDATE |
  /// GROUP_MEMBER | SUBCONTRACTOR | ANY_MEMBER | TENDER | LOT — CHECK (migration).
  /// `subjectSubcontractorProfileId` : pointeur dénormalisé (jamais de FK stricte, même motif que
  /// les `documentId` de company-profile/subcontractors) vers un sous-traitant du répertoire
  /// EXPLICITEMENT rattaché après validation humaine — jamais auto-rempli.
  subjectType                   String  @default("CANDIDATE") @map("subject_type") @db.VarChar(15)
  subjectSubcontractorProfileId String? @map("subject_subcontractor_profile_id") @db.Uuid

  /// V2 Sprint 6 §12 — même motif que `TenderRequestedDocument.lotId` (FK composée AUDIT-007).
  /// `null` = exigence Tender globale.
  lotId String?    @map("lot_id") @db.Uuid
  lot   TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])

  /// V2 Sprint 6 §16-18 — rapprochement documentaire. FK réelle vers `Document` (même motif que
  /// `TenderRequestedDocument.documentId`, module `tenders` déjà consommateur direct de `documents`)
  /// ; `matchedDocumentVersionId` reste dénormalisé (aucun modèle de ce dépôt ne FK jamais
  /// `DocumentVersion` — toujours une version précise, jamais "latest" implicite).
  /// `documentMatchStatus` : NOT_SEARCHED | EXACT_MATCH | PROBABLE_MATCH | MULTIPLE_CANDIDATES |
  /// NO_MATCH | MANUALLY_ATTACHED — CHECK (migration). `documentExpiresAt` copié depuis le
  /// satellite ayant produit le match (CompanyCertification/CompanyInsurance/équivalent
  /// sous-traitant), jamais inventé.
  matchedDocumentId         String?   @map("matched_document_id") @db.Uuid
  matchedDocument           Document? @relation(fields: [matchedDocumentId], references: [id])
  matchedDocumentVersionId  String?   @map("matched_document_version_id") @db.Uuid
  documentMatchStatus       String    @default("NOT_SEARCHED") @map("document_match_status") @db.VarChar(20)
  documentMatchScore        Float?    @map("document_match_score")
  documentMatchReasons      Json?     @map("document_match_reasons")
  documentExpiresAt         DateTime? @map("document_expires_at")
  documentValidityCheckedAt DateTime? @map("document_validity_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// V2 Sprint 6 §11 — provenances multiples (RC p.12 + CCAP p.7 pour la même exigence) : jamais
  /// une source supprimée, seulement ajoutée.
  sources TenderChecklistItemSource[]
  /// V2 Sprint 7 §13-14 — tâches nées de ce ChecklistItem (mission : toujours indépendantes une
  /// fois créées, `Task DONE` ≠ `ChecklistItem VALIDATED`).
  tasks   Task[]

  @@index([organizationId, tenderId, displayOrder])
  @@index([organizationId, tenderId, lotId])
  @@index([organizationId, tenderId, complianceStatus])
  @@map("tender_checklist_items")
}

/// V2 Sprint 6 §11 — provenance(s) d'un ChecklistItem, jamais fusionnées/supprimées. Une création
/// (manuelle ou IA) écrit toujours exactement une ligne ; la déduplication en ajoute d'autres sur
/// un item existant plutôt que de créer un second ChecklistItem.
model TenderChecklistItemSource {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  checklistItemId String              @map("checklist_item_id") @db.Uuid
  checklistItem   TenderChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  /// REQUIREMENT | CRITERION | DEADLINE — CHECK (migration). `null` pour une provenance MANUAL.
  findingType String? @map("finding_type") @db.VarChar(15)
  findingId   String? @map("finding_id") @db.Uuid

  /// Dénormalisé — voir `AiSuggestion.entityId` pour la traçabilité inverse complète
  /// (GET /ai-suggestions?entityType=CHECKLIST_ITEM&entityId=...), jamais une seconde source de
  /// vérité pour ce lien.
  sourceSuggestionId String? @map("source_suggestion_id") @db.Uuid

  documentId        String? @map("document_id") @db.Uuid
  documentVersionId String? @map("document_version_id") @db.Uuid
  analysisVersion   Int?    @map("analysis_version")
  pageStart         Int?    @map("page_start")
  citation          String?
  sectionTitle      String? @map("section_title")
  confidence        Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, checklistItemId])
  @@map("tender_checklist_item_sources")
}

/// V2 Sprint 7 (Workspace collaboratif) §7 — utilisateur explicitement affecté à ce Tender. Source
/// UNIQUE de vérité pour "qui peut être assigné/mentionné/reviewer sur ce Tender" (jamais une
/// re-dérivation complète organisation+client à chaque assignation ailleurs) : ajouter un
/// participant est le SEUL endroit où l'appartenance organisation active ET l'accès à l'entreprise
/// candidate du Tender sont vérifiés (voir `AddTenderParticipantUseCase`). Retrait toujours "soft"
/// (`removedAt`, jamais de suppression physique — mission §49/§50), l'historique (tâches,
/// commentaires, activité) reste intact et attribuable après retrait. Unicité RÉELLE du participant
/// ACTIF assurée par un index partiel `WHERE removed_at IS NULL` (ajouté à la main dans la
/// migration — non exprimable dans le DSL Prisma), pour permettre un retrait PUIS un ré-ajout sans
/// violer une contrainte unique classique.
model TenderParticipant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// TENDER_MANAGER | ADMINISTRATIVE_RESPONSIBLE | TECHNICAL_WRITER | FINANCIAL_RESPONSIBLE |
  /// REVIEWER | SIGNATORY | VIEWER — CHECK (migration). Décrit la FONCTION du participant dans
  /// l'équipe, jamais une autorité de validation (celle-ci reste entièrement dérivée de
  /// `ClientPermission.ValidateWorkspace`, mission §41 — voir `workspace-authorization.policy.ts`).
  /// Distinct du "responsable du dossier" (`Tender.internalOwnerId`, déjà existant depuis Sprint 3,
  /// réutilisé tel quel pour mission §9 — jamais recréé ici).
  role String @db.VarChar(30)

  addedBy   String    @map("added_by") @db.Uuid
  addedAt   DateTime  @default(now()) @map("added_at")
  removedBy String?   @map("removed_by") @db.Uuid
  removedAt DateTime? @map("removed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId])
  @@index([organizationId, userId])
  @@map("tender_participants")
}

/// V2 Sprint 7 §10-17 — travail interne collaboratif, distinct d'un `TenderChecklistItem` (constat
/// de conformité DCE) et d'un `TenderMilestone` (échéance métier datée) — jamais fusionnés (mission
/// §13/§15). `assigneeId` reste un pointeur dénormalisé (même motif que
/// `TenderMilestone.responsibleUserId`/`TenderChecklistItem.assignedTo`, jamais de FK stricte) —
/// validé applicativement contre un `TenderParticipant` ACTIF, jamais contre un simple UUID
/// syntaxique (mission §17).
model Task {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// Même motif FK composée (AUDIT-007) que tout le reste du dépôt depuis Sprint 3 — `null` =
  /// tâche Tender globale.
  lotId String?    @map("lot_id") @db.Uuid
  lot   TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])

  /// Mission §13-14 — une tâche PEUT naître d'un ChecklistItem ("cette pièce est manquante" →
  /// "Karim doit la récupérer avant vendredi") mais reste TOUJOURS indépendante ensuite : `Task
  /// DONE` ≠ `ChecklistItem VALIDATED` (mission §13, règle absolue).
  checklistItemId String?              @map("checklist_item_id") @db.Uuid
  checklistItem   TenderChecklistItem? @relation(fields: [checklistItemId], references: [id])

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id])

  title       String  @db.VarChar(300)
  description String?

  /// TODO | IN_PROGRESS | BLOCKED | IN_REVIEW | DONE | CANCELLED — CHECK (migration). Transitions
  /// contrôlées côté application (`task.entity.ts`) ; toute transition change de statut est tracée
  /// via `AuditLog.metadata` (previousStatus/newStatus, même motif que
  /// `tender.checklist_criticality_changed` du Sprint 6 — pas de table d'historique dédiée).
  status String @default("TODO") @db.VarChar(20)

  /// LOW | MEDIUM | HIGH | URGENT — CHECK (migration). Distincte de `ChecklistItem.criticality`
  /// (mission §12) : une pièce BLOCKING peut suggérer une priorité HIGH/URGENT à la création
  /// depuis la checklist, jamais recopiée automatiquement — l'utilisateur confirme toujours
  /// (mission §14).
  priority String @default("MEDIUM") @db.VarChar(10)

  dueDate DateTime? @map("due_date")

  assigneeId String? @map("assignee_id") @db.Uuid

  createdBy   String    @map("created_by") @db.Uuid
  completedBy String?   @map("completed_by") @db.Uuid
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, lotId])
  @@map("tasks")
}

/// V2 Sprint 7 §19-21 — modèle générique GOUVERNÉ (mission §19 : "préférer un modèle générique
/// plutôt que trois systèmes de commentaires... éviter un polymorphisme non sécurisé"), même motif
/// déjà éprouvé dans ce dépôt par `AiSuggestion.entityType`/`entityId` : `entityId` reste un
/// pointeur dénormalisé SANS FK stricte (le type de la cible varie), résolu et vérifié
/// applicativement par `entityType` avant toute écriture — jamais un `findUnique({id})` nu (mission
/// §20). `tenderId` est TOUJOURS renseigné, y compris pour un commentaire sur une Task/un
/// ChecklistItem (le Tender parent est toujours connu à l'écriture) : permet une vérification
/// d'accès en un seul niveau (`assertTenderParticipantAccess`) sans jamais résoudre l'entité cible
/// au préalable pour découvrir son Tender.
model Comment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// TENDER | TASK | CHECKLIST_ITEM | LOT — CHECK (migration). V2 Sprint 18 (mission §7) ajoute
  /// LOT. TechnicalMemo section / Pricing version / ResponsePackage restent hors périmètre
  /// (résolveur cross-module non trivial, voir rapport Sprint 18 "éléments différés"). Jamais
  /// DOCUMENT (mission §19, réduction de périmètre assumée dès Sprint 7).
  entityType String @map("entity_type") @db.VarChar(20)
  entityId   String @map("entity_id") @db.Uuid

  authorId String @map("author_id") @db.Uuid
  body     String

  createdAt DateTime  @default(now()) @map("created_at")
  /// Horodatage de dernière édition — l'auteur peut modifier son propre commentaire (mission §21),
  /// jamais une réécriture silencieuse de l'historique.
  editedAt  DateTime? @map("edited_at")
  /// Suppression douce (mission §21 "préférer soft delete à suppression physique") — jamais
  /// réutilisé pour une édition normale.
  deletedAt DateTime? @map("deleted_at")

  mentions Mention[]

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, tenderId, createdAt])
  @@map("comments")
}

/// V2 Sprint 7 §22-23 — référence un utilisateur RÉEL (mission §22 : "ne pas stocker uniquement
/// '@Jean' comme texte"), toujours validé contre un `TenderParticipant` actif du MÊME Tender que le
/// commentaire avant toute écriture (mission §23 — jamais un utilisateur sans accès mentionné,
/// même en autocomplete frontend).
model Mention {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  commentId String  @map("comment_id") @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  mentionedUserId String @map("mentioned_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, mentionedUserId])
  @@index([commentId])
  @@map("mentions")
}

/// V2 Sprint 7 §26-30 — validation collaborative INTERNE ("cette personne a validé cette étape de
/// travail"), jamais une signature juridique/un engagement contractuel/une validation officielle de
/// l'offre (mission §28, règle absolue — ne jamais confondre avec la future signature
/// électronique). Scope initialement restreint à `entityType: TASK | CHECKLIST_ITEM`. V2 Sprint 18
/// (mission §24-31, décision AskUserQuestion) étend `entityType` à trois cibles immuables
/// supplémentaires (TECHNICAL_MEMO_SECTION_REVISION/PRICING_SCHEDULE_VERSION/RESPONSE_PACKAGE_VERSION)
/// plutôt que de retrofiter `FinalApproval` (couplé à `ExportJob`/`ValidationRun`, pipeline
/// Tender-only déjà écarté par Sprint 14 lui-même) ou de créer un second mécanisme.
model ApprovalRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  /// TASK | CHECKLIST_ITEM | TECHNICAL_MEMO_SECTION_REVISION | PRICING_SCHEDULE_VERSION |
  /// RESPONSE_PACKAGE_VERSION — CHECK (migration). Même motif dénormalisé que `Comment.entityId`.
  /// Pour les trois cibles documentaires, `entityId` référence une ligne DÉJÀ immuable (une
  /// révision mémoire technique, ou une version Pricing/ResponsePackage déjà VALIDATED au moment de
  /// la demande) — jamais "latest" (mission §25, "point critique").
  entityType String @map("entity_type") @db.VarChar(40)
  entityId   String @map("entity_id") @db.Uuid

  requestedBy String @map("requested_by") @db.Uuid
  /// Doit être un `TenderParticipant` actif ET disposer de la permission `Validate*` propre à
  /// `entityType` (`ValidateWorkspace`/`ValidateTechnicalMemo`/`ValidatePricingSchedule`/
  /// `ValidateResponsePackage`, mission §29/§31) — jamais un simple CONTRIBUTOR. Auto-validation
  /// (`requestedBy === reviewerId`) interdite par défaut (mission §30).
  reviewerId  String @map("reviewer_id") @db.Uuid

  /// PENDING | APPROVED | CHANGES_REQUESTED | REJECTED | CANCELLED — CHECK (migration). REJECTED
  /// ajouté au Sprint 18 (mission §27/§34, décision AskUserQuestion) : refus définitif avec raison
  /// obligatoire, distinct de CHANGES_REQUESTED ("à corriger").
  status String @default("PENDING") @db.VarChar(20)

  comment String?

  requestedAt DateTime  @default(now()) @map("requested_at")
  reviewedAt  DateTime? @map("reviewed_at")

  @@index([organizationId, tenderId, status])
  @@index([organizationId, reviewerId])
  @@map("approval_requests")
}

/// V2 Sprint 7 §31-33/§51 — projection de lecture destinée à l'utilisateur, JAMAIS l'AuditLog
/// technique exposé directement (mission §32 : "AuditLog : sécurité/traçabilité. Activity Feed :
/// compréhension utilisateur"). Peuplée par un helper partagé, dans la MÊME transaction applicative
/// que l'écriture principale + AuditLog + Outbox de chaque use case collaboratif (jamais un second
/// système de vérité indépendant, jamais dérivée d'un scan JSON de l'AuditLog — celui-ci n'a pas de
/// colonne `tenderId` dédiée, seulement `resourceType`/`resourceId` qui pour un commentaire/une
/// tâche est l'id de CET enfant, pas du Tender). `summary` est une synthèse courte en français,
/// jamais de contenu sensible (mission §33 — jamais un corps de commentaire complet, jamais un
/// payload IA, jamais un token/secret).
model TenderActivity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id") @db.Uuid

  /// Catalogue gouverné d'événements collaboratifs — CHECK (migration), voir
  /// `domain/tender-activity-type.ts`.
  type String @db.VarChar(40)

  summary String @db.VarChar(500)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, createdAt])
  @@map("tender_activities")
}

model TenderAwardCriterion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(300)
  description String?
  /// Pondération en pourcentage (0-100) — aucune règle de somme totale n'est documentée.
  weight      Decimal @db.Decimal(5, 2)

  parentCriterionId String? @map("parent_criterion_id") @db.Uuid

  /// V2 Sprint 3 §9 — enrichissement additif. `lotId` nullable : absent = critère au niveau
  /// Tender global, renseigné = critère spécifique à ce lot (FK composée, même motif AUDIT-007
  /// que TenderLot lui-même).
  lotId                String?    @map("lot_id") @db.Uuid
  lot                  TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])
  /// PRICE | TECHNICAL_VALUE | DELAY | ENVIRONMENTAL | SOCIAL | OTHER — CHECK (migration), nullable.
  type                 String?    @db.VarChar(40)
  scoringMethod        String?    @map("scoring_method")
  eliminationThreshold Decimal?   @map("elimination_threshold") @db.Decimal(5, 2)
  /// ACTIVE | ARCHIVED — CHECK (migration).
  status               String     @default("ACTIVE") @db.VarChar(20)

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, displayOrder])
  @@index([organizationId, lotId])
  @@map("tender_award_criteria")
}

/// Référence métier vers une pièce attendue dans la réponse — fusionne §8 "Pièces demandées"
/// et §9 "Références documentaires" de la mission (champs quasi identiques). Aucun stockage
/// binaire ici : `documentId` référence le module Documents (FK ajoutée avec ce module —
/// décision validée lors de la conception Documents §V.3).
model TenderRequestedDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(300)
  category     String? @db.VarChar(100)
  documentType String? @map("document_type") @db.VarChar(100)
  required     Boolean @default(false)
  description  String?

  expirationDate DateTime? @map("expiration_date")

  /// PENDING | PROVIDED | VALIDATED | REJECTED
  status String @db.VarChar(30)

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id])

  /// V2 Sprint 3 §10 — enrichissement additif.
  isEliminatory         Boolean    @default(false) @map("is_eliminatory")
  lotId                 String?    @map("lot_id") @db.Uuid
  lot                   TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])
  requestedFormat       String?    @map("requested_format") @db.VarChar(100)
  signatureRequired     Boolean    @default(false) @map("signature_required")
  buyerProvidedTemplate Boolean    @default(false) @map("buyer_provided_template")

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, displayOrder])
  @@index([organizationId, lotId])
  @@map("tender_requested_documents")
}

model TenderMilestone {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String   @db.VarChar(300)
  description String?
  date        DateTime

  /// SUBMISSION_DEADLINE | QUESTION_DEADLINE | MANDATORY_VISIT | INTERNAL_VALIDATION | CUSTOM
  type String @db.VarChar(40)

  /// PENDING | DONE — le dépassement ("MISSED") est calculé à la lecture (date < now), jamais
  /// stocké, pour éviter un job planifié (même principe que l'expiration de Membership).
  status String @db.VarChar(20)

  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  /// V2 Sprint 3 §11 — enrichissement additif.
  timezone    String?    @default("Europe/Paris") @db.VarChar(60)
  lotId       String?    @map("lot_id") @db.Uuid
  lot         TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])
  mandatory   Boolean    @default(true)
  completedAt DateTime?  @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, date])
  @@index([organizationId, lotId])
  @@map("tender_milestones")
}

model TenderRisk {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(300)
  description String?

  /// LOW | MEDIUM | HIGH | CRITICAL — criticité déclarée (jamais recalculée automatiquement à
  /// partir de probability/impact ci-dessous : aucune formule n'est spécifiée par la mission).
  severity String  @db.VarChar(20)
  source   String? @db.VarChar(120)

  /// OPEN | MITIGATED | RESOLVED | ACCEPTED
  status String @db.VarChar(20)

  mitigation String?
  assignedTo String?   @map("assigned_to") @db.Uuid
  resolvedAt DateTime? @map("resolved_at")

  /// V2 Sprint 3 §12 — enrichissement additif.
  /// ADMINISTRATIVE | LEGAL | TECHNICAL | FINANCIAL | PLANNING | RESOURCE | SECURITY | OTHER — CHECK.
  category    String?    @db.VarChar(40)
  /// LOW | MEDIUM | HIGH — CHECK, descriptif, distinct de `severity`.
  probability String?    @db.VarChar(20)
  impact      String?    @db.VarChar(20)
  lotId       String?    @map("lot_id") @db.Uuid
  lot         TenderLot? @relation(fields: [lotId, organizationId], references: [id, organizationId])
  /// MANUAL uniquement ce sprint (CHECK) — Sprint 4 étendra la contrainte pour une origine IA,
  /// jamais introduite ici (mission §12 "ne pas ajouter encore l'origine IA").
  origin      String     @default("MANUAL") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, status])
  @@index([organizationId, lotId])
  @@map("tender_risks")
}

model TenderAlert {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  type String @db.VarChar(60)

  /// CRITICAL | WARNING | INFO
  severity String  @db.VarChar(20)
  message  String
  source   String? @db.VarChar(120)

  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, resolved])
  @@map("tender_alerts")
}

/// Historique des changements de statut — reprend le modèle documenté (§8.7).
model TenderStatusHistoryEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  previousStatus String? @map("previous_status") @db.VarChar(40)
  newStatus      String  @map("new_status") @db.VarChar(40)
  reason         String?

  changedBy String   @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([organizationId, tenderId, changedAt])
  @@map("tender_status_history")
}

// ---------------------------------------------------------------------------------------
// Module Documents (conception validée — voir docs/04-architecture/DOCUMENTS_MODULE.md).
// Document reste indépendant du fournisseur de stockage : seule une `storageKey` opaque est
// persistée, jamais un chemin ou une configuration. DocumentDomain volontairement limité à
// 5 valeurs génériques ; la classification métier fine (RC, CCAP, KBIS, CV...) est portée par
// `category`, un champ libre (suggestions côté frontend uniquement, aucune contrainte en base).
// Statut réservé au cycle de vie actif/archivé ; la suppression logique passe par `deletedAt`
// (même précédent que User/Organization), jamais un 3ᵉ statut.
// ---------------------------------------------------------------------------------------

/// Document logique, indépendant de ses versions physiques.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  title       String  @db.VarChar(500)
  description String?

  /// USER_UPLOAD | DCE | TEMPLATE | GENERATED | IMPORTED
  origin   String  @db.VarChar(30)
  /// TENDER | ORGANIZATION | KNOWLEDGE | TEMPLATE | GENERATED — classification large ;
  /// la classification métier fine est portée par `category` (champ libre ci-dessous).
  domain   String  @db.VarChar(30)
  /// Champ libre (ex. RC, CCAP, CCTP, KBIS, CV...) — aucune contrainte en base, suggestions
  /// gérées côté frontend (conception §V.1).
  category String? @db.VarChar(100)

  /// ACTIVE | ARCHIVED — voir suppression logique via `deletedAt` ci-dessous.
  status String @db.VarChar(20)

  /// Nullable en base uniquement pour permettre le bootstrap transactionnel de la création
  /// (le Document doit exister avant que sa première DocumentVersion ne puisse le référencer) —
  /// jamais nul une fois `createWithInitialVersion` terminé avec succès.
  currentVersionId     String?          @map("current_version_id") @db.Uuid
  currentVersion       DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  currentVersionNumber Int              @default(0) @map("current_version_number")

  createdByUserId String  @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  /// Suppression logique (même précédent que User.deletedAt/Organization.deletedAt) — jamais
  /// exposé dans les listes normales, protège aussi le téléchargement (conception §F).
  deletedAt  DateTime? @map("deleted_at")

  versions                    DocumentVersion[]                  @relation("AllVersions")
  tenderAssociations          DocumentTenderAssociation[]
  clientAccountAssociations   DocumentClientAccountAssociation[]
  requestedDocumentReferences TenderRequestedDocument[]
  /// V2 Sprint 6 — Documents rapprochés/attachés à un ChecklistItem via le matching documentaire.
  matchedByChecklistItems     TenderChecklistItem[]
  /// V2 Sprint 7 — Documents référencés (optionnellement) par une Task.
  tasks                       Task[]
  dceDocuments                DceDocument[]
  documentExtraction          DocumentExtraction?
  analysisJobs                AnalysisJob[]
  businessAnalyses            DocumentBusinessAnalysis[]
  knowledgeDocuments          KnowledgeDocument[]

  /// Support de la FK composée de DceDocument (module DCE) — même motif que TenderLot/AUDIT-007 :
  /// garantit au niveau base qu'un DceDocument ne peut jamais référencer un Document d'une autre
  /// organisation.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, domain])
  @@index([organizationId, origin])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdByUserId])
  @@map("documents")
}

/// Version immuable d'un fichier précis — pas de `updatedAt` : l'absence même de ce champ
/// matérialise l'immuabilité (aucune mutation possible après création).
model DocumentVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation("AllVersions", fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int @map("version_number")

  originalFilename  String @map("original_filename") @db.VarChar(255)
  sanitizedFilename String @map("sanitized_filename") @db.VarChar(255)
  mimeType          String @map("mime_type") @db.VarChar(160)
  extension         String @db.VarChar(20)
  sizeBytes         Int    @map("size_bytes")
  /// SHA-256 hexadécimal — détection de doublon au sein d'un même document, jamais un blocage
  /// automatique (conception §11).
  checksum          String @db.VarChar(64)
  /// Opaque, générée côté serveur à partir d'identifiants (jamais du nom de fichier fourni par
  /// l'utilisateur) — jamais exposée dans une réponse API (conception §M, §22).
  storageKey        String @map("storage_key") @db.VarChar(500)

  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  documentsCurrentlyPointingHere Document[] @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId, checksum])
  @@map("document_versions")
}

/// Lien many-to-many Document ↔ Tender — ne duplique jamais le fichier physique (conception §D).
/// L'appartenance à la même organisation n'est pas garantie par une contrainte SQL native
/// multi-table : elle est vérifiée par AttachDocumentToTenderUseCase avant toute écriture ici.
model DocumentTenderAssociation {
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  organizationId  String   @map("organization_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([documentId, tenderId])
  @@index([organizationId, tenderId])
  @@index([organizationId, documentId])
  @@map("document_tender_associations")
}

/// Dossier de Consultation des Entreprises (module DCE, Sprint 0/1) — conteneur du cycle de vie
/// global de l'import, un par Tender au maximum (conception §4). Ne porte aucune donnée de
/// fichier : le contenu réel (nom, MIME, taille, checksum, clé de stockage) reste entièrement
/// porté par Document/DocumentVersion (module Documents), référencé via DceDocument ci-dessous.
model Dce {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  /// FK composée (tenderId, organizationId) → Tender(id, organizationId) — même motif que
  /// TenderLot (AUDIT-007) : empêche au niveau base qu'un Dce référence un Tender d'une autre
  /// organisation, y compris via un bug applicatif ou un accès direct à la base.
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// DRAFT | IMPORTED — voir dce/domain/dce-status.ts pour la justification du sous-ensemble
  /// volontairement restreint à cette tranche.
  status String @db.VarChar(20)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  documents           DceDocument[]
  documentExtractions DocumentExtraction[]
  analysisJobs        AnalysisJob[]
  businessAnalyses    DocumentBusinessAnalysis[]

  /// Un Tender ne porte jamais plus d'un DCE (conception §4, mission Sprint 0).
  @@unique([tenderId])
  /// Support de la FK composée de DceDocument ci-dessous.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("dces")
}

/// Job d'import ZIP asynchrone (mission Sprint 8A.2, correction bug #3 "import ZIP lourd échoue ou
/// bloque") — la requête HTTP ne fait plus que valider l'upload et créer cette ligne ; l'extraction
/// de l'archive et l'import fichier-par-fichier (déjà sûrs, voir YauzlArchiveInspector/
/// ImportDceFilesUseCase, réutilisés tels quels) se déroulent en tâche de fond, même pattern
/// InProcessDispatcher déjà pratiqué par Extraction/Analysis/Generation. Ne duplique jamais le
/// résultat d'import lui-même : `result` sérialise le même contrat `ImportDceFilesResult` que la
/// réponse HTTP synchrone historique.
model DceImportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// CREATED | EXTRACTING | IMPORTING | READY | PARTIALLY_READY | FAILED | CANCELLED — voir
  /// dce/domain/dce-import-job-status.ts. Protégée par une contrainte CHECK (migration).
  status String @default("CREATED") @db.VarChar(20)

  originalFilename String @map("original_filename") @db.VarChar(255)
  sizeBytes        Int    @map("size_bytes")

  totalFiles    Int? @map("total_files")
  acceptedCount Int? @map("accepted_count")
  rejectedCount Int? @map("rejected_count")

  /// Sérialisation JSON de `ImportDceFilesResult` (accepted/rejected) — même contrat que la
  /// réponse synchrone historique, jamais un second format de résultat.
  result Json?

  /// Message sanitizé (jamais une pile d'appel ni un détail interne) — mission §"erreurs
  /// techniques affichées brutes".
  errorMessage String? @map("error_message") @db.VarChar(2000)

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("dce_import_jobs")
}

/// Lien pur entre un Dce et un Document (même motif que DocumentTenderAssociation) — ne duplique
/// jamais le fichier physique. Les deux FK composées ci-dessous garantissent ensemble, au niveau
/// base de données, qu'un DceDocument ne peut jamais relier un Dce et un Document appartenant à
/// des organisations différentes l'une de l'autre ou du lien lui-même (mission Sprint 0
/// §"contrainte réelle DCE/Tender/organisation").
model DceDocument {
  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId  String @map("organization_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid

  /// ADMINISTRATIVE | TECHNICAL | FINANCIAL | DRAWINGS | OTHER (domain/dce-document-category.ts)
  /// — classification déterministe calculée à l'import (mission architecture §7), jamais par IA.
  category String @default("OTHER") @db.VarChar(20)

  /// IMPORTED | READY_FOR_OCR | PENDING_TEXT_INSPECTION | READY_FOR_NATIVE_EXTRACTION |
  /// NOT_PROCESSABLE | READY_FOR_ANALYSIS | READY_FOR_ANALYSIS_WITH_WARNINGS
  /// (domain/dce-document-processing-status.ts, révisé mission P1-3 puis Sprint 3) — les deux
  /// derniers sont atteints uniquement en miroir d'un DocumentExtraction.status terminal
  /// (SUCCEEDED/PARTIALLY_SUCCEEDED), jamais directement. Défaut IMPORTED. Protégée par une
  /// contrainte CHECK (correction P1-05, voir migration Extraction).
  processingStatus String @default("IMPORTED") @map("processing_status") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dceId, documentId])
  @@index([organizationId, dceId])
  @@index([organizationId, documentId])
  @@map("dce_documents")
}

/// Suivi fin d'une extraction documentaire (mission Sprint 3) — jamais l'analyse IA métier
/// (hors périmètre, module futur distinct). Relation 1:1 avec Document : `documentId` est à la
/// fois clé primaire et clé étrangère, jamais un id de substitution séparé pour une relation qui
/// n'existera jamais autrement que 1:1 (même motif que la clé partagée déjà pratiquée ailleurs
/// dans ce schéma pour des relations stricctement 1:1).
model DocumentExtraction {
  documentId String   @id @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @map("organization_id") @db.Uuid

  /// PENDING | READY | PROCESSING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED | NOT_PROCESSABLE
  /// (domain/document-extraction-status.ts, révisé correction P1-02 — INSPECTING retiré : le
  /// pipeline passe directement de PENDING/READY à PROCESSING via une réservation atomique
  /// courte, l'inspection et la détection de stratégie se déroulant hors transaction) — jamais
  /// confondu avec `DceDocument.processingStatus` (éligibilité grossière, Sprint 2) : ce statut
  /// est le détail fin du pipeline d'extraction lui-même. Protégé par une contrainte CHECK
  /// (correction P1-05, voir migration) : une valeur hors de cet ensemble ne peut plus être
  /// persistée en base, même par un bug applicatif ou un accès direct.
  status String @db.VarChar(24)

  /// NATIVE_TEXT | OCR | OFFICE_DOCUMENT | SPREADSHEET | UNSUPPORTED
  /// (domain/document-extraction-strategy.ts) — décidée après inspection réelle, jamais sur la
  /// seule extension. Protégée par une contrainte CHECK (correction P1-05, voir migration).
  strategy String? @db.VarChar(20)

  attemptCount Int @default(0) @map("attempt_count")

  pageCount       Int?     @map("page_count")
  characterCount  Int?     @map("character_count")
  chunkCount      Int?     @map("chunk_count")
  language        String?  @db.VarChar(8)
  warnings        String[] @default([])
  lastError       String?  @map("last_error")
  contentChecksum String?  @map("content_checksum") @db.VarChar(64)

  /// V2 Sprint 9 (correctif audit Codex round 2 P1, Chat IA conversationnel) — version EXACTE de
  /// `Document` réellement lue au moment où CETTE extraction a produit ses chunks (renseignée par
  /// `ProcessDocumentExtractionUseCase`, jamais recalculée après coup depuis
  /// `Document.currentVersionId` qui peut avoir avancé depuis) : c'est cette colonne, jamais
  /// `Document.currentVersionId`, qui fait foi pour une citation DCE côté Chat. Scalaire simple,
  /// jamais une FK stricte (même motif que les colonnes de provenance des Finding) — NULL pour
  /// toute extraction terminée AVANT cette migration (jamais de backfill approximatif) et pour les
  /// tentatives échouées avant lecture du fichier.
  documentVersionId String? @map("document_version_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempts ExtractionAttempt[]
  chunks   ExtractionChunk[]

  /// Requis par Prisma pour la FK composée ci-dessus (documentId est déjà @id, donc déjà unique
  /// seul — cette contrainte ne fait que le rendre explicite pour la relation 1:1).
  @@unique([documentId, organizationId])
  @@index([organizationId, dceId])
  /// Correction P1-05 — lectures par statut au sein d'une organisation (ex. futur balayage des
  /// documents prêts pour l'analyse IA), jamais un scan complet de la table.
  @@index([organizationId, status])
  @@map("document_extractions")
}

/// Trace immuable d'une tentative d'extraction (mission Sprint 3 — historique, jamais réécrit) :
/// `DocumentExtraction` ne porte que l'état courant, chaque tentative laisse ici une ligne
/// distincte pour observer un retry sans perdre la trace de l'échec précédent.
model ExtractionAttempt {
  id String @id @default(uuid()) @db.Uuid

  documentId         String             @map("document_id") @db.Uuid
  documentExtraction DocumentExtraction @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  organizationId     String             @map("organization_id") @db.Uuid

  attemptNumber Int    @map("attempt_number")
  /// Protégée par une contrainte CHECK (correction P1-05, voir migration).
  strategy      String @db.VarChar(20)
  /// SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED — protégée par une contrainte CHECK (correction
  /// P1-05, voir migration).
  outcome       String @db.VarChar(20)

  /// Nom du moteur ayant traité cette tentative (ex. "pdf-parse", "tesseract.js", "mammoth",
  /// "xlsx") — jamais une clé/secret fournisseur.
  provider          String? @db.VarChar(60)
  providerVersion   String? @map("provider_version") @db.VarChar(30)
  providerRequestId String? @map("provider_request_id") @db.VarChar(120)

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  durationMs Int      @map("duration_ms")

  pageCount      Int?     @map("page_count")
  characterCount Int?     @map("character_count")
  chunkCount     Int?     @map("chunk_count")
  language       String?  @db.VarChar(8)
  warnings       String[] @default([])
  errorCode      String?  @map("error_code") @db.VarChar(60)
  errorMessage   String?  @map("error_message")

  /// Correction P1-05 — deux tentatives identiques pour le même document et le même
  /// `attemptNumber` sont désormais refusées au niveau base : un défaut de coordination
  /// applicative ne peut plus produire un doublon silencieux dans l'historique.
  @@unique([documentId, attemptNumber])
  @@index([organizationId, documentId])
  @@map("extraction_attempts")
}

/// Segment de texte exploitable par la future analyse IA (mission Sprint 3) — jamais un
/// embedding : ce sprint ne branche aucun modèle d'embeddings (hors périmètre explicite).
model ExtractionChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId         String             @map("document_id") @db.Uuid
  documentExtraction DocumentExtraction @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  organizationId     String             @map("organization_id") @db.Uuid

  /// Ordre stable au sein du document — jamais recalculé après coup, toujours réattribué en bloc
  /// par la segmentation qui remplace un jeu de chunks (voir replaceChunks, mission "un retry ne
  /// doit pas dupliquer les chunks").
  sequence     Int
  pageStart    Int?    @map("page_start")
  pageEnd      Int?    @map("page_end")
  sheetName    String? @map("sheet_name") @db.VarChar(120)
  sectionTitle String? @map("section_title") @db.VarChar(300)

  content        String
  characterCount Int    @map("character_count")
  tokenEstimate  Int?   @map("token_estimate")
  checksum       String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, sequence])
  @@index([organizationId, documentId])
  @@map("extraction_chunks")
}

/// Job d'analyse IA (mission Sprint 4.1 — socle technique, aucune analyse métier réelle) — jamais
/// écrasé par un nouveau déclenchement : une nouvelle analyse pour la même cible crée toujours une
/// nouvelle ligne (`analysisVersion` incrémenté), jamais une mise à jour de l'historique existant.
/// Un retry explicite (RetryAnalysisUseCase) réutilise en revanche la MÊME ligne (même version).
model AnalysisJob {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  /// FK composée (tenderId, organizationId) → Tender(id, organizationId) — même motif que
  /// Dce/TenderLot (AUDIT-007).
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Renseignés uniquement pour `scope = 'DOCUMENT'` — jamais pour `scope = 'TENDER'` (voir
  /// contrainte CHECK `analysis_jobs_scope_target_check`, migration).
  dceId String? @map("dce_id") @db.Uuid
  dce   Dce?    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Discriminant polymorphe de cible = `documentId` (scope DOCUMENT) ou `tenderId` (scope TENDER)
  /// — porté en base pour permettre une contrainte d'unicité et un index sur une seule colonne,
  /// jamais des index partiels dépendant du scope. Cohérence garantie par une contrainte CHECK
  /// (migration), jamais uniquement par la discipline applicative.
  targetId String @map("target_id") @db.Uuid

  /// DOCUMENT | TENDER (domain/analysis-scope.ts) — protégé par une contrainte CHECK (migration).
  scope String @db.VarChar(10)

  /// PENDING | QUEUED | PROCESSING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED | CANCELLED
  /// (domain/analysis-status.ts) — protégé par une contrainte CHECK (migration).
  status String @db.VarChar(24)

  /// Nom du provider ayant traité la tentative la plus récente (ex. "OPENAI") — jamais une clé/
  /// secret fournisseur.
  provider String? @db.VarChar(30)
  model    String? @db.VarChar(60)

  /// Numéro de version de CETTE analyse pour sa cible — jamais réutilisé, jamais décrémenté
  /// (mission §"Deux analyses de versions différentes doivent pouvoir coexister").
  analysisVersion   Int     @map("analysis_version")
  promptVersion     Int     @map("prompt_version")
  /// `DocumentAnalysisInput.extractionVersion` au moment de la création (scope DOCUMENT
  /// uniquement) — capturé une fois, jamais recalculé après coup.
  extractionVersion Int?    @map("extraction_version")
  inputChecksum     String? @map("input_checksum") @db.VarChar(64)

  /// Jeton de réservation (compare-and-set, mission §"tentative obsolète") — incrémenté uniquement
  /// par la réservation atomique courte (Phase 1).
  attemptCount Int @default(0) @map("attempt_count")

  /// Rôle de l'acteur ayant déclenché ou (re)lancé la tentative en cours (mission Sprint 4.2) —
  /// nullable pour rester compatible avec les jobs Sprint 4.1 déjà existants (créés avant ce
  /// champ). Jamais un rôle fabriqué : c'est TOUJOURS le rôle réel d'un acteur HTTP authentifié
  /// (StartDocumentAnalysisUseCase/StartTenderAnalysisUseCase/RetryAnalysisUseCase), capturé pour
  /// permettre à `ProcessAnalysisJobUseCase` (traitement en tâche de fond, Phase 2, hors
  /// transaction) de ré-appeler `GetDocumentAnalysisInputUseCase` (contrat public Sprint 3, exige
  /// `ExtractionPermission.Read`) sans jamais inventer un rôle qui n'existe pas dans ce contexte
  /// (même principe que Sprint 3 §"une opération système ne doit jamais dépendre d'un rôle
  /// d'acteur qui n'existe pas dans ce contexte").
  triggeredByRole String? @map("triggered_by_role") @db.VarChar(40)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")

  /// Sortie technique volontairement minimale (mission §"Sortie du provider pour le Sprint 4.1")
  /// — jamais une structure métier détaillée, jamais le contenu complet du corpus analysé.
  resultSummary String? @map("result_summary")
  errorCode     String? @map("error_code") @db.VarChar(60)
  errorMessage  String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @map("updated_at")

  attempts AnalysisAttempt[]

  /// Mission Sprint 4.2 — résultats métier produits par ce job (jamais renseignés pour la
  /// tranche technique placeholder Sprint 4.1, uniquement quand ce job a réellement produit une
  /// analyse métier structurée).
  documentBusinessAnalyses DocumentBusinessAnalysis[]
  deadlineFindings         TenderDeadlineFinding[]
  criterionFindings        TenderCriterionFinding[]
  requirementFindings      TenderRequirementFinding[]
  clauseFindings           TenderClauseFinding[]
  riskFindings             TenderRiskFinding[]
  questionFindings         TenderQuestionFinding[]
  analysisSummaries        TenderAnalysisSummary[]

  /// Une seule version donnée ne peut jamais exister deux fois pour la même cible.
  @@unique([organizationId, scope, targetId, analysisVersion])
  /// Recherche du job actif (non terminal) d'une cible — mission §"double déclenchement".
  @@index([organizationId, targetId, status])
  @@index([organizationId, status])
  @@map("analysis_jobs")
}

/// Trace immuable d'une tentative de traitement d'un `AnalysisJob` (mission Sprint 4.1 —
/// historique append-only, jamais réécrit) : `AnalysisJob` ne porte que l'état courant, chaque
/// réservation laisse ici une ligne distincte.
model AnalysisAttempt {
  id String @id @default(uuid()) @db.Uuid

  jobId String      @map("job_id") @db.Uuid
  job   AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  organizationId String @map("organization_id") @db.Uuid

  attemptNumber Int @map("attempt_number")

  /// MANUAL | RETRY | SYSTEM (domain/analysis-trigger.ts) — protégé par une contrainte CHECK
  /// (migration).
  trigger String @db.VarChar(10)

  provider String? @db.VarChar(30)
  model    String? @db.VarChar(60)

  /// SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED — protégé par une contrainte CHECK (migration).
  outcome String @db.VarChar(20)

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  durationMs Int      @map("duration_ms")

  /// Nombre d'appels provider effectués AU SEIN de cette réservation (politique de retry interne,
  /// mission §"Timeout et retry") — jamais confondu avec `attemptNumber`.
  retryCount Int @default(0) @map("retry_count")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")

  errorCode    String? @map("error_code") @db.VarChar(60)
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  /// Deux tentatives identiques pour le même job et le même `attemptNumber` sont refusées au
  /// niveau base — même motif que `extraction_attempts` (correction P1-05).
  @@unique([jobId, attemptNumber])
  @@index([organizationId, jobId])
  @@map("analysis_attempts")
}

// ---------------------------------------------------------------------------------------------
// Sprint 4.2 — AI Business Analysis
//
// Nommage volontairement distinct de TenderRisk/TenderAwardCriterion/TenderRequestedDocument/
// TenderMilestone (déjà existants ci-dessus, Sprint 2/3, gérés manuellement par l'utilisateur,
// mutables, sans versionnement) : les tables ci-dessous portent le suffixe "Finding" pour ne
// jamais laisser croire qu'il s'agit du même concept. Une trouvaille IA n'écrase jamais un
// enregistrement utilisateur existant et n'est jamais éditée en place — chaque nouvelle analyse
// crée un nouveau jeu de lignes (nouvel `analysisVersion`), l'ancien restant intact pour
// l'historique (mission §"Historisation").
// ---------------------------------------------------------------------------------------------

/// Résultat structuré de l'analyse d'UN document (étape 1 de la mission, "Analyse documentaire")
/// — produit par un `AnalysisJob` de scope DOCUMENT. Intermédiaire : consommé par l'étape 2
/// (consolidation Tender), jamais exposé tel quel par l'API publique (voir `TenderAnalysisSummary`
/// et les tables Finding ci-dessous pour les résultats consolidés réellement exposés).
model DocumentBusinessAnalysis {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Version de l'extraction Sprint 3 effectivement analysée (`DocumentAnalysisInput.extractionVersion`)
  /// — jamais recalculée après coup, capturée telle que lue au moment de l'analyse.
  extractionVersion Int @map("extraction_version")

  /// V2 Sprint 4 (audit Codex P1-004) — identifiant de la DocumentVersion effectivement analysée
  /// (`DocumentAnalysisInput.documentVersionId`), capturé UNE SEULE FOIS ici, jamais recalculé —
  /// même motif que `extractionVersion` juste au-dessus. Référence dénormalisée en lecture seule
  /// (jamais de FK stricte inter-module, comme `AiSuggestion.sourceDocumentId`) : le mapping
  /// Finding -> AiSuggestion la relit ici pour garantir la version EXACTE analysée, jamais "la
  /// version courante au moment du mapping" qui peut avoir changé depuis (remplacement du fichier).
  /// Nullable : une ligne écrite avant ce sprint n'a jamais eu cette information.
  documentVersionId String? @map("document_version_id") @db.Uuid

  /// RC | CCTP | CCAP | AE | BPU | DPGF | ANNEX | UNKNOWN — classification déterminée par le
  /// modèle IA à partir du contenu réel, distincte de `DceDocument.category` (classification
  /// déterministe Sprint 2 par extension/nom de fichier, voir dce-document-classifier.ts) :
  /// jamais fusionnées, jamais l'une n'écrase l'autre. Protégée par une contrainte CHECK (migration).
  documentType String @map("document_type") @db.VarChar(20)
  /// Langue détectée du document (mission §"Langues" — fr/en au minimum) — les citations
  /// conservent cette langue, jamais traduites.
  language     String @db.VarChar(8)

  /// Informations générales (mission §1) — objet technique minimal, jamais dupliqué dans des
  /// colonnes dédiées : ce résultat est un intermédiaire consommé par la consolidation (étape 2),
  /// jamais lu directement par l'API publique.
  metadata     Json     @default("{}")
  /// Tableaux de `DocumentDeadlineFinding`/`DocumentCriterionFinding`/... (mission §2-5), au format
  /// validé par `document-analysis-output.schema.ts` avant persistance — jamais un JSON brut non
  /// validé (mission §"Sorties structurées").
  deadlines    Json     @default("[]")
  criteria     Json     @default("[]")
  requirements Json     @default("[]")
  clauses      Json     @default("[]")
  warnings     String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, documentId, analysisVersion])
  @@index([organizationId, tenderId])
  @@map("document_business_analyses")
}

/// Provenance commune à toutes les tables Finding ci-dessous (mission §"Provenance obligatoire")
/// — `documentId`/`chunkSequence` ne portent jamais de contrainte FK stricte : ce sont des
/// affirmations du modèle IA, vérifiées applicativement (le chunk cité doit réellement exister
/// parmi les chunks fournis en entrée) avant persistance, jamais une garantie base de données
/// (une trouvaille reste consultable même si le document source est supprimé plus tard).

/// Échéance consolidée (mission §2 "Dates et échéances").
model TenderDeadlineFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  /// PUBLICATION | SUBMISSION | QUESTIONS | ANSWER | VISIT | START_ESTIMATED | VALIDITY_PERIOD |
  /// INTERMEDIATE | CONTRACTUAL | OTHER — protégée par une contrainte CHECK (migration).
  kind    String    @db.VarChar(30)
  label   String    @db.VarChar(300)
  /// Normalisée (mission §"Chaque date doit être normalisée dans un format stable") — absente
  /// uniquement si le texte source ne permet aucune normalisation fiable (`rawText` porte alors
  /// le texte brut, jamais une date devinée).
  date    DateTime?
  rawText String?   @map("raw_text")

  documentId        String? @map("document_id") @db.Uuid
  /// V2 Sprint 4 (audit Codex P1-004) — version EXACTE du document consolidé, capturée au moment
  /// précis de `persistTenderConsolidation` (jamais recalculée après coup, jamais "la version
  /// courante au moment où quelqu'un lit cette ligne") — même motif que `DocumentBusinessAnalysis.
  /// documentVersionId`. Nullable : absente si `documentId` l'est aussi, ou pour une ligne écrite
  /// avant ce sprint.
  documentVersionId String? @map("document_version_id") @db.Uuid
  chunkSequence     Int?    @map("chunk_sequence")
  pageStart         Int?    @map("page_start")
  pageEnd           Int?    @map("page_end")
  sheetName         String? @map("sheet_name") @db.VarChar(120)
  sectionTitle      String? @map("section_title") @db.VarChar(300)
  citation          String? @db.VarChar(500)
  /// Mission §"Si une information est déduite, indiquer explicitement qu'il s'agit d'une
  /// inférence" — jamais une déduction présentée comme une citation directe.
  isInferred        Boolean @default(false) @map("is_inferred")
  /// Score de confiance déclaré par le modèle (mission §"Score de confiance") — jamais utilisé
  /// seul, voir les validations déterministes appliquées par `TenderConsolidationOutputSchema`
  /// avant persistance.
  confidence        Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_deadline_findings")
}

/// Critère d'attribution consolidé (mission §3 "Critères d'attribution").
model TenderCriterionFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  name          String  @db.VarChar(300)
  /// Pondération en pourcentage (0-100) — nullable : certains documents ne chiffrent pas
  /// systématiquement la pondération (mission §"Vérifier autant que possible... total proche de
  /// 100 %" — appliqué au niveau de la consolidation, jamais bloquant pour un seul critère).
  weight        Float?
  /// Sous-critères `[{ name, weight }]` — jamais une table séparée : toujours lus/écrits comme un
  /// tout avec leur critère parent, jamais interrogés indépendamment.
  subCriteria   Json?   @map("sub_criteria")
  scoringMethod String? @map("scoring_method")
  priceFormula  String? @map("price_formula")
  threshold     String?
  isEliminatory Boolean @default(false) @map("is_eliminatory")

  documentId        String? @map("document_id") @db.Uuid
  /// V2 Sprint 4 (audit Codex P1-004) — version EXACTE du document consolidé, capturée au moment
  /// précis de `persistTenderConsolidation` (voir `TenderDeadlineFinding.documentVersionId`).
  documentVersionId String? @map("document_version_id") @db.Uuid
  chunkSequence     Int?    @map("chunk_sequence")
  pageStart         Int?    @map("page_start")
  pageEnd           Int?    @map("page_end")
  sheetName         String? @map("sheet_name") @db.VarChar(120)
  sectionTitle      String? @map("section_title") @db.VarChar(300)
  citation          String? @db.VarChar(500)
  isInferred        Boolean @default(false) @map("is_inferred")
  confidence        Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_criterion_findings")
}

/// Exigence / pièce demandée consolidée (mission §4 "Exigences et pièces demandées").
model TenderRequirementFinding {
