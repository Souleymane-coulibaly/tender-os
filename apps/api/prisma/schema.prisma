/// Sprint 8C.1 — gabarit officiel DAJ (DC1/DC2/DC4/ATTRI1), stocké TEL QUEL — jamais modifié,
/// jamais patché — comme un `Document` réel du module Documents (`fileDocumentId`). Une seule ligne
/// `active` par (organizationId, documentType) — `organizationId` nul = gabarit système par défaut
/// (les 4 gabarits de cette passe) ; une organisation pourra fournir le sien plus tard (champ
/// prévu, non exploité cette passe). Activation gérée en transaction courte côté application (même
/// motif que `ExportTemplateVersion.activateAtomically`), jamais un remplacement en place.
model OfficialAdministrativeTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  /// DC1 | DC2 | DC4 | ACTE_ENGAGEMENT — CHECK, catalogue `AdministrativeDocumentType` réutilisé.
  documentType String @map("document_type") @db.VarChar(40)

  officialName    String    @map("official_name") @db.VarChar(300)
  version         Int
  sourceAuthority String    @map("source_authority") @db.VarChar(120)
  sourceReference String    @map("source_reference") @db.VarChar(500)
  publishedAt     DateTime? @map("published_at")
  importedAt      DateTime  @default(now()) @map("imported_at")

  /// Dénormalisés en LECTURE SEULE vers un Document déjà vérifié — jamais de FK stricte inter-module.
  fileDocumentId        String @map("file_document_id") @db.Uuid
  fileDocumentVersionId String @map("file_document_version_id") @db.Uuid
  hash                  String @db.VarChar(128)

  active Boolean @default(true)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, documentType, active])
  @@map("official_administrative_templates")
}

/// Sprint 8C.1 — brouillon éditable d'un formulaire officiel avant génération de l'Annexe TenderOS.
