  subcontractorLegalIdentifier String? @map("subcontractor_legal_identifier") @db.VarChar(80)
  servicesDescription          String  @map("services_description")

  /// V2 Sprint 2 — référence dénormalisée en LECTURE SEULE vers le répertoire réutilisable
  /// (mission §6), jamais de FK stricte inter-module, même motif que les autres colonnes *Id de
  /// ce modèle (`administrativeDocumentId`). V2 Sprint 11 : désormais réellement exploitée en
  /// lecture par le mapping DC4 (identité/IBAN/BIC/capacités du sous-traitant) — la validité
  /// réelle passe par le use case public du module `subcontractors`, jamais par la DB.
