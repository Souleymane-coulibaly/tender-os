// TenderOS — Prisma schema
//
// Modules implémentés : Identity, Authentication (bible/03-domain/domain-model.md,
// docs/04-architecture/DATABASE_DESIGN.md §5.1), Organizations (docs/04-architecture/DATABASE_DESIGN.md §5.2),
// Memberships (docs/04-architecture/DATABASE_DESIGN.md §5.3, §6, §21),
// Platform Administration (aucune documentation préexistante — table dédiée, distincte
// de Memberships, voir modules/platform-administration),
// Tenders (premier vertical slice "préparation de réponse" — statuts et périmètre propres
// à ce module, distincts du `tenders` de découverte documenté en §8.3 ; voir modules/tenders),
// Documents (gestion documentaire, versioning, associations Tender — voir modules/documents,
// docs/04-architecture/DOCUMENTS_MODULE.md ; fondation pour de futurs modules IA/Knowledge,
// aucune extraction/OCR/embedding implémentés ici).
// Aucun autre module métier (Invitations, IA, Billing, ...)
// n'est défini ici — voir skills/platform-foundation/DATABASE_PATTERNS.md avant d'en ajouter.
// Prisma reste confiné à la couche Infrastructure (skills/platform-foundation/ARCHITECTURE_RULES.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Identité humaine globale, indépendante de toute organisation
/// (docs/04-architecture/DATABASE_DESIGN.md §5.1 — "users").
/// L'appartenance à une organisation est gérée par le futur module Memberships.
model User {
  id    String @id @default(uuid()) @db.Uuid
  /// Normalisé en minuscules par le Domain (value object EmailAddress) avant persistance —
  /// tient lieu d'unicité insensible à la casse sans dépendre de l'extension Postgres citext.
  email String @unique @db.VarChar(320)

  displayName String  @map("display_name") @db.VarChar(160)
  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)

  /// INVITED | ACTIVE | SUSPENDED | DEACTIVATED (docs/04-architecture/DATABASE_DESIGN.md §5.1)
  status String @db.VarChar(30)

  /// Authentification locale par mot de passe (hash scrypt, jamais le mot de passe en clair).
  /// La documentation autorise explicitement un fournisseur d'identité externe à la place —
  /// ce champ reste propre à ce mécanisme d'authentification, pas à l'identité elle-même.
  passwordHash String @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions              Session[]
  memberships           OrganizationMembership[]
  platformAdministrator PlatformAdministrator?
  clientAssignments     ClientAssignment[]

  @@map("users")
}

/// Session d'authentification server-side, référencée par le jeton d'accès émis
/// (bible/04-architecture/system-architecture.md §14 — IdentityProvider.revokeSession).
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Entreprise cliente de TenderOS, agrégat racine du tenant
/// (docs/04-architecture/DATABASE_DESIGN.md §5.2, bible/02-product/ubiquitous-language.md).
/// Ne porte pas de organizationId — c'est elle-même la frontière d'isolation multi-tenant.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(200)

  /// Unique — sert de clé métier lisible (URLs, sous-domaines).
  slug String @unique @db.VarChar(120)

  legalName          String? @map("legal_name") @db.VarChar(240)
  registrationNumber String? @map("registration_number") @db.VarChar(100)
  countryCode        String? @map("country_code") @db.Char(2)

  defaultCurrency String @default("EUR") @map("default_currency") @db.Char(3)
  defaultTimezone String @map("default_timezone") @db.VarChar(80)

  /// TRIAL | ACTIVE | SUSPENDED | CLOSED (docs/04-architecture/DATABASE_DESIGN.md §5.2)
  status String @db.VarChar(30)

  settings Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships     OrganizationMembership[]
  tenders         Tender[]
  documents       Document[]
  auditLogs       AuditLog[]
  knowledgeSpaces KnowledgeSpace[]
  clientAccounts  ClientAccount[]

  @@map("organizations")
}

/// Relie un utilisateur à une organisation (docs/04-architecture/DATABASE_DESIGN.md §5.3).
/// Pas de deletedAt : le retrait est une transition de statut vers REMOVED, pas un soft delete —
/// la contrainte UNIQUE(organizationId, userId) s'applique donc à toutes les lignes, y compris REMOVED
/// (empêche explicitement les doublons d'appartenance, y compris après un retrait).
model OrganizationMembership {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// INVITED | ACTIVE | SUSPENDED | EXPIRED | REMOVED (docs/04-architecture/DATABASE_DESIGN.md §5.3)
  status String @db.VarChar(30)

  joinedAt    DateTime? @map("joined_at")
  suspendedAt DateTime? @map("suspended_at")
  /// Accès limité dans le temps (bible/03-domain/permissions.md §22, External Consultant) —
  /// vérifié à la lecture, aucun job planifié ne fait transiter le statut vers EXPIRED dans cette tranche.
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles MembershipRole[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("organization_memberships")
}

/// Rôle attribuable à une Membership — uniquement des rôles système dans cette tranche
/// (organizationId toujours nul ; les rôles personnalisés par organisation ne sont pas implémentés).
model Role {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid
  code           String  @db.VarChar(100)
  name           String  @db.VarChar(160)

  /// ORGANIZATION | WORKSPACE (docs/04-architecture/DATABASE_DESIGN.md §6.1) — seul ORGANIZATION est utilisé ici.
  scope    String  @db.VarChar(30)
  isSystem Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([code])
  @@map("roles")
}

/// Catalogue des permissions, notation `resource:action` (bible/03-domain/permissions.md §6).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(160)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Relie une Membership à un rôle d'organisation (docs/04-architecture/DATABASE_DESIGN.md §6.4).
/// Le Domain impose qu'une Membership n'ait jamais plus d'un rôle actif à la fois dans cette tranche
/// ("modifier LE rôle d'un membre") — la table reste générique pour rester compatible avec une évolution future.
model MembershipRole {
  membershipId String                 @map("membership_id") @db.Uuid
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// Journal d'audit append-only (docs/04-architecture/DATABASE_DESIGN.md §21.1, BR-GEN-002).
/// Sous-ensemble des colonnes documentées : ipAddress/userAgent/traceId omis, aucune source fiable
/// n'étant disponible dans les use cases actuels sans étendre le contexte de requête (hors périmètre Memberships).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorType    String  @map("actor_type") @db.VarChar(30)
  actorId      String? @map("actor_id") @db.Uuid
  action       String  @db.VarChar(160)
  resourceType String  @map("resource_type") @db.VarChar(100)
  resourceId   String? @map("resource_id") @db.Uuid
  result       String  @db.VarChar(30)
  reasonCode   String? @map("reason_code") @db.VarChar(100)
  requestId    String? @map("request_id") @db.VarChar(120)
  metadata     Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// Identité d'administration plateforme — distincte de Memberships/roles d'organisation
/// (mission Platform Administration : "N'ajoute pas ces rôles dans Memberships"). Un OWNER
/// ou ADMIN d'une organisation cliente n'obtient jamais automatiquement d'accès ici : cette
/// table est la seule source d'autorisation pour le back-office plateforme.
model PlatformAdministrator {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// PLATFORM_OWNER | PLATFORM_ADMIN | PLATFORM_SUPPORT (aucun rôle plateforme documenté —
  /// ensemble minimal proposé et validé lors de cette mission).
  role String @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_administrators")
}

/// Appel d'offres — "premier vertical slice" de préparation de réponse (mission Tenders).
/// Statuts et champs distincts du `tenders` de découverte documenté en §8.3 (module Discovery/
/// Qualification non implémenté) — voir commentaire d'en-tête de ce fichier.
/// Toutes les références utilisateur (createdBy, internalOwnerId, ...) restent de simples uuid
/// sans relation Prisma vers User, à l'image de `AuditLog.actorId` déjà dans ce schéma.
model Tender {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// Client géré par l'organisation propriétaire de ce Tender (mission Sprint 5.1) — obligatoire
  /// depuis ce sprint ; les Tenders créés avant cette tranche ont été rattachés au client par
  /// défaut de leur organisation lors du backfill de migration (jamais modifié rétroactivement
  /// une fois la migration terminée). Jamais de cascade : un ClientAccount qui porte encore des
  /// Tenders ne peut pas être supprimé (voir DeleteClientAccountUseCase).
  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  title       String  @db.VarChar(500)
  reference   String? @db.VarChar(255)
  buyerName   String? @map("buyer_name") @db.VarChar(300)
  description String?

  publicationDate    DateTime? @map("publication_date")
  submissionDeadline DateTime? @map("submission_deadline")

  procedureType String? @map("procedure_type") @db.VarChar(80)

  /// PUBLIC | PRIVATE (domain/market-type.ts) — nature du marché, distincte de `source` ci-dessous.
  marketType String? @default("PUBLIC") @map("market_type") @db.VarChar(80)

  /// FR | BE | DE | ES | IT | LU | NL | EU | OTHER (domain/tender-country.ts) — préparation
  /// internationale (mission architecture §12), sans logique métier par pays branchée dessus.
  country String? @default("FR") @db.VarChar(10)

  /// fr | en | de | es | it | nl (domain/tender-language.ts).
  language String? @default("fr") @db.VarChar(10)

  /// MANUAL | BOAMP | TED | PRIVATE | OTHER (domain/tender-source.ts) — provenance du Tender ;
  /// aucun connecteur BOAMP/TED réel n'existe dans cette tranche (mission architecture §6).
  source String? @default("MANUAL") @db.VarChar(20)

  /// Identifiant du marché dans le système source (BOAMP/TED/plateforme privée) — jamais utilisé
  /// en clé de jointure applicative, purement informatif tant qu'aucun connecteur n'existe.
  externalReference String? @map("external_reference") @db.VarChar(255)
  sourceUrl         String? @map("source_url") @db.VarChar(2048)

  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @default("EUR") @db.Char(3)

  internalOwnerId String? @map("internal_owner_id") @db.Uuid

  /// DRAFT | IN_ANALYSIS | READY | IN_PREPARATION | READY_TO_SUBMIT | SUBMITTED | WON | LOST | ARCHIVED
  status String @db.VarChar(40)

  tags String[]

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  archivedAt DateTime? @map("archived_at")

  /// Concurrence optimiste (docs/04-architecture/DATABASE_DESIGN.md §23 — Tender y figure explicitement).
  version Int @default(1)

  lots                     TenderLot[]
  checklistItems           TenderChecklistItem[]
  awardCriteria            TenderAwardCriterion[]
  requestedDocuments       TenderRequestedDocument[]
  milestones               TenderMilestone[]
  risks                    TenderRisk[]
  alerts                   TenderAlert[]
  statusHistory            TenderStatusHistoryEntry[]
  documentAssociations     DocumentTenderAssociation[]
  dces                     Dce[]
  analysisJobs             AnalysisJob[]
  documentBusinessAnalyses DocumentBusinessAnalysis[]
  deadlineFindings         TenderDeadlineFinding[]
  criterionFindings        TenderCriterionFinding[]
  requirementFindings      TenderRequirementFinding[]
  clauseFindings           TenderClauseFinding[]
  riskFindings             TenderRiskFinding[]
  questionFindings         TenderQuestionFinding[]
  analysisSummaries        TenderAnalysisSummary[]

  /// AUDIT-007 : contrainte composite support de la FK composée de TenderLot ci-dessous — garantit
  /// au niveau base de données qu'un TenderLot ne peut jamais référencer un couple
  /// (tenderId, organizationId) incohérent avec le Tender réel (organizationId dénormalisé).
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, submissionDeadline])
  @@index([organizationId, createdAt])
  /// Filtre "responsable" (mission Kanban & List Views §8) — déjà exposé par l'API sans
  /// index dédié jusqu'ici.
  @@index([organizationId, internalOwnerId])
  /// Tri "dernière modification" de la vue Liste (mission Kanban & List Views §5, §8).
  @@index([organizationId, updatedAt])
  /// Filtre "client" (mission Sprint 5.1 §"filtre client") — liste des Tenders d'un client donné.
  @@index([organizationId, clientAccountId])
  @@map("tenders")
}

model TenderLot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  /// AUDIT-007 : FK composée (tenderId, organizationId) → Tender(id, organizationId) plutôt
  /// qu'une simple FK sur tenderId — empêche à la racine (contrainte Postgres, jamais contournable
  /// par un bug applicatif ou un accès direct à la base) qu'un lot porte un organizationId
  /// différent de celui du Tender qu'il référence. Voir §K du rapport d'implémentation pour les
  /// alternatives écartées.
  tender         Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  lotNumber       String   @map("lot_number") @db.VarChar(80)
  title           String   @db.VarChar(500)
  description     String?
  estimatedAmount Decimal? @map("estimated_amount") @db.Decimal(19, 4)
  currency        String?  @db.Char(3)
  displayOrder    Int      @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Suppression logique (conception Lots §D) — un lot supprimé reste soumis à la contrainte
  /// d'unicité ci-dessous : son numéro n'est jamais libéré, ce qui rend RestoreTenderLot
  /// toujours sûr (jamais de collision possible avec un lot créé entretemps).
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenderId, lotNumber])
  @@index([organizationId, tenderId])
  @@index([organizationId, tenderId, displayOrder])
  @@map("tender_lots")
}

model TenderChecklistItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(300)
  description String?
  required    Boolean @default(false)

  /// TODO | IN_PROGRESS | COMPLETED | NOT_APPLICABLE
  status String @db.VarChar(30)

  assignedTo String?   @map("assigned_to") @db.Uuid
  dueDate    DateTime? @map("due_date")
  comment    String?

  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by") @db.Uuid

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, displayOrder])
  @@map("tender_checklist_items")
}

model TenderAwardCriterion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(300)
  description String?
  /// Pondération en pourcentage (0-100) — aucune règle de somme totale n'est documentée.
  weight      Decimal @db.Decimal(5, 2)

  parentCriterionId String? @map("parent_criterion_id") @db.Uuid

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, displayOrder])
  @@map("tender_award_criteria")
}

/// Référence métier vers une pièce attendue dans la réponse — fusionne §8 "Pièces demandées"
/// et §9 "Références documentaires" de la mission (champs quasi identiques). Aucun stockage
/// binaire ici : `documentId` référence le module Documents (FK ajoutée avec ce module —
/// décision validée lors de la conception Documents §V.3).
model TenderRequestedDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(300)
  category     String? @db.VarChar(100)
  documentType String? @map("document_type") @db.VarChar(100)
  required     Boolean @default(false)
  description  String?

  expirationDate DateTime? @map("expiration_date")

  /// PENDING | PROVIDED | VALIDATED | REJECTED
  status String @db.VarChar(30)

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id])

  displayOrder Int @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, displayOrder])
  @@map("tender_requested_documents")
}

model TenderMilestone {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String   @db.VarChar(300)
  description String?
  date        DateTime

  /// SUBMISSION_DEADLINE | QUESTION_DEADLINE | MANDATORY_VISIT | INTERNAL_VALIDATION | CUSTOM
  type String @db.VarChar(40)

  /// PENDING | DONE — le dépassement ("MISSED") est calculé à la lecture (date < now), jamais
  /// stocké, pour éviter un job planifié (même principe que l'expiration de Membership).
  status String @db.VarChar(20)

  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, date])
  @@map("tender_milestones")
}

model TenderRisk {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(300)
  description String?

  /// LOW | MEDIUM | HIGH | CRITICAL
  severity String  @db.VarChar(20)
  source   String? @db.VarChar(120)

  /// OPEN | MITIGATED | RESOLVED | ACCEPTED
  status String @db.VarChar(20)

  mitigation String?
  assignedTo String?   @map("assigned_to") @db.Uuid
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, tenderId, status])
  @@map("tender_risks")
}

model TenderAlert {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  type String @db.VarChar(60)

  /// CRITICAL | WARNING | INFO
  severity String  @db.VarChar(20)
  message  String
  source   String? @db.VarChar(120)

  resolved   Boolean   @default(false)
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, resolved])
  @@map("tender_alerts")
}

/// Historique des changements de statut — reprend le modèle documenté (§8.7).
model TenderStatusHistoryEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId       String @map("tender_id") @db.Uuid
  tender         Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  previousStatus String? @map("previous_status") @db.VarChar(40)
  newStatus      String  @map("new_status") @db.VarChar(40)
  reason         String?

  changedBy String   @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([organizationId, tenderId, changedAt])
  @@map("tender_status_history")
}

// ---------------------------------------------------------------------------------------
// Module Documents (conception validée — voir docs/04-architecture/DOCUMENTS_MODULE.md).
// Document reste indépendant du fournisseur de stockage : seule une `storageKey` opaque est
// persistée, jamais un chemin ou une configuration. DocumentDomain volontairement limité à
// 5 valeurs génériques ; la classification métier fine (RC, CCAP, KBIS, CV...) est portée par
// `category`, un champ libre (suggestions côté frontend uniquement, aucune contrainte en base).
// Statut réservé au cycle de vie actif/archivé ; la suppression logique passe par `deletedAt`
// (même précédent que User/Organization), jamais un 3ᵉ statut.
// ---------------------------------------------------------------------------------------

/// Document logique, indépendant de ses versions physiques.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  title       String  @db.VarChar(500)
  description String?

  /// USER_UPLOAD | DCE | TEMPLATE | GENERATED | IMPORTED
  origin   String  @db.VarChar(30)
  /// TENDER | ORGANIZATION | KNOWLEDGE | TEMPLATE | GENERATED — classification large ;
  /// la classification métier fine est portée par `category` (champ libre ci-dessous).
  domain   String  @db.VarChar(30)
  /// Champ libre (ex. RC, CCAP, CCTP, KBIS, CV...) — aucune contrainte en base, suggestions
  /// gérées côté frontend (conception §V.1).
  category String? @db.VarChar(100)

  /// ACTIVE | ARCHIVED — voir suppression logique via `deletedAt` ci-dessous.
  status String @db.VarChar(20)

  /// Nullable en base uniquement pour permettre le bootstrap transactionnel de la création
  /// (le Document doit exister avant que sa première DocumentVersion ne puisse le référencer) —
  /// jamais nul une fois `createWithInitialVersion` terminé avec succès.
  currentVersionId     String?          @map("current_version_id") @db.Uuid
  currentVersion       DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  currentVersionNumber Int              @default(0) @map("current_version_number")

  createdByUserId String  @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  /// Suppression logique (même précédent que User.deletedAt/Organization.deletedAt) — jamais
  /// exposé dans les listes normales, protège aussi le téléchargement (conception §F).
  deletedAt  DateTime? @map("deleted_at")

  versions                    DocumentVersion[]           @relation("AllVersions")
  tenderAssociations          DocumentTenderAssociation[]
  requestedDocumentReferences TenderRequestedDocument[]
  dceDocuments                DceDocument[]
  documentExtraction          DocumentExtraction?
  analysisJobs                AnalysisJob[]
  businessAnalyses            DocumentBusinessAnalysis[]
  knowledgeDocuments          KnowledgeDocument[]

  /// Support de la FK composée de DceDocument (module DCE) — même motif que TenderLot/AUDIT-007 :
  /// garantit au niveau base qu'un DceDocument ne peut jamais référencer un Document d'une autre
  /// organisation.
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, domain])
  @@index([organizationId, origin])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdByUserId])
  @@map("documents")
}

/// Version immuable d'un fichier précis — pas de `updatedAt` : l'absence même de ce champ
/// matérialise l'immuabilité (aucune mutation possible après création).
model DocumentVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation("AllVersions", fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int @map("version_number")

  originalFilename  String @map("original_filename") @db.VarChar(255)
  sanitizedFilename String @map("sanitized_filename") @db.VarChar(255)
  mimeType          String @map("mime_type") @db.VarChar(160)
  extension         String @db.VarChar(20)
  sizeBytes         Int    @map("size_bytes")
  /// SHA-256 hexadécimal — détection de doublon au sein d'un même document, jamais un blocage
  /// automatique (conception §11).
  checksum          String @db.VarChar(64)
  /// Opaque, générée côté serveur à partir d'identifiants (jamais du nom de fichier fourni par
  /// l'utilisateur) — jamais exposée dans une réponse API (conception §M, §22).
  storageKey        String @map("storage_key") @db.VarChar(500)

  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  documentsCurrentlyPointingHere Document[] @relation("CurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId, checksum])
  @@map("document_versions")
}

/// Lien many-to-many Document ↔ Tender — ne duplique jamais le fichier physique (conception §D).
/// L'appartenance à la même organisation n'est pas garantie par une contrainte SQL native
/// multi-table : elle est vérifiée par AttachDocumentToTenderUseCase avant toute écriture ici.
model DocumentTenderAssociation {
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  organizationId  String   @map("organization_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([documentId, tenderId])
  @@index([organizationId, tenderId])
  @@index([organizationId, documentId])
  @@map("document_tender_associations")
}

/// Dossier de Consultation des Entreprises (module DCE, Sprint 0/1) — conteneur du cycle de vie
/// global de l'import, un par Tender au maximum (conception §4). Ne porte aucune donnée de
/// fichier : le contenu réel (nom, MIME, taille, checksum, clé de stockage) reste entièrement
/// porté par Document/DocumentVersion (module Documents), référencé via DceDocument ci-dessous.
model Dce {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  /// FK composée (tenderId, organizationId) → Tender(id, organizationId) — même motif que
  /// TenderLot (AUDIT-007) : empêche au niveau base qu'un Dce référence un Tender d'une autre
  /// organisation, y compris via un bug applicatif ou un accès direct à la base.
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// DRAFT | IMPORTED — voir dce/domain/dce-status.ts pour la justification du sous-ensemble
  /// volontairement restreint à cette tranche.
  status String @db.VarChar(20)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  documents           DceDocument[]
  documentExtractions DocumentExtraction[]
  analysisJobs        AnalysisJob[]
  businessAnalyses    DocumentBusinessAnalysis[]

  /// Un Tender ne porte jamais plus d'un DCE (conception §4, mission Sprint 0).
  @@unique([tenderId])
  /// Support de la FK composée de DceDocument ci-dessous.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("dces")
}

/// Lien pur entre un Dce et un Document (même motif que DocumentTenderAssociation) — ne duplique
/// jamais le fichier physique. Les deux FK composées ci-dessous garantissent ensemble, au niveau
/// base de données, qu'un DceDocument ne peut jamais relier un Dce et un Document appartenant à
/// des organisations différentes l'une de l'autre ou du lien lui-même (mission Sprint 0
/// §"contrainte réelle DCE/Tender/organisation").
model DceDocument {
  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId  String @map("organization_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid

  /// ADMINISTRATIVE | TECHNICAL | FINANCIAL | DRAWINGS | OTHER (domain/dce-document-category.ts)
  /// — classification déterministe calculée à l'import (mission architecture §7), jamais par IA.
  category String @default("OTHER") @db.VarChar(20)

  /// IMPORTED | READY_FOR_OCR | PENDING_TEXT_INSPECTION | READY_FOR_NATIVE_EXTRACTION |
  /// NOT_PROCESSABLE | READY_FOR_ANALYSIS | READY_FOR_ANALYSIS_WITH_WARNINGS
  /// (domain/dce-document-processing-status.ts, révisé mission P1-3 puis Sprint 3) — les deux
  /// derniers sont atteints uniquement en miroir d'un DocumentExtraction.status terminal
  /// (SUCCEEDED/PARTIALLY_SUCCEEDED), jamais directement. Défaut IMPORTED. Protégée par une
  /// contrainte CHECK (correction P1-05, voir migration Extraction).
  processingStatus String @default("IMPORTED") @map("processing_status") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dceId, documentId])
  @@index([organizationId, dceId])
  @@index([organizationId, documentId])
  @@map("dce_documents")
}

/// Suivi fin d'une extraction documentaire (mission Sprint 3) — jamais l'analyse IA métier
/// (hors périmètre, module futur distinct). Relation 1:1 avec Document : `documentId` est à la
/// fois clé primaire et clé étrangère, jamais un id de substitution séparé pour une relation qui
/// n'existera jamais autrement que 1:1 (même motif que la clé partagée déjà pratiquée ailleurs
/// dans ce schéma pour des relations stricctement 1:1).
model DocumentExtraction {
  documentId String   @id @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organizationId String @map("organization_id") @db.Uuid

  /// PENDING | READY | PROCESSING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED | NOT_PROCESSABLE
  /// (domain/document-extraction-status.ts, révisé correction P1-02 — INSPECTING retiré : le
  /// pipeline passe directement de PENDING/READY à PROCESSING via une réservation atomique
  /// courte, l'inspection et la détection de stratégie se déroulant hors transaction) — jamais
  /// confondu avec `DceDocument.processingStatus` (éligibilité grossière, Sprint 2) : ce statut
  /// est le détail fin du pipeline d'extraction lui-même. Protégé par une contrainte CHECK
  /// (correction P1-05, voir migration) : une valeur hors de cet ensemble ne peut plus être
  /// persistée en base, même par un bug applicatif ou un accès direct.
  status String @db.VarChar(24)

  /// NATIVE_TEXT | OCR | OFFICE_DOCUMENT | SPREADSHEET | UNSUPPORTED
  /// (domain/document-extraction-strategy.ts) — décidée après inspection réelle, jamais sur la
  /// seule extension. Protégée par une contrainte CHECK (correction P1-05, voir migration).
  strategy String? @db.VarChar(20)

  attemptCount Int @default(0) @map("attempt_count")

  pageCount       Int?     @map("page_count")
  characterCount  Int?     @map("character_count")
  chunkCount      Int?     @map("chunk_count")
  language        String?  @db.VarChar(8)
  warnings        String[] @default([])
  lastError       String?  @map("last_error")
  contentChecksum String?  @map("content_checksum") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempts ExtractionAttempt[]
  chunks   ExtractionChunk[]

  /// Requis par Prisma pour la FK composée ci-dessus (documentId est déjà @id, donc déjà unique
  /// seul — cette contrainte ne fait que le rendre explicite pour la relation 1:1).
  @@unique([documentId, organizationId])
  @@index([organizationId, dceId])
  /// Correction P1-05 — lectures par statut au sein d'une organisation (ex. futur balayage des
  /// documents prêts pour l'analyse IA), jamais un scan complet de la table.
  @@index([organizationId, status])
  @@map("document_extractions")
}

/// Trace immuable d'une tentative d'extraction (mission Sprint 3 — historique, jamais réécrit) :
/// `DocumentExtraction` ne porte que l'état courant, chaque tentative laisse ici une ligne
/// distincte pour observer un retry sans perdre la trace de l'échec précédent.
model ExtractionAttempt {
  id String @id @default(uuid()) @db.Uuid

  documentId         String             @map("document_id") @db.Uuid
  documentExtraction DocumentExtraction @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  organizationId     String             @map("organization_id") @db.Uuid

  attemptNumber Int    @map("attempt_number")
  /// Protégée par une contrainte CHECK (correction P1-05, voir migration).
  strategy      String @db.VarChar(20)
  /// SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED — protégée par une contrainte CHECK (correction
  /// P1-05, voir migration).
  outcome       String @db.VarChar(20)

  /// Nom du moteur ayant traité cette tentative (ex. "pdf-parse", "tesseract.js", "mammoth",
  /// "xlsx") — jamais une clé/secret fournisseur.
  provider          String? @db.VarChar(60)
  providerVersion   String? @map("provider_version") @db.VarChar(30)
  providerRequestId String? @map("provider_request_id") @db.VarChar(120)

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  durationMs Int      @map("duration_ms")

  pageCount      Int?     @map("page_count")
  characterCount Int?     @map("character_count")
  chunkCount     Int?     @map("chunk_count")
  language       String?  @db.VarChar(8)
  warnings       String[] @default([])
  errorCode      String?  @map("error_code") @db.VarChar(60)
  errorMessage   String?  @map("error_message")

  /// Correction P1-05 — deux tentatives identiques pour le même document et le même
  /// `attemptNumber` sont désormais refusées au niveau base : un défaut de coordination
  /// applicative ne peut plus produire un doublon silencieux dans l'historique.
  @@unique([documentId, attemptNumber])
  @@index([organizationId, documentId])
  @@map("extraction_attempts")
}

/// Segment de texte exploitable par la future analyse IA (mission Sprint 3) — jamais un
/// embedding : ce sprint ne branche aucun modèle d'embeddings (hors périmètre explicite).
model ExtractionChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId         String             @map("document_id") @db.Uuid
  documentExtraction DocumentExtraction @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  organizationId     String             @map("organization_id") @db.Uuid

  /// Ordre stable au sein du document — jamais recalculé après coup, toujours réattribué en bloc
  /// par la segmentation qui remplace un jeu de chunks (voir replaceChunks, mission "un retry ne
  /// doit pas dupliquer les chunks").
  sequence     Int
  pageStart    Int?    @map("page_start")
  pageEnd      Int?    @map("page_end")
  sheetName    String? @map("sheet_name") @db.VarChar(120)
  sectionTitle String? @map("section_title") @db.VarChar(300)

  content        String
  characterCount Int    @map("character_count")
  tokenEstimate  Int?   @map("token_estimate")
  checksum       String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, sequence])
  @@index([organizationId, documentId])
  @@map("extraction_chunks")
}

/// Job d'analyse IA (mission Sprint 4.1 — socle technique, aucune analyse métier réelle) — jamais
/// écrasé par un nouveau déclenchement : une nouvelle analyse pour la même cible crée toujours une
/// nouvelle ligne (`analysisVersion` incrémenté), jamais une mise à jour de l'historique existant.
/// Un retry explicite (RetryAnalysisUseCase) réutilise en revanche la MÊME ligne (même version).
model AnalysisJob {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  /// FK composée (tenderId, organizationId) → Tender(id, organizationId) — même motif que
  /// Dce/TenderLot (AUDIT-007).
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Renseignés uniquement pour `scope = 'DOCUMENT'` — jamais pour `scope = 'TENDER'` (voir
  /// contrainte CHECK `analysis_jobs_scope_target_check`, migration).
  dceId String? @map("dce_id") @db.Uuid
  dce   Dce?    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Discriminant polymorphe de cible = `documentId` (scope DOCUMENT) ou `tenderId` (scope TENDER)
  /// — porté en base pour permettre une contrainte d'unicité et un index sur une seule colonne,
  /// jamais des index partiels dépendant du scope. Cohérence garantie par une contrainte CHECK
  /// (migration), jamais uniquement par la discipline applicative.
  targetId String @map("target_id") @db.Uuid

  /// DOCUMENT | TENDER (domain/analysis-scope.ts) — protégé par une contrainte CHECK (migration).
  scope String @db.VarChar(10)

  /// PENDING | QUEUED | PROCESSING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED | CANCELLED
  /// (domain/analysis-status.ts) — protégé par une contrainte CHECK (migration).
  status String @db.VarChar(24)

  /// Nom du provider ayant traité la tentative la plus récente (ex. "OPENAI") — jamais une clé/
  /// secret fournisseur.
  provider String? @db.VarChar(30)
  model    String? @db.VarChar(60)

  /// Numéro de version de CETTE analyse pour sa cible — jamais réutilisé, jamais décrémenté
  /// (mission §"Deux analyses de versions différentes doivent pouvoir coexister").
  analysisVersion   Int     @map("analysis_version")
  promptVersion     Int     @map("prompt_version")
  /// `DocumentAnalysisInput.extractionVersion` au moment de la création (scope DOCUMENT
  /// uniquement) — capturé une fois, jamais recalculé après coup.
  extractionVersion Int?    @map("extraction_version")
  inputChecksum     String? @map("input_checksum") @db.VarChar(64)

  /// Jeton de réservation (compare-and-set, mission §"tentative obsolète") — incrémenté uniquement
  /// par la réservation atomique courte (Phase 1).
  attemptCount Int @default(0) @map("attempt_count")

  /// Rôle de l'acteur ayant déclenché ou (re)lancé la tentative en cours (mission Sprint 4.2) —
  /// nullable pour rester compatible avec les jobs Sprint 4.1 déjà existants (créés avant ce
  /// champ). Jamais un rôle fabriqué : c'est TOUJOURS le rôle réel d'un acteur HTTP authentifié
  /// (StartDocumentAnalysisUseCase/StartTenderAnalysisUseCase/RetryAnalysisUseCase), capturé pour
  /// permettre à `ProcessAnalysisJobUseCase` (traitement en tâche de fond, Phase 2, hors
  /// transaction) de ré-appeler `GetDocumentAnalysisInputUseCase` (contrat public Sprint 3, exige
  /// `ExtractionPermission.Read`) sans jamais inventer un rôle qui n'existe pas dans ce contexte
  /// (même principe que Sprint 3 §"une opération système ne doit jamais dépendre d'un rôle
  /// d'acteur qui n'existe pas dans ce contexte").
  triggeredByRole String? @map("triggered_by_role") @db.VarChar(40)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")

  /// Sortie technique volontairement minimale (mission §"Sortie du provider pour le Sprint 4.1")
  /// — jamais une structure métier détaillée, jamais le contenu complet du corpus analysé.
  resultSummary String? @map("result_summary")
  errorCode     String? @map("error_code") @db.VarChar(60)
  errorMessage  String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @map("updated_at")

  attempts AnalysisAttempt[]

  /// Mission Sprint 4.2 — résultats métier produits par ce job (jamais renseignés pour la
  /// tranche technique placeholder Sprint 4.1, uniquement quand ce job a réellement produit une
  /// analyse métier structurée).
  documentBusinessAnalyses DocumentBusinessAnalysis[]
  deadlineFindings         TenderDeadlineFinding[]
  criterionFindings        TenderCriterionFinding[]
  requirementFindings      TenderRequirementFinding[]
  clauseFindings           TenderClauseFinding[]
  riskFindings             TenderRiskFinding[]
  questionFindings         TenderQuestionFinding[]
  analysisSummaries        TenderAnalysisSummary[]

  /// Une seule version donnée ne peut jamais exister deux fois pour la même cible.
  @@unique([organizationId, scope, targetId, analysisVersion])
  /// Recherche du job actif (non terminal) d'une cible — mission §"double déclenchement".
  @@index([organizationId, targetId, status])
  @@index([organizationId, status])
  @@map("analysis_jobs")
}

/// Trace immuable d'une tentative de traitement d'un `AnalysisJob` (mission Sprint 4.1 —
/// historique append-only, jamais réécrit) : `AnalysisJob` ne porte que l'état courant, chaque
/// réservation laisse ici une ligne distincte.
model AnalysisAttempt {
  id String @id @default(uuid()) @db.Uuid

  jobId String      @map("job_id") @db.Uuid
  job   AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  organizationId String @map("organization_id") @db.Uuid

  attemptNumber Int @map("attempt_number")

  /// MANUAL | RETRY | SYSTEM (domain/analysis-trigger.ts) — protégé par une contrainte CHECK
  /// (migration).
  trigger String @db.VarChar(10)

  provider String? @db.VarChar(30)
  model    String? @db.VarChar(60)

  /// SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED — protégé par une contrainte CHECK (migration).
  outcome String @db.VarChar(20)

  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")
  durationMs Int      @map("duration_ms")

  /// Nombre d'appels provider effectués AU SEIN de cette réservation (politique de retry interne,
  /// mission §"Timeout et retry") — jamais confondu avec `attemptNumber`.
  retryCount Int @default(0) @map("retry_count")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")

  errorCode    String? @map("error_code") @db.VarChar(60)
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  /// Deux tentatives identiques pour le même job et le même `attemptNumber` sont refusées au
  /// niveau base — même motif que `extraction_attempts` (correction P1-05).
  @@unique([jobId, attemptNumber])
  @@index([organizationId, jobId])
  @@map("analysis_attempts")
}

// ---------------------------------------------------------------------------------------------
// Sprint 4.2 — AI Business Analysis
//
// Nommage volontairement distinct de TenderRisk/TenderAwardCriterion/TenderRequestedDocument/
// TenderMilestone (déjà existants ci-dessus, Sprint 2/3, gérés manuellement par l'utilisateur,
// mutables, sans versionnement) : les tables ci-dessous portent le suffixe "Finding" pour ne
// jamais laisser croire qu'il s'agit du même concept. Une trouvaille IA n'écrase jamais un
// enregistrement utilisateur existant et n'est jamais éditée en place — chaque nouvelle analyse
// crée un nouveau jeu de lignes (nouvel `analysisVersion`), l'ancien restant intact pour
// l'historique (mission §"Historisation").
// ---------------------------------------------------------------------------------------------

/// Résultat structuré de l'analyse d'UN document (étape 1 de la mission, "Analyse documentaire")
/// — produit par un `AnalysisJob` de scope DOCUMENT. Intermédiaire : consommé par l'étape 2
/// (consolidation Tender), jamais exposé tel quel par l'API publique (voir `TenderAnalysisSummary`
/// et les tables Finding ci-dessous pour les résultats consolidés réellement exposés).
model DocumentBusinessAnalysis {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  dceId String @map("dce_id") @db.Uuid
  dce   Dce    @relation(fields: [dceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Version de l'extraction Sprint 3 effectivement analysée (`DocumentAnalysisInput.extractionVersion`)
  /// — jamais recalculée après coup, capturée telle que lue au moment de l'analyse.
  extractionVersion Int @map("extraction_version")

  /// RC | CCTP | CCAP | AE | BPU | DPGF | ANNEX | UNKNOWN — classification déterminée par le
  /// modèle IA à partir du contenu réel, distincte de `DceDocument.category` (classification
  /// déterministe Sprint 2 par extension/nom de fichier, voir dce-document-classifier.ts) :
  /// jamais fusionnées, jamais l'une n'écrase l'autre. Protégée par une contrainte CHECK (migration).
  documentType String @map("document_type") @db.VarChar(20)
  /// Langue détectée du document (mission §"Langues" — fr/en au minimum) — les citations
  /// conservent cette langue, jamais traduites.
  language     String @db.VarChar(8)

  /// Informations générales (mission §1) — objet technique minimal, jamais dupliqué dans des
  /// colonnes dédiées : ce résultat est un intermédiaire consommé par la consolidation (étape 2),
  /// jamais lu directement par l'API publique.
  metadata     Json     @default("{}")
  /// Tableaux de `DocumentDeadlineFinding`/`DocumentCriterionFinding`/... (mission §2-5), au format
  /// validé par `document-analysis-output.schema.ts` avant persistance — jamais un JSON brut non
  /// validé (mission §"Sorties structurées").
  deadlines    Json     @default("[]")
  criteria     Json     @default("[]")
  requirements Json     @default("[]")
  clauses      Json     @default("[]")
  warnings     String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, documentId, analysisVersion])
  @@index([organizationId, tenderId])
  @@map("document_business_analyses")
}

/// Provenance commune à toutes les tables Finding ci-dessous (mission §"Provenance obligatoire")
/// — `documentId`/`chunkSequence` ne portent jamais de contrainte FK stricte : ce sont des
/// affirmations du modèle IA, vérifiées applicativement (le chunk cité doit réellement exister
/// parmi les chunks fournis en entrée) avant persistance, jamais une garantie base de données
/// (une trouvaille reste consultable même si le document source est supprimé plus tard).

/// Échéance consolidée (mission §2 "Dates et échéances").
model TenderDeadlineFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  /// PUBLICATION | SUBMISSION | QUESTIONS | ANSWER | VISIT | START_ESTIMATED | VALIDITY_PERIOD |
  /// INTERMEDIATE | CONTRACTUAL | OTHER — protégée par une contrainte CHECK (migration).
  kind    String    @db.VarChar(30)
  label   String    @db.VarChar(300)
  /// Normalisée (mission §"Chaque date doit être normalisée dans un format stable") — absente
  /// uniquement si le texte source ne permet aucune normalisation fiable (`rawText` porte alors
  /// le texte brut, jamais une date devinée).
  date    DateTime?
  rawText String?   @map("raw_text")

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  /// Mission §"Si une information est déduite, indiquer explicitement qu'il s'agit d'une
  /// inférence" — jamais une déduction présentée comme une citation directe.
  isInferred    Boolean @default(false) @map("is_inferred")
  /// Score de confiance déclaré par le modèle (mission §"Score de confiance") — jamais utilisé
  /// seul, voir les validations déterministes appliquées par `TenderConsolidationOutputSchema`
  /// avant persistance.
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_deadline_findings")
}

/// Critère d'attribution consolidé (mission §3 "Critères d'attribution").
model TenderCriterionFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  name          String  @db.VarChar(300)
  /// Pondération en pourcentage (0-100) — nullable : certains documents ne chiffrent pas
  /// systématiquement la pondération (mission §"Vérifier autant que possible... total proche de
  /// 100 %" — appliqué au niveau de la consolidation, jamais bloquant pour un seul critère).
  weight        Float?
  /// Sous-critères `[{ name, weight }]` — jamais une table séparée : toujours lus/écrits comme un
  /// tout avec leur critère parent, jamais interrogés indépendamment.
  subCriteria   Json?   @map("sub_criteria")
  scoringMethod String? @map("scoring_method")
  priceFormula  String? @map("price_formula")
  threshold     String?
  isEliminatory Boolean @default(false) @map("is_eliminatory")

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_criterion_findings")
}

/// Exigence / pièce demandée consolidée (mission §4 "Exigences et pièces demandées").
model TenderRequirementFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  /// ADMINISTRATIVE | TECHNICAL_MEMO | REFERENCES | CV | CERTIFICATION | INSURANCE |
  /// FINANCIAL_CAPACITY | TECHNICAL_CAPACITY | HUMAN_RESOURCES | MATERIAL_RESOURCES | METHODOLOGY |
  /// PLANNING | SIGNATURE | OTHER — protégée par une contrainte CHECK (migration).
  category       String  @db.VarChar(30)
  label          String  @db.VarChar(300)
  expectedFormat String? @map("expected_format")
  isMandatory    Boolean @default(true) @map("is_mandatory")

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_requirement_findings")
}

/// Clause contractuelle consolidée (mission §5 "Clauses contractuelles").
model TenderClauseFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  /// PENALTY | WARRANTY | INSURANCE | DEADLINE | CONFIDENTIALITY | IP | SECURITY | CYBERSECURITY |
  /// REVERSIBILITY | SUBCONTRACTING | CONSORTIUM | ADVANCE_PAYMENT | RETENTION_GUARANTEE | PAYMENT |
  /// INVOICING | TERMINATION | RENEWAL | LIABILITY | GDPR | HOSTING | ENVIRONMENTAL_SOCIAL | OTHER
  /// — protégée par une contrainte CHECK (migration).
  category String @db.VarChar(30)
  summary  String

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_clause_findings")
}

/// Risque détecté par l'IA (mission §6 "Risques") — distinct de `TenderRisk` (Sprint 2/3, géré
/// manuellement par l'utilisateur, mutable, sans provenance ni score de confiance).
model TenderRiskFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  title          String @db.VarChar(300)
  category       String @db.VarChar(60)
  /// LOW | MEDIUM | HIGH | CRITICAL — protégée par une contrainte CHECK (migration).
  severity       String @db.VarChar(20)
  probability    Float?
  explanation    String
  recommendation String

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@index([organizationId, tenderId, severity])
  @@map("tender_risk_findings")
}

/// Question à poser à l'acheteur, générée par l'IA (mission §7 "Questions à poser à l'acheteur").
model TenderQuestionFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  question      String
  justification String
  /// LOW | MEDIUM | HIGH — protégée par une contrainte CHECK (migration).
  priority      String @db.VarChar(20)
  theme         String @db.VarChar(120)

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_question_findings")
}

/// Synthèse métier structurée (mission §8 "Synthèse métier structurée") — une ligne par tender et
/// par version d'analyse consolidée, jamais écrasée par la version suivante.
model TenderAnalysisSummary {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  opportunitySummary String @map("opportunity_summary")
  /// LOW | MEDIUM | HIGH — protégée par une contrainte CHECK (migration).
  complexityLevel    String @map("complexity_level") @db.VarChar(20)

  mainCriteria    Json @default("[]") @map("main_criteria")
  mainRisks       Json @default("[]") @map("main_risks")
  mainObligations Json @default("[]") @map("main_obligations")
  missingElements Json @default("[]") @map("missing_elements")
  pointsToClarify Json @default("[]") @map("points_to_clarify")
  /// Contradictions détectées entre documents (mission §"TenderAnalysisConflict") — repliées ici
  /// plutôt qu'une table séparée : toujours lues avec la synthèse qui les explique, jamais
  /// interrogées indépendamment (structure plus cohérente pour cette tranche, voir rapport §B).
  conflicts       Json @default("[]")

  /// GO | GO_WITH_RESERVATIONS | NO_GO | INSUFFICIENT_DATA — protégée par une contrainte CHECK
  /// (migration). Mission §"IMPORTANT" : une aide à la décision, JAMAIS une décision automatique
  /// définitive — porté explicitement par `goNoGoRationale` et par le frontend (mise en garde
  /// affichée systématiquement à côté de cette valeur).
  goNoGoRecommendation String @map("go_no_go_recommendation") @db.VarChar(30)
  goNoGoRationale      String @map("go_no_go_rationale")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, tenderId, analysisVersion])
  @@map("tender_analysis_summaries")
}

/// Espace de connaissances organisationnel (mission Sprint 5 §1) — un seul espace principal par
/// organisation dans cette tranche (`(organizationId, name)` unique, résolu de manière idempotente
/// par `GetOrCreateDefaultKnowledgeSpaceUseCase`), architecture prête pour une extension future vers
/// plusieurs espaces nommés sans migration de rupture.
model KnowledgeSpace {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String  @db.VarChar(200)
  description String?
  /// ACTIVE | ARCHIVED — protégée par une contrainte CHECK (migration).
  status      String  @default("ACTIVE") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries KnowledgeEntry[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("knowledge_spaces")
}

/// Entrée de connaissance (mission Sprint 5 §2) — peut exister sans document (MANUAL, READY
/// immédiat) ou être adossée à un import (DOCUMENT_IMPORT, DRAFT puis transite via
/// KnowledgeDocument). `category`/`sourceType`/`status` sont typés et validés côté domaine, jamais
/// une chaîne libre non contrôlée (protégés par des contraintes CHECK, migration).
model KnowledgeEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeSpaceId String         @map("knowledge_space_id") @db.Uuid
  knowledgeSpace   KnowledgeSpace @relation(fields: [knowledgeSpaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// NULL = connaissance GLOBALE de l'organisation (visible selon le rôle d'organisation, jamais
  /// filtrée par client) ; renseigné = connaissance SPÉCIFIQUE à un client (mission Sprint 5.1
  /// §"Knowledge Base" — visible uniquement aux acteurs ayant accès à ce client). Jamais de
  /// bascule global → client ni l'inverse après création (mission §"validation stricte de
  /// cohérence") — non modifiable par `UpdateKnowledgeEntryUseCase`.
  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  title       String  @db.VarChar(500)
  description String?
  category    String  @db.VarChar(40)
  sourceType  String  @map("source_type") @db.VarChar(30)
  status      String  @db.VarChar(20)
  language    String? @db.VarChar(8)
  /// Validé par `application/schemas/metadata` selon `category` avant persistance (mission §5
  /// "Toute donnée JSON doit être validée") — jamais un JSON brut non contrôlé.
  metadata    Json    @default("{}")

  /// Version active de cette entrée (mission §10) — incrémentée uniquement par les mutations
  /// substantielles, jamais par un ajout/retrait de tag.
  activeVersionNumber Int @default(1) @map("active_version_number")

  createdByUserId String  @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  versions  KnowledgeEntryVersion[]
  documents KnowledgeDocument[]
  entryTags KnowledgeEntryTag[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, title])
  /// Filtre "client" (mission Sprint 5.1) — entrées d'un client donné ; `clientAccountId IS NULL`
  /// (via l'index partiel équivalent côté requêtes) sert au filtre "connaissances globales".
  @@index([organizationId, clientAccountId])
  @@map("knowledge_entries")
}

/// Version immuable d'une entrée (mission Sprint 5 §10 "Versionnement") — même motif que
/// `DocumentVersion` : aucune mutation possible après création, une restauration crée toujours une
/// NOUVELLE ligne (voir `RestoreKnowledgeVersionUseCase`), jamais un rollback destructif.
model KnowledgeEntryVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  versionNumber Int     @map("version_number")
  /// Motif court facultatif (mission §10 "motif éventuel") — ex. "Métadonnées mises à jour",
  /// "Nouveau document importé", "Restauration de la version 2".
  reason        String?
  /// Instantané des champs métier au moment de cette version (title/description/category/
  /// language/metadata/knowledgeDocumentId) — jamais un diff, un instantané complet.
  snapshot      Json

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([organizationId, knowledgeEntryId, versionNumber])
  @@map("knowledge_entry_versions")
}

/// Document lié à une entrée (mission Sprint 5 §6/§7) — porte SON PROPRE cycle de traitement,
/// jamais partagé avec le module Extraction (Sprint 3, intrinsèquement lié à un DCE) : le fichier
/// physique lui-même reste stocké par le module Documents (`documentId`, `domain: KNOWLEDGE`),
/// jamais dupliqué ici.
model KnowledgeDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Version de l'entrée à laquelle ce document appartient (mission §10) — un document remplacé
  /// crée une nouvelle ligne rattachée à la nouvelle version, jamais une mise à jour en place.
  versionNumber Int      @map("version_number")
  /// PENDING | PROCESSING | READY | PARTIALLY_READY | FAILED — protégée par une contrainte CHECK
  /// (migration).
  status        String   @db.VarChar(20)
  language      String?  @db.VarChar(8)
  warnings      String[] @default([])
  errorMessage  String?  @map("error_message")
  /// Jeton de réservation (même motif que `DocumentExtraction.attemptCount`, module Extraction).
  attemptCount  Int      @default(0) @map("attempt_count")

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@unique([id, organizationId])
  @@index([organizationId, knowledgeEntryId])
  @@index([organizationId, documentId])
  @@map("knowledge_documents")
}

/// Segment de texte exploitable par la recherche (mission Sprint 5 §7/§8) — même motif que
/// `ExtractionChunk` (module Extraction), volontairement une table DISTINCTE : jamais de dépendance
/// vers un `DocumentExtraction` lié à un DCE/Tender. `knowledgeEntryId` est dénormalisé (redondant
/// avec `knowledgeDocument.knowledgeEntryId`) uniquement pour indexer "tous les chunks d'une
/// entrée" sans jointure — jamais une source de vérité indépendante.
model KnowledgeChunk {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  knowledgeEntryId String @map("knowledge_entry_id") @db.Uuid

  knowledgeDocumentId String            @map("knowledge_document_id") @db.Uuid
  knowledgeDocument   KnowledgeDocument @relation(fields: [knowledgeDocumentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sequence       Int
  pageStart      Int?    @map("page_start")
  pageEnd        Int?    @map("page_end")
  sheetName      String? @map("sheet_name") @db.VarChar(120)
  sectionTitle   String? @map("section_title") @db.VarChar(300)
  content        String
  characterCount Int     @map("character_count")
  tokenEstimate  Int?    @map("token_estimate")
  checksum       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, knowledgeEntryId])
  @@index([organizationId, knowledgeDocumentId, sequence])
  @@map("knowledge_chunks")
}

/// Tag d'organisation (mission Sprint 5 §4) — `label` normalisé porte l'unicité tenant-aware ("pas
/// de doublons liés à la casse"), `displayLabel` ne sert qu'à l'affichage.
model KnowledgeTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  label        String @db.VarChar(60)
  displayLabel String @map("display_label") @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at")

  entryTags KnowledgeEntryTag[]

  @@unique([organizationId, label])
  @@unique([id, organizationId])
  @@map("knowledge_tags")
}

/// Association plusieurs-à-plusieurs entrée/tag (mission §4) — la suppression d'un tag (cascade)
/// ne supprime jamais l'entrée elle-même, seulement cette association.
model KnowledgeEntryTag {
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  tagId String       @map("tag_id") @db.Uuid
  tag   KnowledgeTag @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([knowledgeEntryId, tagId])
  @@index([organizationId, tagId])
  @@map("knowledge_entry_tags")
}

/// Client géré par l'organisation (mission Sprint 5.1 §"Client Portfolio Management") — un cabinet
/// de conseil/ESN/AMO gère plusieurs clients ; `Organization` reste le tenant principal,
/// `ClientAccount` représente CHACUN de ses clients. `nameNormalized` porte l'unicité tenant-aware
/// (même motif que `KnowledgeTag.label` — jamais deux clients au nom identique à la casse près).
model ClientAccount {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String  @db.VarChar(200)
  nameNormalized String  @map("name_normalized") @db.VarChar(200)
  legalName      String? @map("legal_name") @db.VarChar(240)
  reference      String? @db.VarChar(100)
  sector         String? @db.VarChar(120)
  country        String? @db.VarChar(10)
  address        String?
  website        String? @db.VarChar(2048)
  notes          String?

  /// ACTIVE | INACTIVE | ARCHIVED — protégée par une contrainte CHECK (migration).
  status String @db.VarChar(20)

  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  assignments      ClientAssignment[]
  tenders          Tender[]
  knowledgeEntries KnowledgeEntry[]

  @@unique([id, organizationId])
  @@unique([organizationId, nameNormalized])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@map("client_accounts")
}

/// Affectation d'un utilisateur à un client (mission Sprint 5.1) — porte le rôle CLIENT, distinct
/// et complémentaire du rôle d'organisation (`OrganizationMembership.role`, prioritaire — voir
/// `ClientAccessPolicy`). Un utilisateur ne peut avoir qu'UNE SEULE affectation par client
/// (contrainte unique ci-dessous) — la modifier remplace le rôle, jamais une seconde ligne.
model ClientAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// CLIENT_MANAGER | CONTRIBUTOR | VIEWER — protégée par une contrainte CHECK (migration).
  role String @db.VarChar(30)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, clientAccountId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, clientAccountId])
  @@map("client_assignments")
}
