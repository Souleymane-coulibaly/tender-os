/// Question à poser à l'acheteur, générée par l'IA (mission §7 "Questions à poser à l'acheteur").
model TenderQuestionFinding {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  question      String
  justification String
  /// LOW | MEDIUM | HIGH — protégée par une contrainte CHECK (migration).
  priority      String @db.VarChar(20)
  theme         String @db.VarChar(120)

  documentId    String? @map("document_id") @db.Uuid
  chunkSequence Int?    @map("chunk_sequence")
  pageStart     Int?    @map("page_start")
  pageEnd       Int?    @map("page_end")
  sheetName     String? @map("sheet_name") @db.VarChar(120)
  sectionTitle  String? @map("section_title") @db.VarChar(300)
  citation      String? @db.VarChar(500)
  isInferred    Boolean @default(false) @map("is_inferred")
  confidence    Float   @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, tenderId, analysisVersion])
  @@map("tender_question_findings")
}

/// Synthèse métier structurée (mission §8 "Synthèse métier structurée") — une ligne par tender et
/// par version d'analyse consolidée, jamais écrasée par la version suivante.
model TenderAnalysisSummary {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  tenderId        String      @map("tender_id") @db.Uuid
  tender          Tender      @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  analysisJobId   String      @map("analysis_job_id") @db.Uuid
  analysisJob     AnalysisJob @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  analysisVersion Int         @map("analysis_version")

  opportunitySummary String @map("opportunity_summary")
  /// LOW | MEDIUM | HIGH — protégée par une contrainte CHECK (migration).
  complexityLevel    String @map("complexity_level") @db.VarChar(20)

  mainCriteria    Json @default("[]") @map("main_criteria")
  mainRisks       Json @default("[]") @map("main_risks")
  mainObligations Json @default("[]") @map("main_obligations")
  missingElements Json @default("[]") @map("missing_elements")
  pointsToClarify Json @default("[]") @map("points_to_clarify")
  /// Contradictions détectées entre documents (mission §"TenderAnalysisConflict") — repliées ici
  /// plutôt qu'une table séparée : toujours lues avec la synthèse qui les explique, jamais
  /// interrogées indépendamment (structure plus cohérente pour cette tranche, voir rapport §B).
  conflicts       Json @default("[]")

  /// GO | GO_WITH_RESERVATIONS | NO_GO | INSUFFICIENT_DATA — protégée par une contrainte CHECK
  /// (migration). Mission §"IMPORTANT" : une aide à la décision, JAMAIS une décision automatique
  /// définitive — porté explicitement par `goNoGoRationale` et par le frontend (mise en garde
  /// affichée systématiquement à côté de cette valeur).
  goNoGoRecommendation String @map("go_no_go_recommendation") @db.VarChar(30)
  goNoGoRationale      String @map("go_no_go_rationale")

  createdAt DateTime @default(now()) @map("created_at")

  /// V2 Sprint 4 — révisions utilisateur éditant cette synthèse SANS jamais la muter elle-même
  /// (immuable, comme le reste de l'analyse versionnée).
  revisions TenderAnalysisSummaryRevision[]

  @@unique([organizationId, tenderId, analysisVersion])
  /// V2 Sprint 4 (AUDIT-007) — support de la FK composée depuis TenderAnalysisSummaryRevision.
  @@unique([id, organizationId])
  @@map("tender_analysis_summaries")
}

/// V2 Sprint 4 — révision utilisateur d'une synthèse IA (`TenderAnalysisSummary`), qui reste
/// immuable et versionnée par analysisVersion. Seuls les champs effectivement corrigés par
/// l'utilisateur sont renseignés ici (jamais une copie complète) ; la lecture retombe sur la
/// valeur IA d'origine pour tout champ NULL. Une nouvelle correction crée toujours une NOUVELLE
/// révision, jamais une mutation d'une révision existante — historique complet conservé.
model TenderAnalysisSummaryRevision {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  tenderId       String                @map("tender_id") @db.Uuid
  tender         Tender                @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  baseSummaryId  String                @map("base_summary_id") @db.Uuid
  baseSummary    TenderAnalysisSummary @relation(fields: [baseSummaryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revisionNumber Int                   @map("revision_number")

  opportunitySummary String? @map("opportunity_summary")
  /// LOW | MEDIUM | HIGH si renseigné — CHECK (migration).
  complexityLevel    String? @map("complexity_level") @db.VarChar(20)
  mainCriteria       Json?   @map("main_criteria")
  mainRisks          Json?   @map("main_risks")
  mainObligations    Json?   @map("main_obligations")
  missingElements    Json?   @map("missing_elements")
  pointsToClarify    Json?   @map("points_to_clarify")
  conflicts          Json?

  editedByUserId String   @map("edited_by_user_id") @db.Uuid
  editedAt       DateTime @default(now()) @map("edited_at")
  reason         String?

  @@unique([organizationId, baseSummaryId, revisionNumber])
  @@index([organizationId, tenderId])
  @@map("tender_analysis_summary_revisions")
}

/// Espace de connaissances organisationnel (mission Sprint 5 §1) — un seul espace principal par
/// organisation dans cette tranche (`(organizationId, name)` unique, résolu de manière idempotente
/// par `GetOrCreateDefaultKnowledgeSpaceUseCase`), architecture prête pour une extension future vers
/// plusieurs espaces nommés sans migration de rupture.
model KnowledgeSpace {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String  @db.VarChar(200)
  description String?
  /// ACTIVE | ARCHIVED — protégée par une contrainte CHECK (migration).
  status      String  @default("ACTIVE") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries KnowledgeEntry[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("knowledge_spaces")
}

/// Entrée de connaissance (mission Sprint 5 §2) — peut exister sans document (MANUAL, READY
/// immédiat) ou être adossée à un import (DOCUMENT_IMPORT, DRAFT puis transite via
/// KnowledgeDocument). `category`/`sourceType`/`status` sont typés et validés côté domaine, jamais
/// une chaîne libre non contrôlée (protégés par des contraintes CHECK, migration).
model KnowledgeEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeSpaceId String         @map("knowledge_space_id") @db.Uuid
  knowledgeSpace   KnowledgeSpace @relation(fields: [knowledgeSpaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// NULL = connaissance GLOBALE de l'organisation (visible selon le rôle d'organisation, jamais
  /// filtrée par client) ; renseigné = connaissance SPÉCIFIQUE à un client (mission Sprint 5.1
  /// §"Knowledge Base" — visible uniquement aux acteurs ayant accès à ce client). Jamais de
  /// bascule global → client ni l'inverse après création (mission §"validation stricte de
  /// cohérence") — non modifiable par `UpdateKnowledgeEntryUseCase`.
  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  title       String  @db.VarChar(500)
  description String?
  category    String  @db.VarChar(40)
  sourceType  String  @map("source_type") @db.VarChar(30)
  status      String  @db.VarChar(20)
  language    String? @db.VarChar(8)
  /// Validé par `application/schemas/metadata` selon `category` avant persistance (mission §5
  /// "Toute donnée JSON doit être validée") — jamais un JSON brut non contrôlé.
  metadata    Json    @default("{}")

  /// Version active de cette entrée (mission §10) — incrémentée uniquement par les mutations
  /// substantielles, jamais par un ajout/retrait de tag.
  activeVersionNumber Int @default(1) @map("active_version_number")

  /// V2 Sprint 8 — validation humaine (mission §15/§16), ORTHOGONALE au `status` pipeline
  /// ci-dessus : dénormalise "la version ACTIVE est-elle validée" pour un filtrage bon marché
  /// (recherche/liste, préparation RAG Sprint 9). Toute mutation substantielle (nouvelle version)
  /// RÉINITIALISE ces deux champs à NULL — jamais un héritage automatique de confiance, même pour
  /// un contenu IA (mission §16 "jamais automatiquement validée"). La vérité historique par
  /// version vit sur `KnowledgeEntryVersion` ci-dessous (mission §71/72 : une ancienne version
  /// validée le reste, même après qu'une nouvelle version soit créée).
  validatedByUserId String?   @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime? @map("validated_at")

  /// V2 Sprint 8 — provenance (mission §18), renseignée uniquement par `PromoteChecklistItemToKnowledgeUseCase`
  /// (jamais imposable par le client — reconstruite côté serveur). `sourceType` ci-dessus continue
  /// de gouverner LE MÉCANISME (upload vs saisie manuelle) ; ces champs répondent à "d'où vient
  /// cette entrée" sans dupliquer une taxonomie parallèle.
  sourceTenderId          String?   @map("source_tender_id") @db.Uuid
  sourceChecklistItemId   String?   @map("source_checklist_item_id") @db.Uuid
  sourceDocumentId        String?   @map("source_document_id") @db.Uuid
  sourceDocumentVersionId String?   @map("source_document_version_id") @db.Uuid
  promotedByUserId        String?   @map("promoted_by_user_id") @db.Uuid
  promotedAt              DateTime? @map("promoted_at")

  createdByUserId String  @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  versions  KnowledgeEntryVersion[]
  documents KnowledgeDocument[]
  entryTags KnowledgeEntryTag[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, title])
  /// Filtre "client" (mission Sprint 5.1) — entrées d'un client donné ; `clientAccountId IS NULL`
  /// (via l'index partiel équivalent côté requêtes) sert au filtre "connaissances globales".
  @@index([organizationId, clientAccountId])
  /// V2 Sprint 8 — filtre "validées uniquement" (préparation RAG Sprint 9, mission §31).
  @@index([organizationId, validatedAt])
  @@map("knowledge_entries")
}

/// Version immuable d'une entrée (mission Sprint 5 §10 "Versionnement") — même motif que
/// `DocumentVersion` : aucune mutation possible après création, une restauration crée toujours une
/// NOUVELLE ligne (voir `RestoreKnowledgeVersionUseCase`), jamais un rollback destructif.
model KnowledgeEntryVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  versionNumber Int     @map("version_number")
  /// Motif court facultatif (mission §10 "motif éventuel") — ex. "Métadonnées mises à jour",
  /// "Nouveau document importé", "Restauration de la version 2".
  reason        String?
  /// Instantané des champs métier au moment de cette version (title/description/category/
  /// language/metadata/knowledgeDocumentId) — jamais un diff, un instantané complet.
  snapshot      Json

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  /// V2 Sprint 8 — vérité historique de validation POUR CETTE VERSION PRÉCISE (mission §71/72) :
  /// jamais mutée après coup sauf par `ValidateKnowledgeEntryUseCase` ciblant la version ACTIVE au
  /// moment de l'appel (voir `KnowledgeEntry.validatedAt`, dénormalisation de ce champ pour la
  /// version active). Une ancienne version validée le reste pour toujours, même quand une version
  /// plus récente est créée puis validée à son tour.
  validatedByUserId String?   @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime? @map("validated_at")

  @@unique([organizationId, knowledgeEntryId, versionNumber])
  @@map("knowledge_entry_versions")
}

/// Document lié à une entrée (mission Sprint 5 §6/§7) — porte SON PROPRE cycle de traitement,
/// jamais partagé avec le module Extraction (Sprint 3, intrinsèquement lié à un DCE) : le fichier
/// physique lui-même reste stocké par le module Documents (`documentId`, `domain: KNOWLEDGE`),
/// jamais dupliqué ici.
model KnowledgeDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Version de l'entrée à laquelle ce document appartient (mission §10) — un document remplacé
  /// crée une nouvelle ligne rattachée à la nouvelle version, jamais une mise à jour en place.
  versionNumber Int      @map("version_number")
  /// PENDING | PROCESSING | READY | PARTIALLY_READY | FAILED — protégée par une contrainte CHECK
  /// (migration).
  status        String   @db.VarChar(20)
  language      String?  @db.VarChar(8)
  warnings      String[] @default([])
  errorMessage  String?  @map("error_message")
  /// Jeton de réservation (même motif que `DocumentExtraction.attemptCount`, module Extraction).
  attemptCount  Int      @default(0) @map("attempt_count")

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@unique([id, organizationId])
  @@index([organizationId, knowledgeEntryId])
  @@index([organizationId, documentId])
  @@map("knowledge_documents")
}

/// Segment de texte exploitable par la recherche (mission Sprint 5 §7/§8) — même motif que
/// `ExtractionChunk` (module Extraction), volontairement une table DISTINCTE : jamais de dépendance
/// vers un `DocumentExtraction` lié à un DCE/Tender. `knowledgeEntryId` est dénormalisé (redondant
/// avec `knowledgeDocument.knowledgeEntryId`) uniquement pour indexer "tous les chunks d'une
/// entrée" sans jointure — jamais une source de vérité indépendante.
model KnowledgeChunk {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  knowledgeEntryId String @map("knowledge_entry_id") @db.Uuid

  knowledgeDocumentId String            @map("knowledge_document_id") @db.Uuid
  knowledgeDocument   KnowledgeDocument @relation(fields: [knowledgeDocumentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sequence       Int
  pageStart      Int?    @map("page_start")
  pageEnd        Int?    @map("page_end")
  sheetName      String? @map("sheet_name") @db.VarChar(120)
  sectionTitle   String? @map("section_title") @db.VarChar(300)
  content        String
  characterCount Int     @map("character_count")
  tokenEstimate  Int?    @map("token_estimate")
  checksum       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, knowledgeEntryId])
  @@index([organizationId, knowledgeDocumentId, sequence])
  @@map("knowledge_chunks")
}

/// Tag d'organisation (mission Sprint 5 §4) — `label` normalisé porte l'unicité tenant-aware ("pas
/// de doublons liés à la casse"), `displayLabel` ne sert qu'à l'affichage.
model KnowledgeTag {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  label        String @db.VarChar(60)
  displayLabel String @map("display_label") @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at")

  entryTags KnowledgeEntryTag[]

  @@unique([organizationId, label])
  @@unique([id, organizationId])
  @@map("knowledge_tags")
}

/// Association plusieurs-à-plusieurs entrée/tag (mission §4) — la suppression d'un tag (cascade)
/// ne supprime jamais l'entrée elle-même, seulement cette association.
model KnowledgeEntryTag {
  organizationId String @map("organization_id") @db.Uuid

  knowledgeEntryId String         @map("knowledge_entry_id") @db.Uuid
  knowledgeEntry   KnowledgeEntry @relation(fields: [knowledgeEntryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  tagId String       @map("tag_id") @db.Uuid
  tag   KnowledgeTag @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([knowledgeEntryId, tagId])
  @@index([organizationId, tagId])
  @@map("knowledge_entry_tags")
}

/// Client géré par l'organisation (mission Sprint 5.1 §"Client Portfolio Management") — un cabinet
/// de conseil/ESN/AMO gère plusieurs clients ; `Organization` reste le tenant principal,
/// `ClientAccount` représente CHACUN de ses clients. `nameNormalized` porte l'unicité tenant-aware
/// (même motif que `KnowledgeTag.label` — jamais deux clients au nom identique à la casse près).
model ClientAccount {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String  @db.VarChar(200)
  nameNormalized String  @map("name_normalized") @db.VarChar(200)
  legalName      String? @map("legal_name") @db.VarChar(240)
  reference      String? @db.VarChar(100)
  sector         String? @db.VarChar(120)
  country        String? @db.VarChar(10)
  address        String?
  website        String? @db.VarChar(2048)
  notes          String?

  /// ACTIVE | INACTIVE | ARCHIVED — protégée par une contrainte CHECK (migration).
  status String @db.VarChar(20)

  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  assignments            ClientAssignment[]
  tenders                Tender[]
  knowledgeEntries       KnowledgeEntry[]
  generations            Generation[]
  pricingEstimates       PricingEstimate[]
  exportJobs             ExportJob[]
  validationRuns         ValidationRun[]
  finalApprovals         FinalApproval[]
  signatureRequirements  SignatureRequirement[]
  signatories            Signatory[]
  signatureTransactions  SignatureTransaction[]
  submissionPackages     SubmissionPackage[]
  deliverables           Deliverable[]
  deliverableTemplates   DeliverableTemplate[]
  documentThemes         DocumentTheme[]
  administrativeDossiers AdministrativeDossier[]
  generatedDocuments     GeneratedDocument[]
  /// V2 Sprint 5 — Opportunities de préqualification rattachées à ce candidat, avant même la
  /// création d'un Tender.
  opportunities          Opportunity[]

  // V2 Sprint 2 — satellites additifs "Entreprise candidate" (aucun champ de ClientAccount modifié).
  legalIdentity        CompanyLegalIdentity?
  representatives      CompanyRepresentative[]
  bankAccounts         CompanyBankAccount[]
  insurances           CompanyInsurance[]
  certifications       CompanyCertification[]
  references           CompanyReference[]
  humanResources       CompanyHumanResource[]
  materialResources    CompanyMaterialResource[]
  documentAssociations DocumentClientAccountAssociation[]

  /// V2 Sprint 9 (Chat IA conversationnel) — conversations dénormalisées sur ce client au moment
  /// de leur création (voir `Conversation.clientAccountId`), jamais réaffectées.
  conversations Conversation[]

  @@unique([id, organizationId])
  @@unique([organizationId, nameNormalized])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@map("client_accounts")
}

/// Affectation d'un utilisateur à un client (mission Sprint 5.1) — porte le rôle CLIENT, distinct
/// et complémentaire du rôle d'organisation (`OrganizationMembership.role`, prioritaire — voir
/// `ClientAccessPolicy`). Un utilisateur ne peut avoir qu'UNE SEULE affectation par client
/// (contrainte unique ci-dessous) — la modifier remplace le rôle, jamais une seconde ligne.
model ClientAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// CLIENT_MANAGER | CONTRIBUTOR | VIEWER — protégée par une contrainte CHECK (migration).
  role String @db.VarChar(30)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, clientAccountId, userId])
  @@index([organizationId, userId])
  @@index([organizationId, clientAccountId])
  @@map("client_assignments")
}

/// Registre global des modèles IA autorisés (Sprint 5.2 §"Registre des modèles") — jamais scopé à
/// une organisation : lecture partagée par toutes, mutation réservée à OWNER/ORGANIZATION_ADMIN
/// (voir AiBenchmarkPermission). Le couple (provider, modelKey) doit appartenir à la liste blanche
/// applicative `ALLOWED_MODEL_CATALOG` avant toute création — jamais un identifiant arbitraire
/// fourni par le frontend.
model AiModel {
  id String @id @default(uuid()) @db.Uuid

  /// OPENAI | ANTHROPIC | MISTRAL | AZURE_OPENAI (analysis/domain/analysis-provider.ts, réutilisé).
  provider String @db.VarChar(30)
  modelKey String @map("model_key") @db.VarChar(60)

  displayName String @map("display_name") @db.VarChar(200)

  /// ENABLED | DISABLED — protégée par une contrainte CHECK (migration).
  status String @default("ENABLED") @db.VarChar(10)

  capabilitiesStructuredOutput Boolean @default(false) @map("capabilities_structured_output")
  capabilitiesToolCalling      Boolean @default(false) @map("capabilities_tool_calling")
  capabilitiesVision           Boolean @default(false) @map("capabilities_vision")

  maxContextTokens Int? @map("max_context_tokens")

  /// Indépendants l'un de l'autre (mission §"un modèle benchmark-only ne doit pas être utilisé en
  /// production" / "un modèle production-only peut être exclu des benchmarks") — jamais déduits.
  enabledForBenchmark  Boolean @default(false) @map("enabled_for_benchmark")
  enabledForProduction Boolean @default(false) @map("enabled_for_production")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pricingSnapshots AiModelPricingSnapshot[]
  runModels        BenchmarkRunModel[]

  @@unique([provider, modelKey])
  @@index([status])
  @@map("ai_models")
}

/// Tarif d'un AiModel valable sur une période (Sprint 5.2 §"Les tarifs doivent être versionnés ou
/// configurables" + "une mise à jour de tarif ne doit pas modifier rétroactivement les coûts
/// historiques") — immuable une fois `effectiveTo` renseigné. Au plus UN snapshot courant
/// (`effectiveTo IS NULL`) par modèle, garanti par un index unique partiel (migration) — jamais
/// uniquement par la discipline applicative.
model AiModelPricingSnapshot {
  id String @id @default(uuid()) @db.Uuid

  aiModelId String  @map("ai_model_id") @db.Uuid
  aiModel   AiModel @relation(fields: [aiModelId], references: [id], onDelete: Cascade)

  inputPricePerMillionTokens  Decimal @map("input_price_per_million_tokens") @db.Decimal(12, 6)
  outputPricePerMillionTokens Decimal @map("output_price_per_million_tokens") @db.Decimal(12, 6)
  currency                    String  @db.VarChar(3)

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  runModels BenchmarkRunModel[]

  @@index([aiModelId, effectiveFrom])
  @@map("ai_model_pricing_snapshots")
}

/// Suite de benchmark versionnée (Sprint 5.2 §"Corpus de benchmark") — globale (corpus strictement
/// synthétique, jamais de donnée tenant réelle, voir BenchmarkCase). Toujours liée à exactement UN
/// PromptKey réel du module Analysis (ANALYZE_DOCUMENT | CONSOLIDATE_TENDER_ANALYSIS) — décision de
/// granularité de routing déjà validée : jamais une tâche métier fine. Immuable une fois PUBLISHED —
/// toute évolution crée une nouvelle version (nouvelle ligne), jamais une réécriture.
model BenchmarkSuite {
  id String @id @default(uuid()) @db.Uuid

  name    String @db.VarChar(200)
  version Int

  /// ANALYZE_DOCUMENT | CONSOLIDATE_TENDER_ANALYSIS — protégée par une contrainte CHECK (migration).
  promptKey String @map("prompt_key") @db.VarChar(40)

  /// DRAFT | PUBLISHED — protégée par une contrainte CHECK (migration).
  status String @default("DRAFT") @db.VarChar(10)

  description String?

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cases BenchmarkCase[]

  @@unique([name, version])
  @@map("benchmark_suites")
}

/// Cas de référence d'une suite (Sprint 5.2 §"Benchmark case") — immuable une fois créé, jamais
/// modifiable après publication de la suite parente (voir BenchmarkSuite.assertMutable). Contenu
/// strictement synthétique/fictif (mission §"aucun DCE réel confidentiel dans Git", et ici même en
/// base : ce corpus n'est jamais un extrait de document client réel).
model BenchmarkCase {
  id String @id @default(uuid()) @db.Uuid

  suiteId String         @map("suite_id") @db.Uuid
  suite   BenchmarkSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  inputVariables     Json  @map("input_variables")
  expectedOutput     Json  @map("expected_output")
  expectedProvenance Json? @map("expected_provenance")

  /// EASY | MEDIUM | HARD — protégée par une contrainte CHECK (migration).
  difficulty String @db.VarChar(10)

  /// FR | EN — protégée par une contrainte CHECK (migration).
  language String @db.VarChar(2)

  /// Étiquette de reporting purement descriptive (jamais un second point de dispatch) — nullable :
  /// tous les cas n'ont pas vocation à être classés par sous-catégorie métier.
  businessCategory String? @map("business_category") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([suiteId])
  @@map("benchmark_cases")
}

/// Exécution d'un benchmark (Sprint 5.2 §"Exécution du benchmark") — scopée à l'organisation qui
/// l'a lancée (le registre de modèles/corpus est global, mais le lancement et son coût le sont pas).
model BenchmarkRun {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  suiteId      String @map("suite_id") @db.Uuid
  suiteVersion Int    @map("suite_version")

  /// PENDING | RUNNING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED | CANCELLED — CHECK (migration).
  status String @default("PENDING") @db.VarChar(20)

  repetitions      Int
  concurrencyLimit Int @map("concurrency_limit")

  estimatedCostAmount   Decimal  @map("estimated_cost_amount") @db.Decimal(14, 6)
  estimatedCostCurrency String   @map("estimated_cost_currency") @db.VarChar(3)
  costCeilingAmount     Decimal? @map("cost_ceiling_amount") @db.Decimal(14, 6)

  launchedByUserId  String    @map("launched_by_user_id") @db.Uuid
  launchedAt        DateTime  @map("launched_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid

  /// Audit Codex P1-3 — dernier code d'erreur connu pour ce run (échec réel ou récupération
  /// stale), jamais écrasé par un succès (mission "traçabilité minimale de la dernière anomalie").
  lastErrorCode String? @map("last_error_code") @db.VarChar(60)

  /// Audit Codex P1-3 — nombre de fois où ce run a été repris depuis un état RUNNING "stale"
  /// (crash/redéploiement présumé, détecté via `updatedAt`). Jamais incrémenté par un retry
  /// manuel explicite (CancelBenchmarkRunUseCase + relance), uniquement par la récupération
  /// automatique (`RecoverStaleBenchmarkRunsUseCase`).
  staleRecoveryAttempts Int @default(0) @map("stale_recovery_attempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runModels   BenchmarkRunModel[]
  caseResults BenchmarkCaseResult[]

  @@index([organizationId, status])
  @@index([status, updatedAt])
  @@map("benchmark_runs")
}

/// Sélection d'un modèle pour un run (Sprint 5.2) — capture le snapshot tarifaire utilisé pour
/// L'ESTIMATION au lancement. Audit Codex P1-2 : les montants ci-dessous sont FIGÉS à cet instant
/// (copie défensive, jamais recalculée) — `ExecuteBenchmarkRunUseCase` les utilise directement,
/// il ne recharge JAMAIS le tarif courant du modèle pour un run déjà lancé, même après un
/// nouveau tarif ajouté ou une reprise (stale recovery/retry).
model BenchmarkRunModel {
  id String @id @default(uuid()) @db.Uuid

  runId String       @map("run_id") @db.Uuid
  run   BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  aiModelId String  @map("ai_model_id") @db.Uuid
  aiModel   AiModel @relation(fields: [aiModelId], references: [id])

  /// Référence de traçabilité vers le snapshot d'origine — JAMAIS relu pour recalculer un coût
  /// (voir les colonnes figées ci-dessous, qui sont la seule source de vérité pour ce run).
  pricingSnapshotId String                 @map("pricing_snapshot_id") @db.Uuid
  pricingSnapshot   AiModelPricingSnapshot @relation(fields: [pricingSnapshotId], references: [id])

  /// Copie figée du tarif au lancement (audit Codex P1-2) — un nouveau AiModelPricingSnapshot créé
  /// après ce run ne modifie jamais ces valeurs ni le coût déjà calculé/à calculer pour ce run.
  pricingCurrency                         String   @map("pricing_currency") @db.VarChar(3)
  pricingInputPricePerMillionTokens       Decimal  @map("pricing_input_price_per_million_tokens") @db.Decimal(14, 6)
  pricingOutputPricePerMillionTokens      Decimal  @map("pricing_output_price_per_million_tokens") @db.Decimal(14, 6)
  /// Toujours NULL dans cette tranche : AiModelPricingSnapshot ne modélise pas encore de tarif de
  /// cache différencié — colonne prête pour une extension future sans nouvelle migration.
  pricingCachedInputPricePerMillionTokens Decimal? @map("pricing_cached_input_price_per_million_tokens") @db.Decimal(14, 6)
  pricingEffectiveFrom                    DateTime @map("pricing_effective_from")
  pricingSource                           String   @default("PRICING_SNAPSHOT") @map("pricing_source") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([runId, aiModelId])
  @@map("benchmark_run_models")
}

/// Résultat d'UNE tentative (cas × modèle × répétition), append-only (Sprint 5.2 §"Répétitions").
model BenchmarkCaseResult {
  id String @id @default(uuid()) @db.Uuid

  runId String       @map("run_id") @db.Uuid
  run   BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  caseId String @map("case_id") @db.Uuid

  aiModelId String @map("ai_model_id") @db.Uuid

  /// Snapshot tarifaire RÉELLEMENT utilisé pour le coût de cette tentative (mission §"le coût réel
  /// utilise un pricing snapshot") — peut différer de celui de BenchmarkRunModel (estimation) si le
  /// tarif a changé pendant l'exécution du run. Nullable : une tentative en échec avant tout appel
  /// provider n'a pas de coût réel.
  pricingSnapshotId String? @map("pricing_snapshot_id") @db.Uuid

  repetitionIndex Int @map("repetition_index")

  provider String? @db.VarChar(30)
  model    String? @db.VarChar(60)

  /// Bornée en taille par l'application avant persistance (mission §"aucune duplication de gros
  /// inputs") — jamais un blob non borné.
  rawOutput String? @map("raw_output")

  inputTokenCount  Int? @map("input_token_count")
  outputTokenCount Int? @map("output_token_count")
  totalTokenCount  Int? @map("total_token_count")
  durationMs       Int? @map("duration_ms")

  actualCostAmount Decimal? @map("actual_cost_amount") @db.Decimal(14, 6)

  evaluationPassed  Boolean @map("evaluation_passed")
  evaluationScore   Decimal @map("evaluation_score") @db.Decimal(5, 4)
  evaluationDetails Json    @default("{}") @map("evaluation_details")

  /// TENANT_LEAKAGE | INVALID_PROVENANCE | CRITICAL_HALLUCINATION | INVALID_JSON_RATE_TOO_HIGH |
  /// FAILURE_RATE_TOO_HIGH | QUALITY_BELOW_THRESHOLD — calculé à l'agrégation par modèle, jamais
  /// stocké ici (une élimination se juge sur l'ensemble des tentatives d'un modèle, pas une seule).
  criticalHallucinationFlag Boolean @default(false) @map("critical_hallucination_flag")
  invalidProvenanceFlag     Boolean @default(false) @map("invalid_provenance_flag")

  errorCode    String? @map("error_code") @db.VarChar(60)
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([runId, caseId, aiModelId, repetitionIndex])
  @@index([runId, aiModelId])
  @@index([runId, caseId])
  @@map("benchmark_case_results")
}

/// Recommandation de modèle par tâche IA (Sprint 5.2 §"Recommandations") — reste DRAFT jusqu'à une
/// décision explicite (approve/reject) : jamais activée automatiquement en routing.
model ModelRecommendation {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// ANALYZE_DOCUMENT | CONSOLIDATE_TENDER_ANALYSIS — CHECK (migration).
  promptKey String @map("prompt_key") @db.VarChar(40)

  runId String @map("run_id") @db.Uuid

  primaryAiModelId    String  @map("primary_ai_model_id") @db.Uuid
  escalationAiModelId String? @map("escalation_ai_model_id") @db.Uuid

  score           Decimal @db.Decimal(5, 4)
  avgCostAmount   Decimal @map("avg_cost_amount") @db.Decimal(14, 6)
  avgCostCurrency String  @map("avg_cost_currency") @db.VarChar(3)
  avgLatencyMs    Int     @map("avg_latency_ms")
  confidence      Decimal @db.Decimal(5, 4)

  reasons     Json @default("[]")
  limitations Json @default("[]")

  /// DRAFT | APPROVED | REJECTED — CHECK (migration).
  status String @default("DRAFT") @db.VarChar(10)

  generatedAt     DateTime  @map("generated_at")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, promptKey])
  @@map("model_recommendations")
}

/// Politique de routage versionnée par (organisation, tâche IA) — Sprint 5.2 §"Routing Policy".
/// Au plus UNE version ACTIVE par (organizationId, promptKey), garanti par un index unique partiel
/// `WHERE status = 'ACTIVE'` (migration) — jamais uniquement par la discipline applicative.
model RoutingPolicy {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// ANALYZE_DOCUMENT | CONSOLIDATE_TENDER_ANALYSIS — CHECK (migration).
  promptKey String @map("prompt_key") @db.VarChar(40)
  version   Int

  /// DRAFT | ACTIVE | ARCHIVED — CHECK (migration).
  status String @default("DRAFT") @db.VarChar(10)

  primaryAiModelId    String  @map("primary_ai_model_id") @db.Uuid
  escalationAiModelId String? @map("escalation_ai_model_id") @db.Uuid

  confidenceThreshold Decimal? @map("confidence_threshold") @db.Decimal(5, 4)
  provenanceRequired  Boolean  @default(true) @map("provenance_required")
  timeoutMs           Int      @map("timeout_ms")
  maxRetries          Int      @map("max_retries")

  /// Tableau de EscalationCondition (INVALID_JSON, UNKNOWN_SOURCE, ...) — validé applicativement.
  escalationConditions Json @default("[]") @map("escalation_conditions")

  sourceRecommendationId String? @map("source_recommendation_id") @db.Uuid

  authorUserId  String    @map("author_user_id") @db.Uuid
  effectiveFrom DateTime? @map("effective_from")
  archivedAt    DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, promptKey, version])
  @@map("routing_policies")
}

/// Audit Codex P1-4 — décision de routage DURABLE pour un job d'analyse réel (distinct du journal
/// d'audit best-effort, insuffisant seul). Une ligne par tentative d'`AnalysisJob.execute()` :
/// créée en IN_PROGRESS avant/au tout début de l'appel provider, mise à jour une seule fois à la
/// fin (succès ou échec). Reste lisible même si la RoutingPolicy change de version, si le modèle
/// est désactivé, ou si le tarif change ensuite — aucune colonne ici n'est un JOIN "état actuel".
/// Jamais de prompt/document complet ni de clé API : uniquement des métadonnées d'exécution.
model RoutingDecision {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// Best-effort, résolu via Tender.clientAccountId au moment de la création — non applicable
  /// (NULL) si l'analyse ne porte pas sur un tender rattaché à un client, ou si la résolution
  /// échoue (ne doit jamais faire échouer la décision elle-même ni l'analyse).
  clientAccountId String? @map("client_account_id") @db.Uuid

  tenderId String? @map("tender_id") @db.Uuid

  /// Correctif Sprint 6 (audit Codex P1 — "fausse routingDecisionId") : `analysisId` devient
  /// nullable et `generationId` est ajouté — une RoutingDecision sert désormais EXACTEMENT UNE
  /// cible, Analysis OU Generation, jamais aucune ni les deux (voir la contrainte CHECK ajoutée en
  /// migration, `routing_decisions_analysis_or_generation_check`). Aucune FK Prisma déclarée sur
  /// ces deux colonnes (même discipline que l'`analysisId` d'origine, jamais garantie qu'au niveau
  /// applicatif) — uniquement des index pour la recherche par cible.
  analysisId   String? @map("analysis_id") @db.Uuid
  generationId String? @map("generation_id") @db.Uuid

  /// ANALYZE_DOCUMENT | CONSOLIDATE_TENDER_ANALYSIS (Analysis) ou l'un des 17 GenerationTaskType
  /// (Sprint 6) — même vocabulaire que RoutingPolicy.promptKey, jamais un type fermé importé ici.
  promptKey String @map("prompt_key") @db.VarChar(40)

  /// NULL = chemin legacy (aucune RoutingPolicy consultée, résolution par variable d'environnement
  /// statique Sprint 4.1/4.2) — jamais une valeur fabriquée.
  routingPolicyId      String? @map("routing_policy_id") @db.Uuid
  routingPolicyVersion Int?    @map("routing_policy_version")

  recommendedAiModelId String? @map("recommended_ai_model_id") @db.Uuid

  primaryProvider  String  @map("primary_provider") @db.VarChar(30)
  primaryModel     String  @map("primary_model") @db.VarChar(60)
  selectedProvider String? @map("selected_provider") @db.VarChar(30)
  selectedModel    String? @map("selected_model") @db.VarChar(60)

  /// 0 = résultat retenu vient de la tentative principale ; 1 = de l'unique palier d'escalade
  /// (Sprint 5.2 §"Fallback simple" — jamais plus d'un palier dans cette tranche).
  fallbackLevel    Int @default(0) @map("fallback_level")
  fallbackAttempts Int @default(0) @map("fallback_attempts")

  inputTokenCount     Int?     @map("input_token_count")
  outputTokenCount    Int?     @map("output_token_count")
  estimatedCostAmount Decimal? @map("estimated_cost_amount") @db.Decimal(14, 6)
  actualCostAmount    Decimal? @map("actual_cost_amount") @db.Decimal(14, 6)
  currency            String?  @db.VarChar(3)
  latencyMs           Int?     @map("latency_ms")

  /// IN_PROGRESS | SUCCEEDED | FAILED — CHECK (migration).
  status        String  @default("IN_PROGRESS") @db.VarChar(20)
  failureReason String? @map("failure_reason") @db.VarChar(60)

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  generations Generation[]

  /// Support de la FK composée `Generation.routingDecisionId` (AUDIT-007, voir modèle Generation).
  @@unique([id, organizationId])
  @@index([organizationId, analysisId])
  @@index([organizationId, generationId])
  @@index([organizationId, promptKey, createdAt])
  @@map("routing_decisions")
}

/// Sprint 6 §"Prompt Management" — un template par (organisation, type de tâche de génération),
/// jamais de variantes concurrentes en MVP. Système entièrement séparé du placeholder statique
/// d'Analysis (`PromptTemplatePort`/`PromptKey`, Sprint 4.1/4.2) — aucun vocabulaire partagé,
/// aucun fichier d'Analysis modifié pour ce sprint (voir rapport final §C).
model PromptTemplate {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  /// EXECUTIVE_SUMMARY | NEED_UNDERSTANDING | CRITERION_RESPONSE | METHODOLOGY | ORGANIZATION |
  /// GOVERNANCE | HUMAN_RESOURCES | TECHNICAL_RESOURCES | PLANNING | RISK_MANAGEMENT | QUALITY |
  /// SECURITY | CSR | REFERENCES | SECTION_SUMMARY | REPHRASING | CONTENT_IMPROVEMENT — 17 valeurs,
  /// catalogue fermé — CHECK (migration), voir generation-task-type.ts (domaine) pour la même liste.
  taskType String @map("task_type") @db.VarChar(40)

  name        String  @db.VarChar(200)
  description String?

  /// FREE_TEXT | STRUCTURED — CHECK (migration).
  outputMode          String  @map("output_mode") @db.VarChar(12)
  /// Requis uniquement si outputMode = STRUCTURED ; clé dans le registre Zod applicatif de
  /// Generation (`structured-output-registry.ts`) — jamais une contrainte DB, le registre de
  /// schémas vit en code.
  structuredSchemaKey String? @map("structured_schema_key") @db.VarChar(60)

  archivedAt DateTime? @map("archived_at")
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  versions    PromptVersion[]
  generations Generation[]

  @@unique([id, organizationId])
  @@unique([organizationId, taskType])
  @@map("prompt_templates")
}

model PromptVersion {
  id String @id @default(uuid()) @db.Uuid

  /// Dénormalisé depuis PromptTemplate — jamais de relation directe à Organization ici (même motif
  /// qu'AnalysisJob.organizationId/TenderLot.organizationId, AUDIT-007) : la cohérence est garantie
  /// par la FK composée ci-dessous, pas par une seconde relation redondante.
  organizationId String @map("organization_id") @db.Uuid

  promptTemplateId String         @map("prompt_template_id") @db.Uuid
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int

  /// DRAFT | ACTIVE | ARCHIVED — CHECK (migration).
  status String @default("DRAFT") @db.VarChar(10)

  systemPrompt       String @map("system_prompt")
  userPromptTemplate String @map("user_prompt_template")
  /// Placeholders `{{nom}}` attendus — aide à l'édition admin ; un placeholder manquant au RENDU
  /// (pas à l'écriture) échoue explicitement, jamais un gap silencieux (voir PromptRenderer).
  requiredVariables  Json   @default("[]") @map("required_variables")

  authorUserId  String    @map("author_user_id") @db.Uuid
  effectiveFrom DateTime? @map("effective_from")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  generations Generation[]

  @@unique([id, organizationId])
  @@unique([organizationId, promptTemplateId, version])
  /// Invariant "une seule version ACTIVE par template" — non exprimable en DSL Prisma (pas d'index
  /// partiel natif) : index unique partiel ajouté À LA MAIN en fin de migration, jamais généré par
  /// `prisma migrate dev` — même discipline que RoutingPolicy (voir
  /// 20260731124812_p1_audit_fixes/migration.sql, "routing_policies_org_prompt_key_active_key").
  /// `activateAtomically` (transaction applicative) reste la première ligne de défense ; cet index
  /// est le filet de sécurité de dernier recours.
  @@map("prompt_versions")
}

/// Sprint 6 §"Génération" — une ligne PAR VERSION (jamais un remplacement silencieux). La version 1
/// d'un fil a `parentGenerationId = NULL` ; toute version suivante pointe TOUJOURS vers la version 1
/// (jamais vers la version immédiatement précédente). `routingDecisionId` est une VRAIE FK vers
/// `ai_benchmark.routing_decisions` (correctif Sprint 6, audit Codex P1 — la génération d'origine
/// utilisait un UUID local fabriqué, jamais persisté nulle part ailleurs ; `RoutingDecision.analysisId`
/// est désormais nullable et `RoutingDecision.generationId` a été ajouté pour accueillir cette
/// relation, voir modèle RoutingDecision). NULL tant que la décision réelle n'a pas encore été
/// créée par `ProcessGenerationUseCase` (avant le premier appel provider) — jamais une valeur
/// fabriquée en son absence.
model Generation {
  id String @id @default(uuid()) @db.Uuid

  /// Dénormalisé — même motif qu'AnalysisJob.organizationId (AUDIT-007) : aucune relation directe
  /// à Organization, la cohérence passe par les FK composées ci-dessous.
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  taskType  String  @map("task_type") @db.VarChar(40)
  /// Ancrage métier optionnel (ex. l'id d'un TenderAwardCriterion pour CRITERION_RESPONSE) —
  /// chaîne libre bornée plutôt qu'une FK par cible possible, validée applicativement par taskType.
  targetRef String? @map("target_ref") @db.VarChar(200)

  /// NULL = cette ligne EST la version 1 (racine) de son fil.
  parentGenerationId String?      @map("parent_generation_id") @db.Uuid
  parentGeneration   Generation?  @relation("GenerationVersions", fields: [parentGenerationId], references: [id], onDelete: Cascade)
  childVersions      Generation[] @relation("GenerationVersions")
  /// = id si version 1, = parentGenerationId sinon — porté en base pour permettre une contrainte
  /// d'unicité (rootGenerationId, version) sans remontée récursive (même motif qu'
  /// AnalysisJob.targetId, "porté en base pour permettre une contrainte d'unicité... jamais des
  /// index partiels dépendant du scope").
  rootGenerationId   String       @map("root_generation_id") @db.Uuid
  version            Int

  /// PENDING | GENERATING | GENERATED | FAILED | CANCELLED — CHECK (migration).
  status       String @db.VarChar(12)
  /// Jeton de réservation (compare-and-set) — même motif qu'AnalysisJob.attemptCount.
  attemptCount Int    @default(0) @map("attempt_count")

  promptTemplateId    String         @map("prompt_template_id") @db.Uuid
  promptTemplate      PromptTemplate @relation(fields: [promptTemplateId, organizationId], references: [id, organizationId])
  promptVersionId     String         @map("prompt_version_id") @db.Uuid
  promptVersion       PromptVersion  @relation(fields: [promptVersionId, organizationId], references: [id, organizationId])
  /// Gelé au moment de la génération — jamais recalculé même si le PromptVersion est archivé ou
  /// qu'une nouvelle version est activée ensuite (mission §"une génération passée doit refléter à
  /// jamais la version exacte utilisée").
  promptVersionNumber Int            @map("prompt_version_number")

  /// NULL uniquement si la génération a échoué AVANT qu'une décision ait pu être créée (ex. aucune
  /// RoutingPolicy active pour ce taskType — la génération échoue alors explicitement, voir
  /// `NoActiveRoutingPolicyError`, jamais un repli silencieux sur un modèle codé en dur).
  routingPolicyId      String?          @map("routing_policy_id") @db.Uuid
  routingPolicyVersion Int?             @map("routing_policy_version")
  /// VRAIE FK vers RoutingDecision — voir docstring du modèle. Composée avec organizationId
  /// (AUDIT-007) pour interdire structurellement qu'une génération référence la décision d'une
  /// autre organisation.
  routingDecisionId    String?          @map("routing_decision_id") @db.Uuid
  routingDecision      RoutingDecision? @relation(fields: [routingDecisionId, organizationId], references: [id, organizationId])
  modelProvider        String?          @map("model_provider") @db.VarChar(30)
  modelKey             String?          @map("model_key") @db.VarChar(60)
  fallbackLevel        Int              @default(0) @map("fallback_level")

  generatedContent  String? @map("generated_content")
  structuredContent Json?   @map("structured_content")

  editedContent           String?   @map("edited_content")
  editedStructuredContent Json?     @map("edited_structured_content")
  editedBy                String?   @map("edited_by") @db.Uuid
  editedAt                DateTime? @map("edited_at")

  inputTokenCount     Int?     @map("input_token_count")
  outputTokenCount    Int?     @map("output_token_count")
  totalTokenCount     Int?     @map("total_token_count")
  /// Correctif Sprint 6 (réaudit Codex P2-3) : coût RÉEL calculé à partir du pricing snapshot
  /// Sprint 5.2 du modèle effectivement utilisé quand disponible (voir
  /// `PrismaGenerationRoutingDecisionWriter.complete()`) ; ne retombe sur l'estimation statique
  /// (`GENERATION_MODEL_RATES`) que si aucun snapshot n'est résolvable. Malgré son nom
  /// (conservé pour compatibilité), N'EST PLUS purement informatif depuis ce correctif — Sprint 7
  /// (Pricing) le lit comme le coût technique IA de référence d'une génération terminée, jamais
  /// recalculé rétroactivement.
  estimatedCostAmount Decimal? @map("estimated_cost_amount") @db.Decimal(14, 6)
  currency            String?  @db.VarChar(3)
  latencyMs           Int?     @map("latency_ms")

  errorCode    String? @map("error_code") @db.VarChar(60)
  /// Toujours assaini — jamais un message brut de provider, jamais un extrait de prompt/contenu
  /// client (même discipline qu'AnalysisJob.errorMessage).
  errorMessage String? @map("error_message")

  createdBy     String    @map("created_by") @db.Uuid
  /// Rôle RÉEL de l'acteur ayant lancé cette génération — même motif qu'AnalysisJob.triggeredByRole
  /// (mission Sprint 4.2 §"Phase 2 sans acteur HTTP vivant") : le traitement en arrière-plan
  /// (ProcessGenerationUseCase) doit pouvoir reconstruire un contexte via des use cases RBAC-gated
  /// sans jamais fabriquer un rôle. Toujours renseigné à la création, jamais un rôle par défaut.
  createdByRole String?   @map("created_by_role") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  validatedBy String?   @map("validated_by") @db.Uuid
  validatedAt DateTime? @map("validated_at")

  /// Correctif Sprint 6 (réaudit Codex P1 — "le rejet d'une génération est absent") — même motif
  /// que validatedBy/validatedAt : un FAIT sur la ligne terminale GENERATED, jamais une transition.
  /// Mutuellement exclusif avec validatedAt (voir Generation.reject()/.validate() — CHECK ajouté en
  /// migration, generations_validated_or_rejected_check).
  rejectedBy      String?   @map("rejected_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at")
  /// Assaini côté application (longueur bornée) — jamais un extrait de contenu client/prompt.
  rejectionReason String?   @map("rejection_reason") @db.VarChar(1000)

  @@unique([rootGenerationId, version])
  @@index([organizationId, tenderId, taskType])
  @@index([organizationId, clientAccountId])
  @@index([organizationId, status])
  @@index([rootGenerationId])
  /// Garde-fou "double génération en vol" — non exprimable en DSL Prisma (index partiel) : ajouté
  /// à la main en fin de migration, voir "generations_org_tender_tasktype_target_inflight_key".
  /// `reserveForGenerating`/le use case Launch restent la première ligne de défense applicative ;
  /// cet index est le filet de sécurité de dernier recours (même discipline que PromptVersion
  /// ci-dessus et que RoutingPolicy, Sprint 5.2).
  @@map("generations")
}

/// Sprint 7 (AI Pricing & Prévisions) — en-tête stable d'une estimation. Ne porte jamais de montant
/// ni de détail : ceux-ci vivent exclusivement sur `PricingEstimateVersion` (mission
/// "ne jamais modifier rétroactivement une version historique"). `organizationId` reste une colonne
/// dénormalisée, sans relation Prisma directe vers `Organization` — même motif que `Generation`
/// ci-dessus ("aucune relation directe... la cohérence passe par les FK composées").
model PricingEstimate {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  /// Au moins l'un de clientAccountId/tenderId doit être renseigné pour un type scopé — vérifié par
  /// le domaine (`PricingEstimate.create`), jamais par une contrainte DB (dépend du `type`).
  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String? @map("tender_id") @db.Uuid
  tender   Tender? @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// AI_TECHNICAL_COST | GENERATION_ESTIMATE | TENDER_ESTIMATE | CLIENT_COST_SUMMARY |
  /// ORGANIZATION_COST_SUMMARY | PRODUCTION_ESTIMATE | COMMERCIAL_PREVIEW — CHECK (migration).
  type String @db.VarChar(30)

  /// DRAFT | CALCULATED | PARTIAL | UNKNOWN | SUPERSEDED | ARCHIVED — CHECK (migration).
  status String @db.VarChar(12)

  /// Pointe TOUJOURS vers la version de référence la plus récente — jamais une relation Prisma
  /// formelle vers PricingEstimateVersion (créée APRÈS l'estimation elle-même, éviterait un cycle
  /// de création) : simple UUID + numéro, résolus applicativement.
  currentVersionId     String? @map("current_version_id") @db.Uuid
  currentVersionNumber Int     @default(0) @map("current_version_number")

  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  archivedAt DateTime? @map("archived_at")

  versions PricingEstimateVersion[]

  /// Support de la FK composée `PricingEstimateVersion.estimateId` (AUDIT-007).
  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@index([organizationId, clientAccountId])
  @@index([organizationId, type])
  @@map("pricing_estimates")
}

/// Sprint 7 — UNE version figée d'une estimation (mission "chaque modification significative doit
/// créer une nouvelle version... jamais modifier rétroactivement une version historique"). Jamais
/// de mise à jour de `amountValue`/`assumptions` après création — seul `status`/`supersededAt`
/// changent, au moment où une version suivante est créée.
model PricingEstimateVersion {
  id String @id @default(uuid()) @db.Uuid

  estimateId     String          @map("estimate_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  estimate       PricingEstimate @relation(fields: [estimateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int

  /// DRAFT | CALCULATED | PARTIAL | UNKNOWN | SUPERSEDED — CHECK (migration). Jamais ARCHIVED : ce
  /// statut ne s'applique qu'à l'estimation entière (`PricingEstimate.status`), jamais à une version
  /// précise.
  status String @db.VarChar(12)

  amountValue    Decimal @map("amount_value") @db.Decimal(14, 6)
  amountCurrency String  @map("amount_currency") @db.VarChar(3)

  /// Sérialisation de `PricingAssumptions` (domaine) — Json plutôt qu'une table dédiée : structure
  /// simple, 1:1 avec sa version, extensible sans migration à chaque nouvelle hypothèse (mission
  /// "suffisamment simple pour la V1, mais extensible pour le Sprint 18").
  assumptions Json

  /// Fige la version du texte légal en vigueur au moment du calcul (voir domaine `disclaimer.ts`)
  /// — jamais recalculée si le texte de référence évolue plus tard.
  disclaimerVersion Int    @map("disclaimer_version")
  /// Provenance du calcul, ex. "MANUAL" | "HISTORICAL_AVERAGE" — chaîne bornée, jamais un enum
  /// fermé prématurément (mission "ne construis pas un moteur universel spéculatif").
  source            String @db.VarChar(40)

  createdBy           String    @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  supersededAt        DateTime? @map("superseded_at")
  recalculationReason String?   @map("recalculation_reason") @db.VarChar(500)

  breakdownLines PricingBreakdownLine[]

  @@unique([estimateId, version])
  @@index([organizationId])
  @@map("pricing_estimate_versions")
}

/// Sprint 7 — une ligne du détail d'une estimation (mission "Breakdown"). Jamais modifiée après
/// création — un recalcul produit un nouveau jeu de lignes sous une nouvelle version.
model PricingBreakdownLine {
  id String @id @default(uuid()) @db.Uuid

  estimateVersionId String                 @map("estimate_version_id") @db.Uuid
  estimateVersion   PricingEstimateVersion @relation(fields: [estimateVersionId], references: [id], onDelete: Cascade)

  type  String @db.VarChar(40)
  label String @db.VarChar(200)

  quantity Decimal? @db.Decimal(14, 6)
  unit     String?  @db.VarChar(30)

  unitPriceValue    Decimal? @map("unit_price_value") @db.Decimal(14, 6)
  unitPriceCurrency String?  @map("unit_price_currency") @db.VarChar(3)

  amountValue    Decimal @map("amount_value") @db.Decimal(14, 6)
  amountCurrency String  @map("amount_currency") @db.VarChar(3)

  /// ACTUAL | ESTIMATED — CHECK (migration). Jamais mélangées dans une même estimation sans que
  /// chaque ligne ne précise sa propre nature (mission "Ne jamais fusionner ces quatre notions").
  source       String @db.VarChar(10)
  displayOrder Int    @map("display_order")

  @@index([estimateVersionId])
  @@map("pricing_breakdown_lines")
}

// ============================================================================
// Sprint 8A / 8A bis — Export, Validation, Signature (pré-intégration Universign), Package.
// Consomme Generation (Sprint 6) et PricingEstimateVersion (Sprint 7) en LECTURE SEULE via des
// colonnes dénormalisées non-FK (mêmes motif que `PrismaGenerationCostReader` — la validation
// d'appartenance/organisation passe par l'application, jamais par une contrainte DB inter-module),
// jamais une seconde écriture sur ces tables. Aucune migration existante modifiée.
// ============================================================================

/// Mission §16/§18 — un template définit la structure d'un type de document (mémoire technique,
/// synthèse, matrice, checklist, rapport de validation, rapport de coûts, dossier de signature).
/// Organisation-scope uniquement (même motif que `PromptTemplate`, Sprint 6) — jamais client/tender.
model ExportTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// TECHNICAL_MEMO | EXECUTIVE_SUMMARY | COMPLIANCE_MATRIX | CHECKLIST | VALIDATION_REPORT |
  /// COST_REPORT | SIGNATURE_PACKAGE — CHECK (migration).
  documentType String  @map("document_type") @db.VarChar(30)
  name         String  @db.VarChar(200)
  description  String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  versions ExportTemplateVersion[]

  @@unique([id, organizationId])
  @@unique([organizationId, documentType, name])
  @@map("export_templates")
}

/// Mission §7/§16 — une seule version ACTIVE par template (index partiel ajouté à la main en fin
/// de migration, même motif que `prompt_versions_org_template_active_key`, Sprint 6). Une version
/// active est immuable : `config` n'est jamais réécrit après activation, seul `status` change.
model ExportTemplateVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  exportTemplateId String         @map("export_template_id") @db.Uuid
  exportTemplate   ExportTemplate @relation(fields: [exportTemplateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int

  /// DRAFT | ACTIVE | ARCHIVED — CHECK (migration).
  status String @db.VarChar(10)
  /// DOCX | PDF — CHECK (migration).
  format String @db.VarChar(4)

  /// Ordre des sections, sections obligatoires, styles, marges, typographie, page de garde,
  /// en-tête/pied de page, numérotation, variables autorisées — structure contrôlée par le
  /// domaine à la création (`ExportTemplateVersion.create`), jamais une exécution de template
  /// arbitraire (mission §16 "aucune macro, aucune injection de template").
  config Json

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  activatedAt DateTime? @map("activated_at")
  archivedAt  DateTime? @map("archived_at")

  exportJobs ExportJob[]

  @@unique([id, organizationId])
  @@unique([organizationId, exportTemplateId, version])
  @@map("export_template_versions")
}

/// Mission §7/§19/§22 — un "job" EST l'export (aperçu ou final) : une ligne par tentative,
/// jamais mutée après COMPLETED/FAILED (mission "un export historique reste immuable").
/// `basedOnExportJobId` prouve qu'un export FINAL réutilise EXACTEMENT la sélection d'un aperçu
/// déjà approuvé (mission §32 "aucune substitution silencieuse d'une version validée").
model ExportJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  exportTemplateId        String                @map("export_template_id") @db.Uuid
  exportTemplateVersionId String                @map("export_template_version_id") @db.Uuid
  exportTemplateVersion   ExportTemplateVersion @relation(fields: [exportTemplateVersionId, organizationId], references: [id, organizationId])

  /// Dénormalisé depuis le template au moment de la création — jamais recalculé si le template
  /// change ensuite (mission "un export final référence une version précise du template").
  documentType String @map("document_type") @db.VarChar(30)

  /// PREVIEW | FINAL — CHECK (migration). Un PREVIEW n'approuve jamais, ne verrouille jamais, ne
  /// démarre jamais de signature (mission §21).
  mode   String @db.VarChar(7)
  /// DOCX | PDF — CHECK (migration).
  format String @db.VarChar(4)
  /// PENDING | GENERATING | COMPLETED | FAILED — CHECK (migration).
  status String @db.VarChar(10)

  /// Numérotation stable PAR (tenderId, documentType, format) — mission §22/§60 "hash stable",
  /// "export historique stable". Incrémentée pour PREVIEW et FINAL indifféremment (une seule
  /// séquence, jamais deux compteurs qui pourraient diverger).
  version Int

  basedOnExportJobId String?     @map("based_on_export_job_id") @db.Uuid
  basedOnExportJob   ExportJob?  @relation("ExportJobBasis", fields: [basedOnExportJobId], references: [id])
  derivedExportJobs  ExportJob[] @relation("ExportJobBasis")

  /// Mission Sprint 8A.2 (correction bugs #7/#8 "thème non appliqué à l'export") — même motif
  /// dénormalisé, sans FK inter-module, que `Deliverable.themeVersionId`/`themeSourceLevel`
  /// (Sprint 8A.1) : le thème RÉELLEMENT résolu (TENDER > CLIENT > ORGANIZATION > TENDEROS, voir
  /// TemplateThemeResolverService, réutilisé tel quel) au moment du rendu, jamais recalculé côté
  /// frontend, jamais une seconde hiérarchie de résolution divergente.
  themeVersionId   String? @map("theme_version_id") @db.Uuid
  themeSourceLevel String? @map("theme_source_level") @db.VarChar(12)

  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")
  errorCode    String?   @map("error_code") @db.VarChar(60)
  /// Toujours assaini — même discipline que Generation.errorMessage (jamais un contenu client brut).
  errorMessage String?   @map("error_message")

  sections       ExportSectionSelection[]
  artifact       ExportArtifact?
  validationRuns ValidationRun[]
  finalApprovals FinalApproval[]

  @@unique([id, organizationId])
  @@unique([tenderId, documentType, format, version])
  @@index([organizationId, tenderId])
  @@map("export_jobs")
}

/// Mission §17/§20 — une ligne par section incluse dans un export, conservant la provenance
/// minimale (mission §20 "pour chaque section incluse, conserver..."). `generationId` et
/// `pricingEstimateId` sont des références dénormalisées en LECTURE SEULE (jamais de FK
/// inter-module — même motif que `PrismaGenerationCostReader`, Sprint 7) : la validité réelle est
/// vérifiée par l'application via les use cases publics de Generation/Pricing, jamais par la DB.
model ExportSectionSelection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  exportJobId String    @map("export_job_id") @db.Uuid
  exportJob   ExportJob @relation(fields: [exportJobId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sectionId String  @map("section_id") @db.VarChar(100)
  taskType  String? @map("task_type") @db.VarChar(40)

  /// GENERATION | PRICING | MANUAL | ANNEX — CHECK (migration).
  sourceType String @map("source_type") @db.VarChar(10)

  generationId                 String? @map("generation_id") @db.Uuid
  /// Mission (audit de correction) — l'identifiant réel de l'ESTIMATION, jamais d'une version
  /// (renommé depuis `pricingEstimateVersionId`, qui était en réalité utilisé comme un
  /// `estimateId` — bug réel : l'export ne gelait jamais une version précise). Dénormalisé en
  /// LECTURE SEULE (jamais de FK inter-module), même motif que `PrismaGenerationCostReader`.
  pricingEstimateId            String? @map("pricing_estimate_id") @db.Uuid
  /// Le numéro de version PRÉCIS figé au moment de la sélection — absent seulement pour une
  /// sélection antérieure à cette correction, jamais un défaut implicite pour une nouvelle.
  pricingEstimateVersionNumber Int?    @map("pricing_estimate_version_number")
  manualContent                String? @map("manual_content")
  /// Mission Sprint 8A.1 §7/§9/§12 — équivalent structuré (RenderableBlock[]) de `manualContent`,
  /// utilisé par Deliverables pour préserver la mise en forme (gras/italique/liens/listes/tableaux)
  /// d'une révision de Mémoire technique à travers le pipeline de rendu DOCX/PDF du Sprint 8A,
  /// jamais un second moteur de rendu. Absent = comportement Sprint 8A inchangé (repli sur
  /// `manualContent` en texte brut, un seul paragraphe).
  manualBlocks                 Json?   @map("manual_blocks")

  /// VALIDATED | NOT_VALIDATED | UNKNOWN — CHECK (migration). Cliché au moment de la sélection
  /// (mission §20 "validationStatus") — jamais recalculé rétroactivement pour un export historique.
  validationStatus String @map("validation_status") @db.VarChar(14)

  selectedBy String   @map("selected_by") @db.Uuid
  selectedAt DateTime @map("selected_at")
  order      Int
  notes      String?

  /// Correctif audit Codex P1-001 — provenance explicite (deliverableId/deliverableSectionId/
  /// deliverableRevisionId/revisionNumber/validationStatus/selectedBy/selectedAt) quand cette
  /// section MANUAL/ANNEX origine d'une révision Deliverables déjà sélectionnée pour l'export.
  /// Absent pour une section Sprint 8A qui n'origine pas de Deliverables (comportement inchangé).
  deliverableProvenance Json? @map("deliverable_provenance")

  @@unique([exportJobId, sectionId])
  @@index([organizationId, exportJobId])
  @@map("export_section_selections")
}

/// Mission §7/§25/§26 — l'artefact final, créé UNE SEULE FOIS à la complétion d'un `ExportJob`
/// (mission "un artefact final ne peut pas être remplacé silencieusement" : aucun update prévu
/// après création, seule la lecture existe côté application).
model ExportArtifact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  exportJobId String    @map("export_job_id") @db.Uuid
  exportJob   ExportJob @relation(fields: [exportJobId, organizationId], references: [id, organizationId], onDelete: Cascade)

  fileName      String @map("file_name") @db.VarChar(255)
  mimeType      String @map("mime_type") @db.VarChar(120)
  fileSize      Int    @map("file_size")
  fileHash      String @map("file_hash") @db.VarChar(64)
  hashAlgorithm String @default("SHA-256") @map("hash_algorithm") @db.VarChar(20)
  storageKey    String @map("storage_key") @db.VarChar(500)

  /// Snapshot figé du manifest (mission §25) — reconstruit à la création, jamais recalculé après
  /// (même si le template ou les générations sources changent ensuite).
  manifestJson Json @map("manifest_json")
  warnings     Json @default("[]")
  errors       Json @default("[]")

  createdAt DateTime @default(now()) @map("created_at")

  signatureTransactions SignatureTransaction[]

  @@unique([id, organizationId])
  @@unique([exportJobId, organizationId])
  @@map("export_artifacts")
}

/// Mission §8/§26/§27 — une exécution de validation contre un `ExportJob` précis (typiquement un
/// aperçu). Immuable après création (mission "une validation historique reste immuable") : seules
/// les `ValidationIssue` associées peuvent être résolues/rouvertes, jamais le run lui-même.
model ValidationRun {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  exportJobId String    @map("export_job_id") @db.Uuid
  exportJob   ExportJob @relation(fields: [exportJobId, organizationId], references: [id, organizationId])

  /// NOT_READY | READY_WITH_WARNINGS | READY_FOR_APPROVAL | BLOCKED — CHECK (migration). Sous-
  /// ensemble de `ReadinessStatus` réellement calculable à ce stade (avant approbation/signature).
  readinessStatus String @map("readiness_status") @db.VarChar(20)

  runBy String   @map("run_by") @db.Uuid
  runAt DateTime @default(now()) @map("run_at")

  issues             ValidationIssue[]
  finalApprovals     FinalApproval[]
  submissionPackages SubmissionPackage[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("validation_runs")
}

/// Mission §26/§29 — un contrôle détecté par le moteur de validation. `resolutionStatus`
/// transite OPEN → RESOLVED → REOPENED, jamais une suppression (mission "toute résolution
/// conserve l'auteur, la date et la justification").
model ValidationIssue {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  validationRunId String        @map("validation_run_id") @db.Uuid
  validationRun   ValidationRun @relation(fields: [validationRunId, organizationId], references: [id, organizationId], onDelete: Cascade)

  ruleCode String @map("rule_code") @db.VarChar(60)
  /// BLOCKING | WARNING — CHECK (migration). Un contrôle bloquant, tant qu'il n'est pas résolu,
  /// empêche l'approbation (mission §29) — dérivé de CE champ uniquement, jamais un second
  /// booléen redondant qui pourrait diverger.
  severity String @db.VarChar(10)
  message  String

  resourceType   String? @map("resource_type") @db.VarChar(40)
  resourceId     String? @map("resource_id") @db.Uuid
  source         String? @db.VarChar(40)
  recommendation String?

  detectedAt DateTime @default(now()) @map("detected_at")

  /// OPEN | RESOLVED | REOPENED — CHECK (migration).
  resolutionStatus String    @default("OPEN") @map("resolution_status") @db.VarChar(10)
  resolvedAt       DateTime? @map("resolved_at")
  resolvedBy       String?   @map("resolved_by") @db.Uuid
  resolutionNote   String?   @map("resolution_note")

  @@index([organizationId, validationRunId])
  @@map("validation_issues")
}

/// Mission §28/§31 — approbation d'un export précis. `manifestHash` fige la preuve que la version
/// approuvée est EXACTEMENT celle qui sera exportée en FINAL (mission §32 "toute modification
/// après approbation... invalide l'approbation"). Historique immuable : une invalidation ne
/// supprime jamais la ligne, elle bascule `status`.
model FinalApproval {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  exportJobId String    @map("export_job_id") @db.Uuid
  exportJob   ExportJob @relation(fields: [exportJobId, organizationId], references: [id, organizationId])

  validationRunId String        @map("validation_run_id") @db.Uuid
  validationRun   ValidationRun @relation(fields: [validationRunId, organizationId], references: [id, organizationId])

  manifestHash String @map("manifest_hash") @db.VarChar(64)

  approvedBy   String   @map("approved_by") @db.Uuid
  approverRole String   @map("approver_role") @db.VarChar(30)
  approvedAt   DateTime @default(now()) @map("approved_at")
  comment      String?

  previousStatus String? @map("previous_status") @db.VarChar(20)
  nextStatus     String? @map("next_status") @db.VarChar(20)

  /// ACTIVE | INVALIDATED — CHECK (migration).
  status            String    @default("ACTIVE") @db.VarChar(11)
  invalidatedAt     DateTime? @map("invalidated_at")
  invalidatedReason String?   @map("invalidated_reason")

  submissionPackages SubmissionPackage[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("final_approvals")
}

/// Mission §36/§40 — exigence de signature détectée (IA ou saisie humaine) puis confirmée par un
/// humain avant de devenir contraignante (mission "une détection automatique ne doit pas devenir
/// obligatoire sans confirmation humaine").
model SignatureRequirement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentRef   String  @map("document_ref") @db.VarChar(200)
  sourceDce     String? @map("source_dce") @db.VarChar(300)
  pageOrSection String? @map("page_or_section") @db.VarChar(100)
  mandatory     Boolean
  momentText    String? @map("moment_text")
  format        String? @db.VarChar(40)

  /// LEVEL0 | LEVEL1 | LEVEL2 | LEVEL3 | LEVEL4 — CHECK (migration), nullable = non déterminé
  /// (mission §41 "ne suppose pas que la signature simple suffit toujours").
  levelExpected          String? @map("level_expected") @db.VarChar(6)
  certificateRequirement String? @map("certificate_requirement")
  signatoryExpected      String? @map("signatory_expected") @db.VarChar(200)

  /// LOW | MEDIUM | HIGH — CHECK (migration).
  confidence String @default("MEDIUM") @db.VarChar(6)
  /// DETECTED | CONFIRMED | REJECTED | UNKNOWN — CHECK (migration).
  status     String @default("DETECTED") @db.VarChar(9)

  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at")
  comment     String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("signature_requirements")
}

/// Mission §37/§42 — un signataire et son pouvoir. `userId` est une référence molle uniquement
/// (mission §42 "OWNER ou ADMIN TenderOS ≠ pouvoir juridique automatique de signature") :
/// aucune FK, aucune permission dérivée de ce lien.
model Signatory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  userId String? @map("user_id") @db.Uuid

  firstName         String  @map("first_name") @db.VarChar(120)
  lastName          String  @map("last_name") @db.VarChar(120)
  professionalEmail String  @map("professional_email") @db.VarChar(320)
  jobTitle          String? @map("job_title") @db.VarChar(150)
  organizationName  String? @map("organization_name") @db.VarChar(200)

  authorityText       String? @map("authority_text")
  authorityDocumentId String? @map("authority_document_id") @db.Uuid

  validFrom  DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")

  /// PENDING | VERIFIED | REJECTED — CHECK (migration).
  status String @default("PENDING") @db.VarChar(9)

  verifiedBy String?   @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  participants SignatureParticipant[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("signatories")
}

/// Mission §33/§38/§43 — une transaction de signature locale, préparée puis (fake ou réelle)
/// exécutée chez le prestataire. Porte TOUJOURS sur un `ExportArtifact` FINAL figé (vérifié par
/// l'application avant création, mission §38/§39). `documentHash` gèle la preuve d'intégrité.
model SignatureTransaction {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  exportArtifactId String         @map("export_artifact_id") @db.Uuid
  exportArtifact   ExportArtifact @relation(fields: [exportArtifactId, organizationId], references: [id, organizationId])

  /// FAKE | UNIVERSIGN — CHECK (migration). Jamais un bascule silencieuse (mission §34/§37).
  provider              String  @db.VarChar(10)
  providerTransactionId String? @map("provider_transaction_id") @db.VarChar(120)

  /// PREPARING | READY_TO_SEND | SENT | IN_PROGRESS | SIGNED | VERIFIED | DECLINED | CANCELLED |
  /// EXPIRED | FAILED | INVALID — CHECK (migration). Mission §46 — mapping interne, jamais les
  /// statuts bruts du prestataire persistés ici (voir `SignatureProviderEvent.eventType`).
  status String @default("PREPARING") @db.VarChar(13)

  requestedLevel String? @map("requested_level") @db.VarChar(6)
  confirmedLevel String? @map("confirmed_level") @db.VarChar(6)
  levelSource    String? @map("level_source") @db.VarChar(40)

  documentHash String @map("document_hash") @db.VarChar(64)

  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorCode    String?   @map("error_code") @db.VarChar(60)
  errorMessage String?   @map("error_message")

  participants SignatureParticipant[]
  artifacts    SignatureArtifact[]

  @@unique([id, organizationId])
  @@unique([provider, providerTransactionId])
  @@index([organizationId, tenderId])
  @@map("signature_transactions")
}

/// Mission §37/§43 — un signataire affecté à une transaction précise, avec sa propre progression
/// (un participant peut signer indépendamment des autres, mission "jusqu'à 50 participants").
model SignatureParticipant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  signatureTransactionId String               @map("signature_transaction_id") @db.Uuid
  signatureTransaction   SignatureTransaction @relation(fields: [signatureTransactionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  signatoryId String    @map("signatory_id") @db.Uuid
  signatory   Signatory @relation(fields: [signatoryId, organizationId], references: [id, organizationId])

  providerParticipantId String? @map("provider_participant_id") @db.VarChar(120)
  sequence              Int     @default(1)

  /// PENDING | SENT | OPENED | SIGNED | DECLINED — CHECK (migration).
  status                String  @default("PENDING") @db.VarChar(8)
  invitationRedirectUrl String? @map("invitation_redirect_url") @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([signatureTransactionId, signatoryId])
  @@index([organizationId, signatureTransactionId])
  @@map("signature_participants")
}

/// Mission §41/§49/§50 — document signé récupéré (prestataire ou import manuel) ou preuve de
/// signature. `isFakeTestEvidence` marque explicitement tout artefact produit par le fake
/// provider (mission "FAKE_TEST_EVIDENCE... jamais confondue avec une preuve réelle").
model SignatureArtifact {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  signatureTransactionId String               @map("signature_transaction_id") @db.Uuid
  signatureTransaction   SignatureTransaction @relation(fields: [signatureTransactionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// SIGNED_DOCUMENT | PROOF — CHECK (migration).
  kind String @db.VarChar(15)

  fileName   String @map("file_name") @db.VarChar(255)
  mimeType   String @map("mime_type") @db.VarChar(120)
  fileSize   Int    @map("file_size")
  fileHash   String @map("file_hash") @db.VarChar(64)
  storageKey String @map("storage_key") @db.VarChar(500)

  providerArtifactId String? @map("provider_artifact_id") @db.VarChar(120)
  isFakeTestEvidence Boolean @default(false) @map("is_fake_test_evidence")

  /// PROVIDER | MANUAL_IMPORT — CHECK (migration).
  source     String  @default("PROVIDER") @db.VarChar(13)
  importedBy String? @map("imported_by") @db.Uuid

  /// IMPORTED | TO_VERIFY | VERIFIED | INVALID | REJECTED — CHECK (migration). Nullable : ne
  /// s'applique qu'à `kind = SIGNED_DOCUMENT` (mission §48/§51 "ne devient pas automatiquement
  /// VERIFIED").
  verificationStatus String?   @map("verification_status") @db.VarChar(10)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, signatureTransactionId])
  @@map("signature_artifacts")
}

/// Mission §39/§45 — trace de CHAQUE événement webhook reçu, avant même réconciliation (mission
/// "rejeter une transaction inconnue" — la ligne existe quand même, `organizationId` nullable, pour
/// l'observabilité et la détection d'abus). Contrainte d'unicité sur l'identifiant prestataire pour
/// l'idempotence (mission §45 "ajouter une contrainte unique... lorsque disponible").
model SignatureProviderEvent {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  provider              String  @db.VarChar(10)
  providerEventId       String? @map("provider_event_id") @db.VarChar(120)
  providerTransactionId String? @map("provider_transaction_id") @db.VarChar(120)

  eventType   String    @map("event_type") @db.VarChar(60)
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  /// RECEIVED | PROCESSED | REJECTED | IGNORED — CHECK (migration).
  status String @default("RECEIVED") @db.VarChar(9)

  payloadHash       String  @map("payload_hash") @db.VarChar(64)
  signatureVerified Boolean @map("signature_verified")

  errorCode  String? @map("error_code") @db.VarChar(60)
  retryCount Int     @default(0) @map("retry_count")

  @@unique([provider, providerEventId])
  @@index([organizationId, providerTransactionId])
  @@map("signature_provider_events")
}

/// Mission §10/§52/§53 — le package final. Immuable après création (mission "un package final est
/// immuable") : un nouveau contenu produit une nouvelle ligne (`version` incrémentée), jamais une
/// mise à jour en place.
model SubmissionPackage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int

  /// PENDING | GENERATING | COMPLETED | FAILED — CHECK (migration).
  status String @default("PENDING") @db.VarChar(10)

  validationRunId String        @map("validation_run_id") @db.Uuid
  validationRun   ValidationRun @relation(fields: [validationRunId, organizationId], references: [id, organizationId])

  approvalId String        @map("approval_id") @db.Uuid
  approval   FinalApproval @relation(fields: [approvalId, organizationId], references: [id, organizationId])

  readinessStatus String @map("readiness_status") @db.VarChar(20)

  fileName     String? @map("file_name") @db.VarChar(255)
  mimeType     String? @map("mime_type") @db.VarChar(60)
  fileSize     Int?    @map("file_size")
  fileHash     String? @map("file_hash") @db.VarChar(64)
  storageKey   String? @map("storage_key") @db.VarChar(500)
  manifestJson Json?   @map("manifest_json")

  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")
  errorCode    String?   @map("error_code") @db.VarChar(60)
  errorMessage String?   @map("error_message")

  files PackageFile[]

  @@unique([id, organizationId])
  @@unique([tenderId, version])
  @@index([organizationId, tenderId])
  @@map("submission_packages")
}

/// Mission §53/§54 — un fichier inclus dans le ZIP final, avec son propre hash (mission "tous les
/// fichiers possèdent un hash", "aucun nom de fichier ne doit entrer en collision").
model PackageFile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  submissionPackageId String            @map("submission_package_id") @db.Uuid
  submissionPackage   SubmissionPackage @relation(fields: [submissionPackageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Chemin sûr à l'intérieur du ZIP — généré côté serveur uniquement (mission §54 "convention de
  /// nommage sûre"), jamais dérivé directement d'une entrée utilisateur non assainie.
  archivePath String @map("archive_path") @db.VarChar(300)

  /// EXPORT_ARTIFACT | SIGNATURE_ARTIFACT | MANIFEST | ADMINISTRATIVE_DOCUMENT — CHECK (migration).
  sourceType String  @map("source_type") @db.VarChar(24)
  sourceId   String? @map("source_id") @db.Uuid

  fileName String @map("file_name") @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(120)
  fileSize Int    @map("file_size")
  fileHash String @map("file_hash") @db.VarChar(64)
  order    Int

  @@unique([submissionPackageId, archivePath])
  @@index([organizationId, submissionPackageId])
  @@map("package_files")
}

// ============================================================================
// Sprint 8A.1 — Espace Livrables, Mémoire technique IA et édition humaine.
//
// Portée retenue (mission "Créer uniquement les modèles nécessaires") : profondeur COMPLÈTE
// (structure, template, génération IA, édition humaine, révisions immuables, revue, sélection
// export) uniquement pour TECHNICAL_MEMO et EXECUTIVE_SUMMARY — les deux seuls livrables décrits
// par la mission comme des documents structurés éditables section par section. Les autres
// livrables : COMPLIANCE_MATRIX/CHECKLIST/ANNEXES reçoivent un overlay éditable LÉGER dédié
// (ComplianceMatrixEntry/ChecklistPieceEntry/DeliverableAnnex, sans révision/génération IA — la
// mission ne les décrit jamais avec ce vocabulaire) ; VALIDATION_REPORT/COST_REPORT/
// SIGNATURE_DOCUMENTS/SUBMISSION_PACKAGE restent des vues en LECTURE SEULE assemblées à la volée
// depuis Validation/Pricing/Signature/SubmissionPackage (mission §14 "construit depuis les
// données du Sprint 8A" / "Ne développe pas l'intégration Universign réelle" / "assurée par le
// Sprint 8A bis") — la ligne `Deliverable` existe pour ces quatre types uniquement pour le
// statut/la navigation, jamais un second stockage de contenu déjà possédé par un autre module.
// ============================================================================

/// Mission §5 — hiérarchie de templates TENDER > CLIENT > ORGANIZATION (un template "imposé par
/// l'acheteur" reste un template de portée TENDER, créé manuellement après lecture du DCE — jamais
/// une détection automatique inventée ; un template "système" dégénère en template ORGANIZATION,
/// chaque organisation doit posséder le sien, jamais un seed global inter-tenant). La priorité
/// RÉELLEMENT utilisée est conservée sur `Deliverable.templateSourceLevel` (mission "aucune fusion
/// silencieuse incohérente").
model DeliverableTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// TENDER | CLIENT | ORGANIZATION — CHECK (migration).
  scopeLevel String @map("scope_level") @db.VarChar(12)

  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String? @map("tender_id") @db.Uuid
  tender   Tender? @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// TECHNICAL_MEMO | EXECUTIVE_SUMMARY — CHECK.
  documentType String  @map("document_type") @db.VarChar(20)
  name         String  @db.VarChar(200)
  description  String?
  /// Note libre — ex. "imposé par l'acheteur, voir RC p.12" (mission §5), jamais évaluée
  /// automatiquement.
  note         String?

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  versions DeliverableTemplateVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, documentType, scopeLevel])
  @@index([organizationId, clientAccountId])
  @@index([organizationId, tenderId])
  @@map("deliverable_templates")
}

/// Mission §5 — une version de template, versionnée comme `ExportTemplateVersion` (Sprint 8A) :
/// DRAFT → ACTIVE → ARCHIVED, une seule ACTIVE à la fois par template (index unique partiel,
/// migration).
model DeliverableTemplateVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  deliverableTemplateId String              @map("deliverable_template_id") @db.Uuid
  deliverableTemplate   DeliverableTemplate @relation(fields: [deliverableTemplateId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int
  /// DRAFT | ACTIVE | ARCHIVED — CHECK.
  status  String @default("DRAFT") @db.VarChar(8)

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  activatedAt DateTime? @map("activated_at")
  archivedAt  DateTime? @map("archived_at")

  sections DeliverableTemplateSection[]

  @@unique([id, organizationId])
  @@unique([deliverableTemplateId, version])
  @@index([organizationId, deliverableTemplateId])
  @@map("deliverable_template_versions")
}

/// Mission §5 — une section de template : code, titre, ordre, niveau de titre, obligation,
/// condition d'affichage (texte libre, jamais un DSL évalué), longueur recommandée, instructions
/// rédactionnelles, `taskType` IA (le `PromptVersion` ACTIF du Sprint 6 pour ce `taskType` est
/// résolu ENTIÈREMENT côté Generation, jamais une référence de version figée ici).
model DeliverableTemplateSection {
  id                           String                     @id @default(uuid()) @db.Uuid
  organizationId               String                     @map("organization_id") @db.Uuid
  deliverableTemplateVersionId String                     @map("deliverable_template_version_id") @db.Uuid
  deliverableTemplateVersion   DeliverableTemplateVersion @relation(fields: [deliverableTemplateVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  code         String  @db.VarChar(80)
  title        String  @db.VarChar(300)
  description  String?
  order        Int
  /// 1 | 2 | 3 (H1/H2/H3) — CHECK.
  headingLevel Int     @default(1) @map("heading_level")

  /// MANDATORY | OPTIONAL | CONDITIONAL — CHECK.
  requirement      String  @default("OPTIONAL") @db.VarChar(12)
  displayCondition String? @map("display_condition")

  recommendedLength Int?    @map("recommended_length")
  maxCharacters     Int?    @map("max_characters")
  maxPages          Int?    @map("max_pages")
  instructions      String?
  styleHint         String? @map("style_hint")

  /// GenerationTaskType du Sprint 6 (dénormalisé, LECTURE SEULE — validité vérifiée par
  /// l'application au moment de la génération, jamais par une FK inter-module).
  taskType           String? @map("task_type") @db.VarChar(30)
  allowedVariables   Json    @default("[]") @map("allowed_variables")
  validationRequired Boolean @default(true) @map("validation_required")
  pageBreakBefore    Boolean @default(false) @map("page_break_before")

  @@unique([id, organizationId])
  @@unique([deliverableTemplateVersionId, code])
  @@index([organizationId, deliverableTemplateVersionId])
  @@map("deliverable_template_sections")
}

/// Mission §6 — identité documentaire versionnée, hiérarchie TENDER > CLIENT > ORGANIZATION (même
/// motif que `DeliverableTemplate`). Enregistrée sur chaque export (`Deliverable.themeVersionId`)
/// — une version déjà utilisée dans un export final est immuable (mission §6).
model DocumentTheme {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// TENDER | CLIENT | ORGANIZATION — CHECK.
  scopeLevel String @map("scope_level") @db.VarChar(12)

  clientAccountId String?        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount? @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String? @map("tender_id") @db.Uuid
  tender   Tender? @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  name String @db.VarChar(200)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  versions DocumentThemeVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, scopeLevel])
  @@index([organizationId, clientAccountId])
  @@index([organizationId, tenderId])
  @@map("document_themes")
}

/// Mission §6 — une version d'identité documentaire. `config` (JSON validé applicativement,
/// jamais un template exécutable, même discipline que `ExportTemplateConfig`) porte marges,
/// styles H1/H2/H3, en-tête/pied de page, pagination, coordonnées, mentions légales, convention de
/// nommage. `fontFamily` reste un NOM de police standard uniquement (jamais un chemin de fichier
/// arbitraire — même garde que `ALLOWED_LOCAL_FONT_NAMES` dans `PdfmakeDocumentRenderer`).
model DocumentThemeVersion {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  documentThemeId String        @map("document_theme_id") @db.Uuid
  documentTheme   DocumentTheme @relation(fields: [documentThemeId, organizationId], references: [id, organizationId], onDelete: Cascade)

  version Int
  /// DRAFT | ACTIVE | ARCHIVED — CHECK.
  status  String @default("DRAFT") @db.VarChar(8)

  logoStorageKey String? @map("logo_storage_key") @db.VarChar(500)
  accentColor    String? @map("accent_color") @db.VarChar(7)
  fontFamily     String? @map("font_family") @db.VarChar(100)
  config         Json    @default("{}")

  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  activatedAt DateTime? @map("activated_at")
  archivedAt  DateTime? @map("archived_at")

  @@unique([id, organizationId])
  @@unique([documentThemeId, version])
  @@index([organizationId, documentThemeId])
  @@map("document_theme_versions")
}

/// Mission §3/§15 — le livrable racine, un par (Tender, type). `status` est calculé et contrôlé
/// CÔTÉ BACKEND uniquement (mission §15 "jamais fixé librement par le frontend").
model Deliverable {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// TECHNICAL_MEMO | EXECUTIVE_SUMMARY | COMPLIANCE_MATRIX | CHECKLIST | VALIDATION_REPORT |
  /// COST_REPORT | ANNEXES | SIGNATURE_DOCUMENTS | SUBMISSION_PACKAGE — CHECK.
  type String @db.VarChar(20)

  /// NOT_STARTED | DRAFT | IN_PROGRESS | READY_FOR_REVIEW | CHANGES_REQUESTED | VALIDATED |
  /// APPROVED | EXPORTED | BLOCKED — CHECK.
  status String @default("NOT_STARTED") @db.VarChar(20)

  /// Uniquement pour TECHNICAL_MEMO/EXECUTIVE_SUMMARY — dénormalisé en LECTURE SEULE.
  templateVersionId   String? @map("template_version_id") @db.Uuid
  templateSourceLevel String? @map("template_source_level") @db.VarChar(12)

  themeVersionId   String?   @map("theme_version_id") @db.Uuid
  themeSourceLevel String?   @map("theme_source_level") @db.VarChar(12)
  themeSelectedBy  String?   @map("theme_selected_by") @db.Uuid
  themeSelectedAt  DateTime? @map("theme_selected_at")

  /// Mission §15 — fait explicite déclenché par `ApproveDeliverableUseCase` (jamais déduit
  /// automatiquement des seules sections) : uniquement lorsque toutes les sections visibles sont
  /// VALIDÉES. `status = EXPORTED` reste calculé dynamiquement à la lecture depuis les exports
  /// FINAUX déjà COMPLETED du Tender (Sprint 8A, jamais un second stockage figé ici).
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at")

  /// Correctif audit Codex P1-002 — uniquement pour COST_REPORT : référence EXPLICITE et IMMUABLE
  /// (une fois posée) vers une version Sprint 7 figée, dénormalisée en LECTURE SEULE (jamais de FK
  /// inter-module, même motif que `pricingEstimateId` sur `ExportSectionSelection`). Un recalcul
  /// Sprint 7 ultérieur ne modifie jamais ces colonnes.
  costReportPricingEstimateId            String?   @map("cost_report_pricing_estimate_id") @db.Uuid
  costReportPricingEstimateVersionNumber Int?      @map("cost_report_pricing_estimate_version_number")
  costReportSelectedBy                   String?   @map("cost_report_selected_by") @db.Uuid
  costReportSelectedAt                   DateTime? @map("cost_report_selected_at")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections                DeliverableSection[]
  comments                DeliverableComment[]
  complianceMatrixEntries ComplianceMatrixEntry[]
  checklistPieceEntries   ChecklistPieceEntry[]
  annexes                 DeliverableAnnex[]

  @@unique([id, organizationId])
  @@unique([tenderId, type])
  @@index([organizationId, tenderId])
  @@map("deliverables")
}

/// Mission §4/§16 — un emplacement de section dans un livrable structuré (copié depuis
/// `DeliverableTemplateSection.code` à la création — garde sa propre existence même si le
/// template change ensuite, mission "verrouillée").
model DeliverableSection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableId String      @map("deliverable_id") @db.Uuid
  deliverable   Deliverable @relation(fields: [deliverableId, organizationId], references: [id, organizationId], onDelete: Cascade)

  code         String  @db.VarChar(80)
  title        String  @db.VarChar(300)
  order        Int
  headingLevel Int     @default(1) @map("heading_level")
  mandatory    Boolean @default(false)

  hidden Boolean @default(false)
  locked Boolean @default(false)

  /// NOT_STARTED | DRAFT | IN_PROGRESS | READY_FOR_REVIEW | CHANGES_REQUESTED | VALIDATED —
  /// CHECK. Dérivé de la révision courante, persisté pour un listing rapide (mission §16).
  status String @default("NOT_STARTED") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions       DeliverableRevision[]
  exportSelection DeliverableExportSelection?
  comments        DeliverableComment[]

  @@unique([id, organizationId])
  @@unique([deliverableId, code])
  @@index([organizationId, deliverableId])
  @@map("deliverable_sections")
}

/// Mission §10 — une révision immuable DÈS QU'ELLE QUITTE `DRAFT` (mission "une ancienne révision
/// ne doit jamais être écrasée"). `sourceGenerationId` est une référence dénormalisée en LECTURE
/// SEULE vers un `Generation` du Sprint 6 (jamais une seconde écriture sur cette table, même motif
/// que `pricingEstimateId` dans Export). `editVersion` porte le verrou optimiste de la mission §18
/// — n'a de sens que tant que `status = DRAFT`.
model DeliverableRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableSectionId String             @map("deliverable_section_id") @db.Uuid
  deliverableSection   DeliverableSection @relation(fields: [deliverableSectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revisionNumber     Int     @map("revision_number")
  previousRevisionId String? @map("previous_revision_id") @db.Uuid

  /// AI_GENERATED | MANUAL | RESTORED — CHECK.
  sourceType                    String  @map("source_type") @db.VarChar(12)
  sourceGenerationId            String? @map("source_generation_id") @db.Uuid
  sourceGenerationVersionNumber Int?    @map("source_generation_version_number")

  /// Correctif audit Codex P2-001 — snapshot d'audit minimal, IMMUABLE, capturé UNIQUEMENT à la
  /// création d'une révision AI_GENERATED (jamais mis à jour ensuite), dénormalisé en LECTURE
  /// SEULE (jamais de FK inter-module, même motif que `pricingEstimateId`). `aiContextFingerprint`
  /// est un hash SHA-256 du contenu généré, jamais le contexte brut dupliqué.
  aiTaskType           String?   @map("ai_task_type") @db.VarChar(40)
  aiPromptVersionId    String?   @map("ai_prompt_version_id") @db.Uuid
  aiModelProvider      String?   @map("ai_model_provider") @db.VarChar(40)
  aiModelName          String?   @map("ai_model_name") @db.VarChar(80)
  aiRoutingDecisionId  String?   @map("ai_routing_decision_id") @db.Uuid
  aiContextFingerprint String?   @map("ai_context_fingerprint") @db.VarChar(64)
  aiGeneratedAt        DateTime? @map("ai_generated_at")

  /// RenderableBlock[]-like structuré (mission §9 "jamais du HTML arbitraire").
  contentStructured Json   @map("content_structured")
  contentText       String @map("content_text")
  characterCount    Int    @map("character_count")

  /// DRAFT | READY_FOR_REVIEW | CHANGES_REQUESTED | VALIDATED | REJECTED | ARCHIVED — CHECK.
  status String @default("DRAFT") @db.VarChar(18)

  editVersion Int @default(0) @map("edit_version")

  createdBy     String   @map("created_by") @db.Uuid
  createdByRole String   @map("created_by_role") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  changeNote    String?  @map("change_note")

  reviews          DeliverableReview[]
  comments         DeliverableComment[]
  exportSelections DeliverableExportSelection[]

  @@unique([id, organizationId])
  @@unique([deliverableSectionId, revisionNumber])
  @@index([organizationId, deliverableSectionId])
  @@map("deliverable_revisions")
}

/// Mission §13 — une décision de revue simple, toujours liée à une révision EXACTE (mission "une
/// décision porte toujours sur une révision exacte").
model DeliverableReview {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableRevisionId String              @map("deliverable_revision_id") @db.Uuid
  deliverableRevision   DeliverableRevision @relation(fields: [deliverableRevisionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// APPROVED | CHANGES_REQUESTED | REJECTED — CHECK.
  decision String  @db.VarChar(18)
  comment  String?

  decidedBy     String   @map("decided_by") @db.Uuid
  decidedByRole String   @map("decided_by_role") @db.VarChar(30)
  decidedAt     DateTime @default(now()) @map("decided_at")

  @@index([organizationId, deliverableRevisionId])
  @@map("deliverable_reviews")
}

/// Mission §13 — un commentaire simple, lié à un livrable et, optionnellement, une section ou une
/// révision précise (mission "sans collaboration temps réel", "le workflow collaboratif avancé
/// reste réservé au Sprint 11").
model DeliverableComment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableId String      @map("deliverable_id") @db.Uuid
  deliverable   Deliverable @relation(fields: [deliverableId, organizationId], references: [id, organizationId], onDelete: Cascade)

  deliverableSectionId String?             @map("deliverable_section_id") @db.Uuid
  deliverableSection   DeliverableSection? @relation(fields: [deliverableSectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  deliverableRevisionId String?              @map("deliverable_revision_id") @db.Uuid
  deliverableRevision   DeliverableRevision? @relation(fields: [deliverableRevisionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  content String

  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  /// OPEN | RESOLVED — CHECK.
  status     String    @default("OPEN") @db.VarChar(8)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at")

  @@index([organizationId, deliverableId])
  @@index([organizationId, deliverableSectionId])
  @@index([organizationId, deliverableRevisionId])
  @@map("deliverable_comments")
}

/// Mission §11 — pour chaque section, AU PLUS UNE révision sélectionnée pour l'export (règle
/// absolue : "Révision validée explicitement sélectionnée → utilisée dans l'export final",
/// "Dernier brouillon non validé → jamais utilisé automatiquement" — vérifié par l'application,
/// jamais par une contrainte DB sur `status`, une révision ARCHIVED restant sélectionnable par
/// exception documentée). Une ligne PAR section (mise à jour, jamais dupliquée) : l'historique
/// complet reste porté par `DeliverableRevision`, jamais reconstruit ici.
model DeliverableExportSelection {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableSectionId String             @map("deliverable_section_id") @db.Uuid
  deliverableSection   DeliverableSection @relation(fields: [deliverableSectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  deliverableRevisionId String              @map("deliverable_revision_id") @db.Uuid
  deliverableRevision   DeliverableRevision @relation(fields: [deliverableRevisionId, organizationId], references: [id, organizationId])

  selectedBy    String   @map("selected_by") @db.Uuid
  selectedAt    DateTime @default(now()) @map("selected_at")
  justification String?

  @@unique([deliverableSectionId, organizationId])
  @@map("deliverable_export_selections")
}

/// Mission §14 "Matrice de conformité" — overlay éditable léger (pas de révision/génération IA,
/// la mission ne les décrit jamais pour ce livrable). `requirementId` dénormalise en LECTURE SEULE
/// une exigence du Sprint 4 (Analysis).
model ComplianceMatrixEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableId String      @map("deliverable_id") @db.Uuid
  deliverable   Deliverable @relation(fields: [deliverableId, organizationId], references: [id, organizationId], onDelete: Cascade)

  requirementId String? @map("requirement_id") @db.Uuid
  source        String  @db.VarChar(300)
  mandatory     Boolean @default(true)
  /// LOW | MEDIUM | HIGH | CRITICAL — CHECK.
  criticality   String  @default("MEDIUM") @db.VarChar(8)

  response              String?
  deliverableSectionRef String? @map("deliverable_section_ref") @db.VarChar(80)
  proofReference        String? @map("proof_reference")

  /// COVERED | PARTIALLY_COVERED | NOT_COVERED | NOT_APPLICABLE | TO_CONFIRM — CHECK.
  coverageStatus String    @default("TO_CONFIRM") @map("coverage_status") @db.VarChar(18)
  validated      Boolean   @default(false)
  validatedBy    String?   @map("validated_by") @db.Uuid
  validatedAt    DateTime? @map("validated_at")

  order Int @default(0)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, deliverableId])
  @@map("compliance_matrix_entries")
}

/// Mission §14 "Checklist des pièces" — overlay éditable léger, même motif que
/// `ComplianceMatrixEntry`. `documentId` dénormalise en LECTURE SEULE un `Document` existant.
model ChecklistPieceEntry {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableId String      @map("deliverable_id") @db.Uuid
  deliverable   Deliverable @relation(fields: [deliverableId, organizationId], references: [id, organizationId], onDelete: Cascade)

  name      String  @db.VarChar(300)
  source    String? @db.VarChar(300)
  mandatory Boolean @default(true)
  format    String? @db.VarChar(60)

  documentId        String?   @map("document_id") @db.Uuid
  version           String?   @db.VarChar(40)
  /// Correctif audit Codex P1-003 — référence de version IMMUABLE dérivée d'un document VÉRIFIÉ via
  /// `GetDocumentUseCase` (jamais fournie par le client), dénormalisée en LECTURE SEULE (jamais de
  /// FK inter-module, même motif que `pricingEstimateId` sur `ExportSectionSelection`).
  documentVersionId String?   @map("document_version_id") @db.Uuid
  documentChecksum  String?   @map("document_checksum") @db.VarChar(128)
  documentFileName  String?   @map("document_file_name") @db.VarChar(300)
  documentMimeType  String?   @map("document_mime_type") @db.VarChar(120)
  expiresAt         DateTime? @map("expires_at")

  signatureRequired Boolean @default(false) @map("signature_required")

  /// MISSING | PROVIDED | EXPIRED | REJECTED | VALID — CHECK.
  status            String  @default("MISSING") @db.VarChar(10)
  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  order Int @default(0)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, deliverableId])
  @@map("checklist_piece_entries")
}

/// Mission §14 "Annexes" — overlay éditable léger. `documentId` dénormalise en LECTURE SEULE un
/// `Document` existant.
model DeliverableAnnex {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  deliverableId String      @map("deliverable_id") @db.Uuid
  deliverable   Deliverable @relation(fields: [deliverableId, organizationId], references: [id, organizationId], onDelete: Cascade)

  label             String  @db.VarChar(300)
  source            String? @db.VarChar(300)
  documentId        String? @map("document_id") @db.Uuid
  version           String? @db.VarChar(40)
  /// Correctif audit Codex P1-003 — même motif que `ChecklistPieceEntry`.
  documentVersionId String? @map("document_version_id") @db.Uuid
  documentChecksum  String? @map("document_checksum") @db.VarChar(128)
  documentFileName  String? @map("document_file_name") @db.VarChar(300)
  documentMimeType  String? @map("document_mime_type") @db.VarChar(120)

  /// PENDING | PROVIDED | VALIDATED — CHECK.
  status String @default("PENDING") @db.VarChar(10)
  order  Int    @default(0)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, deliverableId])
  @@map("deliverable_annexes")
}

/// Sprint 8C Phase 1 — mission §6 : un dossier administratif PRINCIPAL par Tender (création
/// idempotente). `status`/`completionPercentage` sont CALCULÉS côté backend (jamais posés
/// directement), `validationStatus` reste un fait humain séparé — ne code jamais la signature ni
/// la sélection package (modules distincts, phase ultérieure).
model AdministrativeDossier {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  clientAccountId String        @map("client_account_id") @db.Uuid
  clientAccount   ClientAccount @relation(fields: [clientAccountId, organizationId], references: [id, organizationId])

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// INCOMPLETE | TO_COMPLETE | IN_VERIFICATION | READY | BLOCKED — CHECK.
  status               String @default("INCOMPLETE") @db.VarChar(16)
  completionPercentage Int    @default(0) @map("completion_percentage")

  /// NOT_VALIDATED | VALIDATED | OUTDATED — CHECK.
  validationStatus String    @default("NOT_VALIDATED") @map("validation_status") @db.VarChar(14)
  lastValidatedBy  String?   @map("last_validated_by") @db.Uuid
  lastValidatedAt  DateTime? @map("last_validated_at")

  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents AdministrativeDocument[]

  @@unique([id, organizationId])
  @@unique([organizationId, tenderId])
  @@map("administrative_dossiers")
}

/// Sprint 8C Phase 1 — mission §8 : une exigence administrative pour un Tender précis, extraite du
/// DCE ou saisie manuellement. `validationStatus` démarre TOUJOURS à SUGGESTED pour une exigence
/// `DCE_ANALYSIS` (règle appliquée dans le domaine, `AdministrativeRequirement.create`) — jamais
/// validée automatiquement.
model AdministrativeRequirement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sourceDocumentId      String? @map("source_document_id") @db.Uuid
  sourceDocumentVersion Int?    @map("source_document_version")
  sourceLocation        String? @map("source_location")

  title                String  @db.VarChar(300)
  description          String?
  requirementType      String  @map("requirement_type") @db.VarChar(40)
  /// Catalogue canonique `AdministrativeDocumentType` (23 codes) — CHECK.
  expectedDocumentType String  @map("expected_document_type") @db.VarChar(40)

  required              Boolean   @default(true)
  applicable            Boolean   @default(true)
  dueDate               DateTime? @map("due_date")
  validityRule          String?   @map("validity_rule")
  signatureRequired     Boolean   @default(false) @map("signature_required")
  originalTextReference String?   @map("original_text_reference")
  confidence            Float?

  /// MANUAL | DCE_ANALYSIS | BUYER_TEMPLATE | TENDEROS_RULE — CHECK.
  origin String @db.VarChar(20)

  createdBy        String  @map("created_by") @db.Uuid
  validatedBy      String? @map("validated_by") @db.Uuid
  /// SUGGESTED | CONFIRMED | REJECTED | NOT_APPLICABLE — CHECK.
  validationStatus String  @default("SUGGESTED") @map("validation_status") @db.VarChar(14)

  /// Dénormalisé en LECTURE SEULE vers `AdministrativeDocument.id` — jamais de FK stricte (même
  /// motif que `requirementId` sur `ComplianceMatrixEntry`), la pièce pouvant être créée après
  /// l'exigence.
  matchedDocumentId String? @map("matched_document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("administrative_requirements")
}

/// Sprint 8C Phase 1 — mission §4/§21 : une pièce administrative du dossier. `validatedRevisionId`
/// est un pointeur EXPLICITE et GELÉ vers une révision EXACTE — jamais "la dernière" implicite.
model AdministrativeDocument {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  administrativeDossierId String                @map("administrative_dossier_id") @db.Uuid
  administrativeDossier   AdministrativeDossier @relation(fields: [administrativeDossierId, organizationId], references: [id, organizationId], onDelete: Cascade)

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Catalogue canonique `AdministrativeDocumentType` (23 codes) — CHECK.
  documentType  String  @map("document_type") @db.VarChar(40)
  label         String  @db.VarChar(300)
  /// Dénormalisé en LECTURE SEULE vers `AdministrativeRequirement.id` — jamais de FK stricte.
  requirementId String? @map("requirement_id") @db.Uuid

  validatedRevisionId String?   @map("validated_revision_id") @db.Uuid
  validatedAt         DateTime? @map("validated_at")
  validatedBy         String?   @map("validated_by") @db.Uuid

  /// Sprint 8C Phase 2 — mission §18, signature LOCALE jamais obligatoire globalement.
  /// NOT_REQUIRED | MANUAL | ELECTRONIC | EXTERNAL — CHECK.
  signatureMode   String @default("NOT_REQUIRED") @map("signature_mode") @db.VarChar(12)
  /// NOT_REQUIRED | PENDING | SIGNED | REJECTED | EXPIRED | CANCELLED — CHECK.
  signatureStatus String @default("NOT_REQUIRED") @map("signature_status") @db.VarChar(12)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  revisions AdministrativeDocumentRevision[]

  @@unique([id, organizationId])
  @@index([organizationId, administrativeDossierId])
  @@index([organizationId, tenderId])
  @@map("administrative_documents")
}

/// Sprint 8C Phase 1 — mission §21 : une ancienne révision n'est jamais écrasée. Une révision peut
/// exister vide (DRAFT, aucun fichier attaché) avant qu'un document vérifié y soit associé.
model AdministrativeDocumentRevision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  administrativeDocumentId String                 @map("administrative_document_id") @db.Uuid
  administrativeDocument   AdministrativeDocument @relation(fields: [administrativeDocumentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revisionNumber Int @map("revision_number")

  /// Correctif audit Codex P1-003 — dénormalisés en LECTURE SEULE depuis un document du module
  /// Documents déjà VÉRIFIÉ (jamais fournis directement par le client), même motif que
  /// `ChecklistPieceEntry`.
  documentId        String?   @map("document_id") @db.Uuid
  documentVersionId String?   @map("document_version_id") @db.Uuid
  documentChecksum  String?   @map("document_checksum") @db.VarChar(128)
  documentFileName  String?   @map("document_file_name") @db.VarChar(300)
  documentMimeType  String?   @map("document_mime_type") @db.VarChar(120)
  expiresAt         DateTime? @map("expires_at")

  /// DRAFT | IN_REVIEW | VALIDATED | REJECTED | REPLACED | ARCHIVED — CHECK.
  status String  @default("DRAFT") @db.VarChar(10)
  notes  String?

  /// Sprint 8C.1 — dénormalisés en LECTURE SEULE : quel gabarit officiel et quelles valeurs exactes
  /// ont produit cette révision, pour une reproductibilité totale même si les données sources
  /// changent ensuite (mission §9 "jamais régénérer une ancienne révision avec les données
  /// actuelles") — jamais posés pour une révision qui n'est pas un formulaire officiel généré.
  officialTemplateId String? @map("official_template_id") @db.Uuid
  formDataSnapshot   Json?   @map("form_data_snapshot")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, organizationId])
  @@unique([administrativeDocumentId, revisionNumber])
  @@index([organizationId, administrativeDocumentId])
  @@map("administrative_document_revisions")
}

/// Sprint 8C Phase 2 — mission §15 : un groupement par Tender (candidat individuel = pas de ligne
/// du tout). `members` en JSON — données de valeur bornées à la vie du groupement, aucun cycle de
/// vie propre (même motif que `PricingEstimateVersion.breakdown`).
model Consortium {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// JOINT | SOLIDARITY | OTHER — CHECK.
  type               String  @db.VarChar(12)
  legalForm          String? @map("legal_form") @db.VarChar(200)
  liabilityMode      String? @map("liability_mode") @db.VarChar(200)
  mandataireMemberId String? @map("mandataire_member_id") @db.VarChar(80)
  members            Json    @default("[]")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dc1Declarations Dc1Declaration[]

  @@unique([id, organizationId])
  @@unique([organizationId, tenderId])
  @@map("administrative_consortiums")
}

/// Sprint 8C Phase 2 — mission §10 : lettre de candidature, une par Tender.
model Dc1Declaration {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  tenderId String @map("tender_id") @db.Uuid
  tender   Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// INDIVIDUAL | CONSORTIUM — CHECK.
  candidateType String      @map("candidate_type") @db.VarChar(12)
  consortiumId  String?     @map("consortium_id") @db.Uuid
  consortium    Consortium? @relation(fields: [consortiumId, organizationId], references: [id, organizationId])

  declarations             String?
  signatoryName            String? @map("signatory_name") @db.VarChar(200)
  signatoryCapacity        String? @map("signatory_capacity") @db.VarChar(200)
