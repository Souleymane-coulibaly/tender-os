{
  "name": "@tenderos/api",
  "version": "0.1.0",
  "private": true,
  "description": "TenderOS API — NestJS foundation.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest run integration.spec.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:staging": "tsx prisma/seed-staging.ts",
    "db:init:staging": "pnpm run db:migrate:deploy && pnpm run db:seed && pnpm run db:seed:staging",
    "bootstrap:platform-owner": "tsx prisma/bootstrap-platform-owner.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "docx": "^9.7.1",
    "jose": "^4.15.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/yauzl": "^3.4.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
