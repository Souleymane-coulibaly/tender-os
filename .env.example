# Environnement d'exécution
NODE_ENV=development

# Base de données (PostgreSQL — voir docker-compose.yml)
DATABASE_URL=postgresql://tenderos:tenderos_local@localhost:5432/tenderos

# API (NestJS)
API_PORT=4000

# Authentification (module Identity/Authentication — signature des jetons d'accès)
# Générer une valeur aléatoire d'au moins 32 caractères pour chaque environnement réel.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Documents (module Documents — stockage, voir docs/04-architecture/DOCUMENTS_MODULE.md).
# StorageProvider est un port : DOCUMENT_STORAGE_DRIVER sélectionne EXPLICITEMENT l'implémentation
# (jamais déduit de la présence d'autres variables) — "local" (défaut) pour le développement,
# "r2" pour Cloudflare R2 en staging/production.
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_LOCAL_STORAGE_PATH=./.local-storage/documents
DOCUMENT_MAX_FILE_SIZE_MB=25

# Cloudflare R2 — lues UNIQUEMENT si DOCUMENT_STORAGE_DRIVER=r2 ci-dessus (sinon jamais requises,
# jamais lues). Bucket privé par défaut : aucune URL publique permanente n'existe (pas de variable
# R2_PUBLIC_BASE_URL, rien ne la consomme) — generateSignedUrl() produit une URL signée à 60
# secondes uniquement pour le téléchargement d'un document (DownloadDocumentVersionUseCase).
# R2_ACCOUNT_ID=replace-with-your-r2-account-id
# R2_ACCESS_KEY_ID=replace-with-a-real-key-never-committed
# R2_SECRET_ACCESS_KEY=replace-with-a-real-secret-never-committed
# R2_BUCKET_NAME=tenderos-documents
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# DCE (module DCE — import de fichiers/archives ZIP, voir modules/dce). Validées une seule fois
# au démarrage (dce-config.ts) : une valeur absente, non numérique, négative ou incohérente
# (ex. taille totale ZIP < taille par entrée, ratio de compression <= 1) empêche l'application de
# démarrer avec un message explicite nommant la variable en cause.
DCE_MAX_FILE_SIZE_MB=25
DCE_MAX_FILES_PER_IMPORT=20
DCE_ZIP_MAX_ENTRIES=200
DCE_ZIP_MAX_TOTAL_UNCOMPRESSED_MB=200
DCE_ZIP_MAX_SINGLE_ENTRY_UNCOMPRESSED_MB=50
DCE_ZIP_MAX_COMPRESSION_RATIO=100

# Extraction (module Extraction — pipeline d'extraction documentaire, voir modules/extraction).
# Validées une seule fois au démarrage (extraction-config.ts) : une valeur absente, non numérique,
# négative ou incohérente (ex. chevauchement >= taille de chunk) empêche l'application de démarrer
# avec un message explicite nommant la variable en cause. OCR_PROVIDER ne nomme qu'un moteur,
# jamais une clé : l'adaptateur Tesseract.js de cette tranche ne requiert aucun secret fournisseur.
OCR_PROVIDER=tesseract
OCR_TIMEOUT_MS=30000
OCR_MAX_RETRIES=2
OCR_RETRY_DELAY_MS=1000
OCR_MAX_FILE_SIZE_MB=25
OCR_SUPPORTED_MIME_TYPES=image/png,image/jpeg
EXTRACTION_MAX_PAGES=200
EXTRACTION_MAX_CHARACTERS=2000000
EXTRACTION_CHUNK_SIZE=2000
EXTRACTION_CHUNK_OVERLAP=200
EXTRACTION_MIN_TEXT_LENGTH=20
# Correction P1-03 (limites de ressources) — taille de fichier générique (tous formats), plafonds
# tableur, dimension d'image maximale contrôlée avant l'OCR.
EXTRACTION_MAX_FILE_SIZE_MB=50
EXTRACTION_MAX_SHEETS=50
EXTRACTION_MAX_ROWS_PER_SHEET=50000
EXTRACTION_MAX_IMAGE_DIMENSION_PX=10000

# Analysis (module Analysis — socle technique du moteur d'analyse IA, Sprint 4.1, voir
# modules/analysis). Contrairement à Extraction, AUCUNE de ces variables n'est obligatoire :
# l'application démarre normalement même en leur absence totale (analysis-config.ts). Sans
# AI_PROVIDER/OPENAI_API_KEY configurés, toute analyse démarrée se termine proprement en FAILED
# avec le code AI_PROVIDER_NOT_CONFIGURED — jamais un crash au démarrage ni au milieu d'une requête.
# AI_PROVIDER=OPENAI
# Checkpoint TENDEROS-2.1-LEGACY-DECOMMISSIONING : AI_MODEL, AI_MODEL_DOCUMENT_ANALYSIS,
# AI_MODEL_TENDER_CONSOLIDATION, CHAT_AI_MODEL, GENERATION_AI_MODEL et
# TECHNICAL_MEMO_AI_MODEL ne sont PLUS lues. Depuis le checkpoint P2.3-E4, le choix du
# modele appartient exclusivement a AiModelRouter (matrice de routage + preference
# utilisateur en base) : les definir n'a aucun effet.
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2
# AI_RETRY_DELAY_MS=1000
# OPENAI_API_KEY=replace-with-a-real-key-never-committed

# Billing & Stripe (module Billing — abonnements, Pass AO, Trial Starter, voir modules/billing).
# Absentes, elles ne font jamais échouer le DÉMARRAGE de l'API (même discipline que
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET ci-dessous) : seule une tentative réelle de checkout/
# webhook/rappel de Trial échoue explicitement à l'usage. APP_BASE_URL sert à construire les URLs
# de retour Stripe (success/cancel/Customer Portal) — sans elle, retombe sur
# http://localhost:3000.
# APP_BASE_URL=http://localhost:3000
# STRIPE_SECRET_KEY=replace-with-a-real-key-never-committed
# STRIPE_WEBHOOK_SECRET=replace-with-a-real-webhook-secret-never-committed
# STRIPE_PRICE_STARTER_MONTHLY=price_xxx
# STRIPE_PRICE_STARTER_YEARLY=price_xxx
# STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
# STRIPE_PRICE_BUSINESS_YEARLY=price_xxx
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx
# STRIPE_PRICE_PASS_ONE_TIME=price_xxx
# V2 Sprint 25 (Trial Starter) — worker de rappels d'essai (J-3/J-1/expiration). Activé par défaut ;
# ne mettre à "false" que pour le désactiver explicitement (ex. environnement de test).
# TRIAL_REMINDER_WORKER_ENABLED=true

# Email (module shared-kernel — Resend, voir shared-kernel/resend-email.provider.ts et
# shared-kernel/email-config.ts). Utilisé par les alertes de veille (market-watch), les rappels de
# Trial (billing), le mot de passe oublié (identity) et la demande de démo (marketing).
# Comportement selon NODE_ENV (P2 audit Codex, Resend/Demo Request — fail-fast hors local/test) :
#   - development / test (ou NODE_ENV non défini) : RESEND_API_KEY absente => bascule automatique
#     sur LoggingEmailProvider (journalise l'email au lieu de l'envoyer), jamais un échec de boot.
#   - toute autre valeur de NODE_ENV (staging/production) : RESEND_API_KEY ET RESEND_FROM_EMAIL
#     sont OBLIGATOIRES si le système email est actif — leur absence fait échouer le démarrage de
#     l'application (plus jamais de bascule silencieuse vers LoggingEmailProvider hors local/test).
# EMAIL_ALERT_WORKER_ENABLED est propre au worker d'alertes de veille (Sprint 17) — indépendant de
# l'envoi synchrone de l'email de demande de démo, qui n'en dépend jamais.
# RESEND_API_KEY=replace-with-a-real-key-never-committed
# RESEND_FROM_EMAIL=notifications@tenderos.example
# EMAIL_ALERT_WORKER_ENABLED=true

# Connecteurs Microsoft 365 / Google Workspace (module connectors, offre Enterprise).
# CONNECTOR_CREDENTIAL_ENCRYPTION_KEY chiffre les jetons OAuth en base (AES-256-GCM) : OBLIGATOIRE
# au démarrage, doit décoder (base64) en exactement 32 octets. La valeur ci-dessous (32 octets nuls)
# ne sert qu'au développement local — pour tout environnement réel, générer une vraie clé :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Les variables suivantes ne font jamais échouer le DÉMARRAGE : absentes, le bouton « Connecter »
# répond CONNECTOR_NOT_CONFIGURED (message explicite, 503) sans rien enregistrer.
# API_BASE_URL = URL publique de l'API (sans « / » final) : elle construit les URL de redirection
# OAuth, à déclarer telles quelles chez chaque provider :
#   {API_BASE_URL}/api/v1/connectors/oauth/microsoft-365/callback     (Microsoft Entra ID)
#   {API_BASE_URL}/api/v1/connectors/oauth/google-workspace/callback  (Google Cloud Console)
# API_BASE_URL=http://localhost:4000
# MICROSOFT_OAUTH_CLIENT_ID=replace-with-your-entra-application-client-id
# MICROSOFT_OAUTH_CLIENT_SECRET=replace-with-a-real-secret-never-committed
# GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=replace-with-a-real-secret-never-committed

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Landing Page publique (V2 Sprint 23 — module `marketing`, Crisp, Google Analytics 4). Sans
# NEXT_PUBLIC_CRISP_WEBSITE_ID / NEXT_PUBLIC_GA_MEASUREMENT_ID, la Landing fonctionne normalement
# (jamais de crash, mission §63) : simplement pas de widget Crisp / pas de script GA4 monté.
# DEMO_REQUEST_NOTIFY_EMAIL en revanche (P2 audit Codex, Resend/Demo Request) : en development/test
# (ou NODE_ENV non défini), son absence journalise un avertissement et utilise un repli local
# (contact@tenderos.fr) ; en staging/production, son absence fait échouer le démarrage de
# l'application — la destination d'un lead commercial est toujours une décision explicite.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CRISP_WEBSITE_ID=replace-with-your-crisp-website-id
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# DEMO_REQUEST_NOTIFY_EMAIL=sales@tenderos.example

# Bootstrap du premier PLATFORM_OWNER (module Platform Administration) — utilisés
# UNIQUEMENT par `pnpm --filter @tenderos/api bootstrap:platform-owner`, jamais lus par
# l'application au runtime. Ne jamais committer de vraies valeurs.
# PLATFORM_OWNER_EMAIL=owner@tenderos.example
# PLATFORM_OWNER_PASSWORD=replace-with-a-strong-password-min-12-chars
# PLATFORM_OWNER_DISPLAY_NAME=Platform Owner
