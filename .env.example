# Environnement d'exécution
NODE_ENV=development

# Base de données (PostgreSQL — voir docker-compose.yml)
DATABASE_URL=postgresql://tenderos:tenderos_local@localhost:5432/tenderos

# API (NestJS)
API_PORT=4000

# Authentification (module Identity/Authentication — signature des jetons d'accès)
# Générer une valeur aléatoire d'au moins 32 caractères pour chaque environnement réel.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Bootstrap du premier PLATFORM_OWNER (module Platform Administration) — utilisés
# UNIQUEMENT par `pnpm --filter @tenderos/api bootstrap:platform-owner`, jamais lus par
# l'application au runtime. Ne jamais committer de vraies valeurs.
# PLATFORM_OWNER_EMAIL=owner@tenderos.example
# PLATFORM_OWNER_PASSWORD=replace-with-a-strong-password-min-12-chars
# PLATFORM_OWNER_DISPLAY_NAME=Platform Owner
